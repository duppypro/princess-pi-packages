infra/deploy/oauth2-proxy-live-serve.cfg


# generated .mjs bins are TRACKED (committed) — required for npm install -g from GitHub
# (pacote respects .gitignore; gitignored bins would be missing from the tarball).
# NEVER EDIT THESE BY HAND — edit the .ts source, then bun run build.
# bin/patch-pi-widgets.mjs is handwritten source, not generated.
