#!/usr/bin/env bash
# pr-cleanup <branch> — delete a merged branch, its remote, and its worktree.
#
# <branch> is REQUIRED. Run from the main clone (#262): a session that
# entered the target worktree via EnterWorktree cannot complete cleanup from
# inside it (the worktree is locked) or from a plain `cd` back to main
# (nothing to discover from cwd). The supported sequence is
# `ExitWorktree { action: "remove" }`, then `pr-cleanup <branch>` from the
# main clone. This also handles "branch exists, worktree already removed"
# (#262 fix 3) — it deletes the local + remote branch even when there is no
# worktree left to tear down.
#
# --- no-argument mode removed (#221 finding 2) ------------------------------
# A bare `pr-cleanup` used to fall back to discovering the branch from cwd via
# `git branch --show-current`. Traced and tested empirically: that path is
# UNREACHABLE for a successful cleanup. Whatever branch cwd has checked out
# is, by construction, checked out in the SAME worktree cwd is standing in —
# so the branch it would discover is always the very branch the containment
# gate below refuses to remove cwd out from under (exit 3). If cwd shows
# main/master instead, the "nothing to discover" refusal fires (also exit 3).
# If cwd is the main clone with some OTHER branch checked out there directly
# (so no worktree anywhere has main/master checked out), the main-clone
# lookup below fails first (exit 4). No sequence of events reached exit 0 in
# testing. Removed rather than left documented as a dead path — the house
# preference is removing what cannot work over documenting it. The
# containment gate itself stays: it still matters when `<branch>` is given
# explicitly while cwd happens to be standing inside that branch's worktree.
#
# Governing rule (#210): every gate fails CLOSED. A check that cannot PROVE its
# precondition aborts — it never assumes the safe-to-delete case. Each of the
# three Critical findings on #204 was the same mistake in a different costume:
# a command failing, and the failure being read as "nothing to worry about."
#
# Exit codes (shared pr-* contract, #224 — full table in
# docs/dev-workflow-spec.md):
#   0  success
#   2  usage error — missing or extra arguments (<branch> is required), a
#      protected branch named explicitly, or not run inside a git repository
#      at all
#   3  precondition not met — cwd is inside the worktree this run would
#      remove (#221)
#   4  not found — no main/master worktree registered, or no local branch
#      '$BRANCH' in the main clone (typo'd name, or deleted by hand — #264)
#   5  remote/API failure — state could NOT be determined (network down, gh
#      outage, an incomplete API response, or a merge-base check that could
#      not even run)
#   6  safety gate refused — state WAS determined, and it says no (unmerged
#      work, a branch behind or diverged from the merged PR head (#317),
#      remote moved since the merge, a dirty or EnterWorktree-locked
#      worktree refusing removal, a rejected push, a ref that will not delete)
# The load-bearing distinction is 5 vs 6: "I could not check" vs "I checked
# and it says no." Collapsing both into a bare `exit 1` is the same fail-open
# shape #210 removed from the gates themselves — it had just moved to the
# boundary where callers (agents especially) read the outcome.
set -euo pipefail

# -h/--help prints usage and exits 0 (#310) — a flag is never a branch name or a
# message, and "pr-cleanup --help" used to be treated as one.
case "${1:-}" in
  -h|--help)
    cat <<'EOF'
usage: pr-cleanup <branch>
       pr-cleanup --version

After the PR is MERGED: remove the branch's worktree, delete the remote and
local branch. Run from the main clone. Refuses if the branch tip is not what
the PR merged — behind (names `git pull --ff-only`), ahead (unmerged work),
or diverged — or if the PR was rejected/never opened.

exit codes: 0 ok · 2 usage · 3 precondition · 4 not found · 5 remote · 6 refused
EOF
    exit 0 ;;
  # #178: resolved absolute path of the running copy — install-workflow-tools
  # deploys this script to ~/bin, so a bare `pr-cleanup` from a feature
  # worktree runs whatever was last installed there. `readlink -f` resolves a
  # real file OR a symlink to its actual on-disk location. Not built, so no
  # commit-hash/semver stamp — PATH only.
  --version) readlink -f "$0"; exit 0 ;;
  # #362: an unknown flag used to fall through this case and RUN the script.
  # On pr-reject that closed a real PR (#364, open for two seconds) because the
  # flag was taken as the close reason. A flag is never a branch name, a message,
  # or a reason — refuse it here, exit 2 per the #224 shared table.
  -*) echo "pr-cleanup: unknown flag: $1 (try --help)" >&2; exit 2 ;;
esac

# --- argument parsing --------------------------------------------------------
# <branch> is required — see the "no-argument mode removed (#221 finding 2)"
# header note above for why the old cwd-discovery fallback is gone.
if [ $# -ne 1 ]; then
  echo "usage: pr-cleanup <branch>" >&2
  echo "   <branch> is required. Run from the main clone: pr-cleanup <branch>" >&2
  exit 2
fi
BRANCH="$1"

if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  echo "pr-cleanup: refusing to target the protected branch '$BRANCH'." >&2
  exit 2
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "pr-cleanup: not inside a git repository — run from the main clone: pr-cleanup <branch>" >&2
  exit 2
fi

echo "🧹 pr-cleanup for branch '$BRANCH'"

# --- 0. locate the main clone AND this branch's worktree (if it still has one)
# `git worktree list | grep "\[main\]" | awk '{print $1}'` truncated any path
# containing a space, and parsed human-readable output for machine state — the
# Agent-First Output standard forbids exactly that. --porcelain is the contract.
#
# `-z` is not optional for machine parsing: without it git emits paths verbatim,
# so a newline in a directory name splits one record across lines. With `-z`
# every attribute line is NUL-terminated, which no path byte can be.
#
# PRIMARY_REF is captured alongside the path rather than assumed. Accepting
# `master` here while hard-coding `origin/main` downstream would abort every
# legitimate cleanup in a master-primary repo, with a message blaming the merge
# commit — a wrong answer wearing a confident error.
#
# The same pass also records TARGET_WT: the worktree (if any) currently
# checked out onto $BRANCH, and whether git reports it `locked`. Empty
# TARGET_WT means the worktree is already gone (#262 fix 3) — step 3 below
# skips straight to branch deletion instead of dead-ending. A locked TARGET_WT
# is how step 3 tells "EnterWorktree still has this open" apart from "this is
# genuinely dirty" (#262 fix 1) — those are different problems with different
# fixes, and misdiagnosing one as the other sends an agent hunting for phantom
# uncommitted files.
MAIN_CLONE=""
PRIMARY_REF=""
TARGET_WT=""
TARGET_LOCKED=0

wt_path=""
wt_branch=""
wt_locked=0

record_worktree() {
  if [ -n "$wt_path" ]; then
    if [ -z "$MAIN_CLONE" ] && { [ "$wt_branch" = "refs/heads/main" ] || [ "$wt_branch" = "refs/heads/master" ]; }; then
      MAIN_CLONE="$wt_path"
      PRIMARY_REF="${wt_branch#refs/heads/}"
    fi
    if [ "$wt_branch" = "refs/heads/$BRANCH" ]; then
      TARGET_WT="$wt_path"
      TARGET_LOCKED=$wt_locked
    fi
  fi
}

while IFS= read -r -d '' line; do
  case "$line" in
    "worktree "*)
      record_worktree
      wt_path="${line#worktree }"
      wt_branch=""
      wt_locked=0
      ;;
    "branch "*) wt_branch="${line#branch }" ;;
    "locked"|"locked "*) wt_locked=1 ;;
  esac
done < <(git worktree list --porcelain -z)
record_worktree

if [ -z "$MAIN_CLONE" ]; then
  echo "   ❌ ERROR: no main/master worktree found. Switch to the main clone and run from there." >&2
  exit 4
fi

# --- containment gate (#221) -------------------------------------------------
# Removing the worktree a session is standing in strands that session's own
# transcript (entering a worktree MOVES the transcript there; only
# ExitWorktree moves it back — nothing hooks `git worktree remove`). This
# check is purely local (no network, no `gh`), so it runs before ANY gate that
# costs an API call — a refusal here should never cost a `git fetch` or a
# `gh pr list`. Containment, not equality: a nested subdirectory of the
# worktree counts too, so `pwd -P` is compared as a path prefix, not a string
# equal to the worktree root.
if [ -n "$TARGET_WT" ]; then
  PWD_REAL=$(pwd -P)
  TARGET_WT_REAL=$( (cd "$TARGET_WT" 2>/dev/null && pwd -P) || printf '%s' "$TARGET_WT" )
  contained=0
  if [ "$PWD_REAL" = "$TARGET_WT_REAL" ]; then
    contained=1
  else
    case "$PWD_REAL" in
      "$TARGET_WT_REAL"/*) contained=1 ;;
    esac
  fi
  if [ "$contained" -eq 1 ]; then
    echo "   ❌ pr-cleanup: cwd is inside the worktree this run would remove:" >&2
    echo "      $TARGET_WT" >&2
    echo "   Removing it out from under yourself strands your own session's transcript." >&2
    echo "   Recovery:" >&2
    echo "     1. ExitWorktree { action: \"keep\" }   (or { action: \"remove\" } if supported)" >&2
    echo "     2. cd into the main clone: $MAIN_CLONE" >&2
    echo "     3. Re-run: pr-cleanup $BRANCH" >&2
    exit 3
  fi
fi

# --- 1. freshen refs before judging anything -------------------------------
# origin/main is a local cache; deciding "merged" against a stale one is a guess.
echo "🔍 Verifying PR for '$BRANCH' was merged..."
if ! git -C "$MAIN_CLONE" fetch --quiet origin 2>/dev/null; then
  echo "   ❌ ERROR: 'git fetch origin' failed — cannot verify merge state." >&2
  exit 5
fi

# --- 2. safety gate: prove THIS branch tip was merged -----------------------
if ! OWNER=$(gh repo view --json owner --jq '.owner.login' 2>/dev/null); then
  echo "   ❌ ERROR: 'gh repo view' failed — cannot determine repository owner." >&2
  exit 5
fi
# `2>/dev/null || true` here would be the same fail-open hole as the ls-remote
# one below: a gh outage yields an empty PR_INFO, which falls through to the
# "no merged PR" branch and can reach deletion having verified nothing.
# Own these two names before anything reads them (macroscopeapp on PR #331).
# Step 4 picks WHICH --force-with-lease shape to use by testing
# `${PR_HEAD_OID:-}` then `${REMOTE_TIP:-}`, but neither is assigned on every
# path to that point: PR_HEAD_OID is set only inside the merged-PR branch
# below, and REMOTE_TIP only when origin actually has the branch. On the other
# paths a value inherited from the caller's environment would decide the lease
# — pinning the delete to an OID this run never verified, or taking the
# pinned-tip arm where the must-not-exist arm was correct. Initializing here
# means the lease shape is chosen from what THIS run proved, and nothing else
# (#210: a check that cannot prove its precondition must refuse).
PR_HEAD_OID=""
REMOTE_TIP=""

if ! PR_INFO=$(gh pr list --head "$BRANCH" --state merged \
  --json number,mergeCommit,headRefOid,headRepositoryOwner \
  --jq "[.[] | select(.headRepositoryOwner.login == \"$OWNER\")] | .[0]"); then
  echo "   ❌ ERROR: 'gh pr list' failed — cannot verify the PR for '$BRANCH'." >&2
  exit 5
fi

if [ -n "$PR_INFO" ] && [ "$PR_INFO" != "null" ]; then
  PR_NUM=$(echo "$PR_INFO" | jq -r '.number')
  PR_MERGE_SHA=$(echo "$PR_INFO" | jq -r '.mergeCommit.oid // empty')
  PR_HEAD_OID=$(echo "$PR_INFO" | jq -r '.headRefOid // empty')
  # `-C "$MAIN_CLONE"` alone is sufficient — worktrees share refs/heads, so a
  # cwd-first attempt buys nothing. Not wrapped in an `if`/`||` fallback: the
  # fallback's own stderr used to leak and its failure went uncaught under
  # `set -e`, so a missing local branch (typo'd name, or deleted by hand after
  # the worktree was already torn down) crashed with git's raw text at exit
  # 128 — a code outside this script's table (#264/adversarial review of #221).
  if ! LOCAL_TIP=$(git -C "$MAIN_CLONE" rev-parse --verify -q "refs/heads/$BRANCH"); then
    echo "   ❌ ERROR: no local branch '$BRANCH' in $MAIN_CLONE." >&2
    exit 4
  fi

  # See the E-2 note below on the second `--is-ancestor` call: 128 means "could
  # not check" (bad/absent object) and must not be read the same as 1, "checked,
  # and it's not an ancestor". An empty $PR_MERGE_SHA never reaches merge-base at
  # all — that is its own "could not check" and stays folded into the same exit.
  if [ -z "$PR_MERGE_SHA" ]; then
    echo "   ❌ ERROR: PR #$PR_NUM is marked merged but reports no merge commit." >&2
    exit 5
  fi
  mb_status=0
  git -C "$MAIN_CLONE" merge-base --is-ancestor "$PR_MERGE_SHA" origin/"$PRIMARY_REF" 2>/dev/null || mb_status=$?
  if [ "$mb_status" -eq 128 ]; then
    echo "   ❌ ERROR: could not check whether PR #$PR_NUM's merge commit is in origin/$PRIMARY_REF (merge-base failed)." >&2
    exit 5
  fi
  if [ "$mb_status" -ne 0 ]; then
    echo "   ❌ ERROR: PR #$PR_NUM is marked merged but its merge commit is not in origin/$PRIMARY_REF." >&2
    exit 6
  fi

  # The gate above proves a PR with this branch NAME was merged. It says nothing
  # about the commits in hand. Comparing the tip to the PR's headRefOid is what
  # ties the two together, and catches both a reused branch name and commits
  # pushed after the merge (#210).
  #
  # NOT `git merge-base --is-ancestor "$BRANCH" "$PR_MERGE_SHA"` — the suggested
  # remedy on #204. We squash-merge, so the branch tip is never an ancestor of
  # the squash commit and that check would refuse every legitimate cleanup.
  if [ -z "$PR_HEAD_OID" ]; then
    echo "   ❌ ERROR: PR #$PR_NUM reports no headRefOid — cannot tie it to this branch." >&2
    exit 5
  fi
  if [ "$LOCAL_TIP" != "$PR_HEAD_OID" ]; then
    # LOCAL_TIP != PR_HEAD_OID collapses three different relationships (#317):
    # behind (GitHub's "Update branch" moved PR_HEAD_OID forward with no local
    # involvement — routine, not unmerged work), ahead (genuine unmerged
    # commits — the original diagnosis), and diverged (neither is an
    # ancestor of the other). `--is-ancestor` answers "is LOCAL_TIP behind
    # PR_HEAD_OID" first, using the same 128-vs-1 care as the merge-base gate
    # above: exit 128 means "could not check" and must stay exit 5, not be
    # read as "no" (which would misreport behind as ahead/diverged).
    behind_status=0
    git -C "$MAIN_CLONE" merge-base --is-ancestor "$LOCAL_TIP" "$PR_HEAD_OID" 2>/dev/null || behind_status=$?
    if [ "$behind_status" -eq 128 ]; then
      echo "   ❌ ERROR: could not compare local tip to PR #$PR_NUM's headRefOid (merge-base failed)." >&2
      exit 5
    fi
    if [ "$behind_status" -eq 0 ]; then
      echo "   ❌ ERROR: local branch is behind PR #$PR_NUM's merged head — not unmerged work." >&2
      echo "      local tip:      $LOCAL_TIP" >&2
      echo "      PR headRefOid:  $PR_HEAD_OID" >&2
      # This runs while cwd is $MAIN_CLONE (pr-cleanup's documented entry
      # point), which has $PRIMARY_REF checked out — never $BRANCH. A bare
      # 'git pull --ff-only' here fast-forwards $PRIMARY_REF, leaves
      # refs/heads/$BRANCH untouched, and the next pr-cleanup run hits this
      # same refusal (flagged by macroscopeapp on PR #322). $BRANCH is
      # checked out in its own worktree (TARGET_WT, recorded in step 0) in
      # the normal case, so the fix has to run THERE — pointing
      # 'git update-ref' at $BRANCH directly while it's checked out
      # elsewhere would desync that worktree's index/working tree from the
      # ref, which looks like a spontaneous mass deletion. Only when no
      # worktree holds $BRANCH (TARGET_WT empty) is moving the ref directly
      # in $MAIN_CLONE safe, since nothing has it checked out.
      if [ -n "$TARGET_WT" ]; then
        echo "   Run 'git pull --ff-only' in the worktree, then re-run pr-cleanup:" >&2
        echo "     cd $TARGET_WT && git pull --ff-only" >&2
      else
        echo "   '$BRANCH' has no worktree — its ref lives only in $MAIN_CLONE." >&2
        echo "   Run this, then re-run pr-cleanup:" >&2
        echo "     git -C $MAIN_CLONE update-ref refs/heads/$BRANCH $PR_HEAD_OID" >&2
      fi
      exit 6
    fi
    # Not behind. Check the other direction: LOCAL_TIP a descendant of
    # PR_HEAD_OID is genuine unmerged work (the original diagnosis). Neither
    # being an ancestor of the other is a true divergence — same 128-vs-1 care.
    ahead_status=0
    git -C "$MAIN_CLONE" merge-base --is-ancestor "$PR_HEAD_OID" "$LOCAL_TIP" 2>/dev/null || ahead_status=$?
    if [ "$ahead_status" -eq 128 ]; then
      echo "   ❌ ERROR: could not compare PR #$PR_NUM's headRefOid to the local tip (merge-base failed)." >&2
      exit 5
    fi
    if [ "$ahead_status" -eq 0 ]; then
      echo "   ❌ ERROR: branch tip does not match what PR #$PR_NUM merged — unmerged work present." >&2
      echo "      local tip:      $LOCAL_TIP" >&2
      echo "      PR headRefOid:  $PR_HEAD_OID" >&2
      echo "   Refusing to delete. Open a new PR for the extra commits, or reset the branch." >&2
      exit 6
    fi
    echo "   ❌ ERROR: local branch and PR #$PR_NUM's headRefOid have diverged." >&2
    echo "      local tip:      $LOCAL_TIP" >&2
    echo "      PR headRefOid:  $PR_HEAD_OID" >&2
    echo "   Refusing to delete. Reconcile the branches (e.g. rebase or merge) before cleaning up." >&2
    exit 6
  fi
  # The local tip matching is not enough. Another clone can push to
  # origin/$BRANCH after the PR merged; our tip is untouched, so the check above
  # still passes, and step 4 would delete a remote ref carrying commits that
  # exist nowhere else. Check what is actually ON the remote, here in the gate —
  # before anything is destroyed, rather than at the delete itself.
  # No `|| true` — that would swallow an ls-remote failure into an empty
  # REMOTE_TIP, which reads as "no remote branch" and sails through the check
  # below. Exactly the fail-open shape this script exists to remove, reintroduced
  # by the commit that added this gate. Status separately from output, as
  # everywhere else. (`set -o pipefail` makes the awk pipeline report ls-remote's
  # failure rather than awk's success.)
  if ! REMOTE_TIP=$(git -C "$MAIN_CLONE" ls-remote --heads origin "$BRANCH" 2>/dev/null | awk 'NR==1 {print $1}'); then
    echo "   ❌ ERROR: 'git ls-remote' failed — cannot verify the remote tip for '$BRANCH'." >&2
    echo "   Refusing to delete on an unverified remote state." >&2
    exit 5
  fi
  if [ -n "$REMOTE_TIP" ] && [ "$REMOTE_TIP" != "$PR_HEAD_OID" ]; then
    echo "   ❌ ERROR: origin/$BRANCH has moved since PR #$PR_NUM merged." >&2
    echo "      remote tip:     $REMOTE_TIP" >&2
    echo "      PR headRefOid:  $PR_HEAD_OID" >&2
    echo "   Someone pushed after the merge. Those commits are not in any PR —" >&2
    echo "   refusing to delete the remote branch. Fetch and review them first." >&2
    exit 6
  fi
  echo "   ✅ PR #$PR_NUM merged into origin/$PRIMARY_REF, and its head matches this branch tip."
else
  # No merged PR. The branch being absent from origin is the ONLY reading that
  # allows cleanup — and a failed ls-remote is not that reading. Testing exit
  # status separately from output is the whole point: `… 2>/dev/null | grep -q`
  # made an auth or network failure indistinguishable from "branch not found",
  # and deleted local work on the strength of it (#210).
  if LS_REMOTE_OUT=$(git -C "$MAIN_CLONE" ls-remote --heads origin "$BRANCH" 2>/dev/null); then
    if [ -n "$LS_REMOTE_OUT" ]; then
      # #266: `wt-new` pushes a brand-new branch with upstream at creation
      # time, so an abandoned branch that never got a PR is ALWAYS "present on
      # origin" — before this, that made this arm refuse UNCONDITIONALLY, with
      # no ancestry check at all, a permanent dead-end requiring a hand-run
      # `git push origin --delete`. The absent-from-origin arm below already
      # has the right proof for "no PR, but nothing unique to lose": the tip
      # is already an ancestor of origin/$PRIMARY_REF. Mirror it here.
      #
      # Both the LOCAL tip and the REMOTE tip must be proven contained in
      # origin/$PRIMARY_REF — checking only one is not enough. Step 4 below
      # deletes BOTH refs, and they can diverge: the remote could hold a push
      # this clone never fetched (the #266-remoteAdvanced-shaped risk), or the
      # local branch could hold commits that were never pushed. Either one
      # failing the check means real work is on the table — refuse.
      REMOTE_TIP=$(printf '%s' "$LS_REMOTE_OUT" | awk 'NR==1 {print $1}')

      # `-C "$MAIN_CLONE"` alone is sufficient — worktrees share refs/heads, so
      # a cwd-first attempt buys nothing. Not wrapped in an `if`/`||` fallback:
      # its own stderr used to leak and its failure went uncaught under
      # `set -e`, so a missing local branch crashed with git's raw text at
      # exit 128 — a code outside this script's table (#264/adversarial
      # review of #221).
      if ! LOCAL_TIP=$(git -C "$MAIN_CLONE" rev-parse --verify -q "refs/heads/$BRANCH"); then
        echo "   ❌ ERROR: no local branch '$BRANCH' in $MAIN_CLONE." >&2
        exit 4
      fi

      # `merge-base --is-ancestor` exits 1 for "not an ancestor" (a real,
      # checked "no") but 128 for a bad/absent object (could not even run the
      # check). 128 maps to exit 5 ("could not check"); 1 stays exit 6
      # ("checked, and it says no") — same care as every other ancestry check
      # in this script.
      mb_status=0
      git -C "$MAIN_CLONE" merge-base --is-ancestor "$LOCAL_TIP" origin/"$PRIMARY_REF" 2>/dev/null || mb_status=$?
      if [ "$mb_status" -eq 128 ]; then
        echo "   ❌ ERROR: could not check whether '$BRANCH' (local tip) is contained in origin/$PRIMARY_REF (merge-base failed)." >&2
        exit 5
      fi
      if [ "$mb_status" -ne 0 ]; then
        echo "   ❌ ERROR: '$BRANCH' exists on origin but no merged PR was found." >&2
        echo "   Its local commits are not in origin/$PRIMARY_REF — refusing to delete." >&2
        exit 6
      fi

      remote_mb_status=0
      git -C "$MAIN_CLONE" merge-base --is-ancestor "$REMOTE_TIP" origin/"$PRIMARY_REF" 2>/dev/null || remote_mb_status=$?
      if [ "$remote_mb_status" -eq 128 ]; then
        echo "   ❌ ERROR: could not check whether origin/$BRANCH is contained in origin/$PRIMARY_REF (merge-base failed)." >&2
        exit 5
      fi
      if [ "$remote_mb_status" -ne 0 ]; then
        echo "   ❌ ERROR: '$BRANCH' exists on origin but no merged PR was found." >&2
        echo "   origin/$BRANCH carries commits not in origin/$PRIMARY_REF — refusing to delete." >&2
        exit 6
      fi

      echo "   ℹ️  '$BRANCH' has no merged PR, but its local tip and origin/$BRANCH are both already in origin/$PRIMARY_REF — safe to delete."
    else
    # Absence from origin is NOT authorization. A branch that was never pushed,
    # or whose remote ref was deleted without merging, has no PR and no remote
    # ref — and its commits exist nowhere else. With no PR to appeal to, the
    # only proof left is that the tip carries nothing unique: it must already be
    # contained in origin/main.
    #
    # (Ancestry is the right test *here* precisely because there is no squash
    # commit in play. Where a PR was squash-merged, the branch above handles it
    # via headRefOid — ancestry would wrongly refuse that case.)
    # `-C "$MAIN_CLONE"` alone is sufficient — worktrees share refs/heads, so a
    # cwd-first attempt buys nothing. Not wrapped in an `if`/`||` fallback: its
    # own stderr used to leak and its failure went uncaught under `set -e`, so
    # a missing local branch crashed with git's raw text at exit 128 — a code
    # outside this script's table (#264/adversarial review of #221).
    if ! LOCAL_TIP=$(git -C "$MAIN_CLONE" rev-parse --verify -q "refs/heads/$BRANCH"); then
      echo "   ❌ ERROR: no local branch '$BRANCH' in $MAIN_CLONE." >&2
      exit 4
    fi
    # `merge-base --is-ancestor` exits 1 for "not an ancestor" (a real, checked
    # "no") but 128 for a bad/absent object (could not even run the check).
    # Collapsing both into exit 6 asserted the negative on a check that never
    # happened. Capture the status explicitly rather than trusting `!` alone —
    # 128 maps to 5 ("could not check"), 1 stays 6 ("checked, and it says no").
    mb_status=0
    git -C "$MAIN_CLONE" merge-base --is-ancestor "$LOCAL_TIP" origin/"$PRIMARY_REF" 2>/dev/null || mb_status=$?
    if [ "$mb_status" -eq 128 ]; then
      echo "   ❌ ERROR: could not check whether '$BRANCH' is contained in origin/$PRIMARY_REF (merge-base failed)." >&2
      exit 5
    fi
    if [ "$mb_status" -ne 0 ]; then
      echo "   ❌ ERROR: no merged PR for '$BRANCH', and its commits are not in origin/$PRIMARY_REF." >&2
      echo "   This branch's commits may exist nowhere else — refusing to delete." >&2
      echo "   If the work is genuinely disposable, delete the branch by hand." >&2
      exit 6
    fi
    echo "   ℹ️  '$BRANCH' not on origin, and its tip is already in origin/$PRIMARY_REF — safe to delete."
    fi
  else
    echo "   ❌ ERROR: 'git ls-remote' failed — cannot verify '$BRANCH' on origin." >&2
    echo "   Refusing to delete on an unverified remote state." >&2
    exit 5
  fi
fi

# --- 3. remove this branch's worktree, if it still has one ------------------
# No --force. git refusing a dirty worktree IS the safeguard; the old retry
# overrode it one line later and destroyed uncommitted work on a routine
# cleanup (#210). A merged PR says nothing about local-only edits.
#
# TARGET_WT empty means the worktree is already gone — the #262 "branch
# exists, worktree already removed" case. There is nothing to remove; skip
# straight to branch deletion instead of dead-ending on "nothing to clean up".
if [ -n "$TARGET_WT" ]; then
  echo "🗑  Removing worktree $TARGET_WT..."
  # Capture git's own stderr instead of discarding it: the interpretation
  # below is a best guess (locked vs. dirty), and #262's whole complaint was
  # a guessed diagnosis standing in for the real one. Printing git's message
  # ALONGSIDE the guess lets a permissions problem, a submodule snag, or a
  # missing directory be told apart from an actually-dirty tree at a glance.
  if ! WT_REMOVE_ERR=$(git -C "$MAIN_CLONE" worktree remove "$TARGET_WT" 2>&1); then
    echo "   git says:" >&2
    echo "$WT_REMOVE_ERR" | sed 's/^/     /' >&2
    if [ "$TARGET_LOCKED" -eq 1 ]; then
      # A locked worktree is not a dirty one — git refuses it for an entirely
      # different reason, most often EnterWorktree holding it open for a live
      # session. Reporting this as "likely has uncommitted or untracked
      # changes" is a wrong diagnosis an agent will act on: it goes hunting for
      # phantom dirty files instead of looking for the thing that locked it (#262).
      echo "   ❌ ERROR: worktree removal refused — it is LOCKED, most likely by EnterWorktree" >&2
      echo "   while a session is still inside it." >&2
      echo "   Once that session has exited (ExitWorktree), unlock and retry:" >&2
      echo "     git -C \"$MAIN_CLONE\" worktree unlock \"$TARGET_WT\"" >&2
      echo "     pr-cleanup $BRANCH" >&2
    else
      echo "   ❌ ERROR: worktree removal refused — likely has uncommitted or untracked changes," >&2
      echo "   but see git's message above: a permissions problem, a submodule, or a missing" >&2
      echo "   directory produces this same failure and needs a different fix." >&2
      echo "   Inspect with: git -C \"$TARGET_WT\" status --short" >&2
      echo "   Then commit, stash, or remove it by hand with --force once you are sure." >&2
    fi
    exit 6
  fi
else
  echo "ℹ️  No worktree registered for '$BRANCH' — already removed. Deleting the branch only."
fi

# --- 4. delete the remote branch -------------------------------------------
# Confirm the ref is actually gone rather than trusting the exit status alone:
# auth, network and protected-ref rejections were all being reported as
# "may already be deleted", under a final "✅ Cleanup complete" (#210).
#
# --force-with-lease pins the delete to the sha the gate verified, closing the
# residual race between that check and this push: if someone lands a commit in
# between, the push is REJECTED rather than silently taking their work with it.
echo "🗑  Deleting remote branch origin/$BRANCH..."
LEASE=()
if [ -n "${PR_HEAD_OID:-}" ]; then
  LEASE=(--force-with-lease="refs/heads/$BRANCH:$PR_HEAD_OID")
elif [ -n "${REMOTE_TIP:-}" ]; then
  # #266 abandoned-branch arm: origin/$BRANCH existed and its tip was just
  # proven contained in origin/$PRIMARY_REF. Pin the lease to that exact tip —
  # NOT the must-not-exist form below, which would assert the ref is absent
  # when it is not and get rejected outright — so a push landing between the
  # check and here is REJECTED rather than silently swept up, the same
  # race-closing shape as the PR_HEAD_OID lease above (#264/E-3).
  LEASE=(--force-with-lease="refs/heads/$BRANCH:$REMOTE_TIP")
else
  # No-merged-PR, absent-from-origin arm: neither PR_HEAD_OID nor REMOTE_TIP
  # is set here, so this used to push a bare `--delete` with no lease at all.
  # The gate above proved origin/$BRANCH was absent at ls-remote time, so pin
  # the delete to exactly that with the must-not-exist lease form (empty
  # expected value) — a branch pushed by someone else in the race window
  # between that check and this push is then REJECTED, not silently swept up
  # (#264/E-3).
  LEASE=(--force-with-lease="refs/heads/$BRANCH:")
fi
if git -C "$MAIN_CLONE" push "${LEASE[@]}" origin --delete "$BRANCH" 2>/dev/null; then
  echo "   ✅ remote branch deleted."
elif REMAINS=$(git -C "$MAIN_CLONE" ls-remote --heads origin "$BRANCH" 2>/dev/null); then
  if [ -n "$REMAINS" ]; then
    echo "   ❌ ERROR: failed to delete remote branch origin/$BRANCH — it still exists." >&2
    echo "   The worktree was removed; the branch refs were left intact." >&2
    exit 6
  fi
  echo "   ℹ️  Remote branch was already deleted."
else
  echo "   ❌ ERROR: remote delete failed and 'ls-remote' could not confirm the branch state." >&2
  exit 5
fi

# --- 5. delete the local branch --------------------------------------------
# -D, not -d, and deliberately so. Under squash-merge git never considers the
# branch merged, so `git branch -d` would refuse every single legitimate
# cleanup. The proof of merge is the PR gate in step 2 — which is strictly
# stronger than git's ancestry test, because it also pins the tip to the exact
# commit the PR merged.
#
# The failure is checked against the ref, not inferred from the exit status —
# same rule as every other gate here. A ref-lock error, a permissions problem or
# the branch being checked out in another worktree all make `branch -D` fail
# while the branch is still very much there, and reporting that as "already
# gone" under a final "✅ Cleanup complete" is the exact fail-open shape this
# script exists to remove.
echo "🗑  Deleting local branch $BRANCH..."
if ! git -C "$MAIN_CLONE" branch -D "$BRANCH" 2>/dev/null; then
  if git -C "$MAIN_CLONE" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    echo "   ❌ ERROR: failed to delete local branch '$BRANCH' — it still exists." >&2
    echo "   Checked out in another worktree, or a ref lock / permissions problem." >&2
    exit 6
  fi
  echo "   ℹ️  Local branch already gone."
fi

# --- 6. close any herdr tab left pointing at a directory that no longer exists
# Step 3 removed the worktree; a herdr bookmark tab opened by `wt-new` is still
# sitting at that path, and nothing else tracks it. Observed live 2026-08-16:
# PR #305 merged, `pr-cleanup 301-block-commit-on-main` ran, and the tab was
# still in `herdr tab list` with its cwd now pointing at the deleted path
# (#277). Same family as #233 — things rooted in a worktree need teardown.
#
# herdr-reap is deliberately NOT told which worktree died. Once a directory is
# removed herdr reports that pane's cwd as "<path> (deleted)", so the reported
# path no longer equals the path just removed, and any match-by-path design
# silently stops matching at the exact moment it matters. It asks only "does
# each pane's cwd still exist", which is why it is correct whenever it runs and
# why it is a standalone tool this merely calls rather than logic embedded here.
#
# Best-effort in both directions, and that is the whole contract: herdr is
# decoration and must never be load-bearing. Cleanup has already succeeded by
# this point, so a missing herdr, a missing herdr-reap, or a refused tab close
# must not turn a completed cleanup into a failure — hence `|| true`. Callers
# that need the outcome run `herdr-reap --json` themselves; this one does not.
# The sibling copy is preferred over PATH so a repo checkout exercises the
# version it ships with rather than whatever ~/bin last installed.
REAP="$(cd "$(dirname "$0")" && pwd)/herdr-reap"
if [ -x "$REAP" ]; then
  "$REAP" >/dev/null 2>&1 || true
elif command -v herdr-reap >/dev/null 2>&1; then
  herdr-reap >/dev/null 2>&1 || true
fi

# A script cannot change its caller's shell — a trailing `cd` here only moves
# this process, which then exits, and claiming otherwise is simply false
# (#220). The containment gate above also means, on every documented path,
# the caller's cwd was never inside the worktree just removed — so unlike the
# bug this replaces, there is nothing here for a vanished cwd to break. Name
# where the operator should go; do not pretend to have taken them there.
echo "✅ Cleanup complete for '$BRANCH'. Main clone: $MAIN_CLONE"
exit 0
