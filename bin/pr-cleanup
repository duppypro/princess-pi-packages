#!/usr/bin/env bash
# pr-cleanup — delete a merged branch, its remote, and its worktree.
# Auto-discovers branch and worktree from cwd. Run from the feature
# worktree AFTER the PR was merged.
#
# Governing rule (#210): every gate fails CLOSED. A check that cannot PROVE its
# precondition aborts — it never assumes the safe-to-delete case. Each of the
# three Critical findings on #204 was the same mistake in a different costume:
# a command failing, and the failure being read as "nothing to worry about."
set -euo pipefail

# `pwd` is wherever the human happened to be standing; `git worktree remove`
# only accepts the registered top level, so running from any subdirectory used
# to fail after the safety gate had already passed (#210).
CWD=$(git rev-parse --show-toplevel)
BRANCH=$(git branch --show-current)

if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  echo "pr-cleanup: on main — nothing to clean up from here." >&2
  exit 1
fi

echo "🧹 pr-cleanup for branch '$BRANCH'"

# --- 0. locate the main clone ----------------------------------------------
# `git worktree list | grep "\[main\]" | awk '{print $1}'` truncated any path
# containing a space, and parsed human-readable output for machine state — the
# Agent-First Output standard forbids exactly that. --porcelain is the contract.
MAIN_CLONE=$(git worktree list --porcelain | awk '
  /^worktree /            { p = substr($0, 10) }
  $0 == "branch refs/heads/main" || $0 == "branch refs/heads/master" { print p; exit }
')
if [ -z "$MAIN_CLONE" ]; then
  echo "   ❌ ERROR: no main worktree found. Switch to the main clone and run from there." >&2
  exit 1
fi

# --- 1. freshen refs before judging anything -------------------------------
# origin/main is a local cache; deciding "merged" against a stale one is a guess.
if ! git -C "$MAIN_CLONE" fetch --quiet origin 2>/dev/null; then
  echo "   ❌ ERROR: 'git fetch origin' failed — cannot verify merge state." >&2
  exit 1
fi

# --- 2. safety gate: prove THIS branch tip was merged -----------------------
echo "🔍 Verifying PR for '$BRANCH' was merged..."
OWNER=$(gh repo view --json owner --jq '.owner.login')
# `2>/dev/null || true` here would be the same fail-open hole as the ls-remote
# one below: a gh outage yields an empty PR_INFO, which falls through to the
# "no merged PR" branch and can reach deletion having verified nothing.
if ! PR_INFO=$(gh pr list --head "$BRANCH" --state merged \
  --json number,mergeCommit,headRefOid,headRepositoryOwner \
  --jq "[.[] | select(.headRepositoryOwner.login == \"$OWNER\")] | .[0]"); then
  echo "   ❌ ERROR: 'gh pr list' failed — cannot verify the PR for '$BRANCH'." >&2
  exit 1
fi

if [ -n "$PR_INFO" ] && [ "$PR_INFO" != "null" ]; then
  PR_NUM=$(echo "$PR_INFO" | jq -r '.number')
  PR_MERGE_SHA=$(echo "$PR_INFO" | jq -r '.mergeCommit.oid // empty')
  PR_HEAD_OID=$(echo "$PR_INFO" | jq -r '.headRefOid // empty')
  LOCAL_TIP=$(git rev-parse HEAD)

  if [ -z "$PR_MERGE_SHA" ] || ! git -C "$MAIN_CLONE" merge-base --is-ancestor "$PR_MERGE_SHA" origin/main 2>/dev/null; then
    echo "   ❌ ERROR: PR #$PR_NUM is marked merged but its merge commit is not in origin/main." >&2
    exit 1
  fi

  # The gate above proves a PR with this branch NAME was merged. It says nothing
  # about the commits in hand. Comparing the tip to the PR's headRefOid is what
  # ties the two together, and catches both a reused branch name and commits
  # pushed after the merge (#210).
  #
  # NOT `git merge-base --is-ancestor "$BRANCH" "$PR_MERGE_SHA"` — the suggested
  # remedy on #204. We squash-merge, so the branch tip is never an ancestor of
  # the squash commit and that check would refuse every legitimate cleanup.
  if [ -z "$PR_HEAD_OID" ]; then
    echo "   ❌ ERROR: PR #$PR_NUM reports no headRefOid — cannot tie it to this branch." >&2
    exit 1
  fi
  if [ "$LOCAL_TIP" != "$PR_HEAD_OID" ]; then
    echo "   ❌ ERROR: branch tip does not match what PR #$PR_NUM merged — unmerged work present." >&2
    echo "      local tip:      $LOCAL_TIP" >&2
    echo "      PR headRefOid:  $PR_HEAD_OID" >&2
    echo "   Refusing to delete. Open a new PR for the extra commits, or reset the branch." >&2
    exit 1
  fi
  echo "   ✅ PR #$PR_NUM merged into origin/main, and its head matches this branch tip."
else
  # No merged PR. The branch being absent from origin is the ONLY reading that
  # allows cleanup — and a failed ls-remote is not that reading. Testing exit
  # status separately from output is the whole point: `… 2>/dev/null | grep -q`
  # made an auth or network failure indistinguishable from "branch not found",
  # and deleted local work on the strength of it (#210).
  if LS_REMOTE_OUT=$(git -C "$MAIN_CLONE" ls-remote --heads origin "$BRANCH" 2>/dev/null); then
    if [ -n "$LS_REMOTE_OUT" ]; then
      echo "   ❌ ERROR: '$BRANCH' exists on origin but no merged PR was found." >&2
      exit 1
    fi
    echo "   ℹ️  '$BRANCH' not on origin and no merged PR — nothing to verify, proceeding."
  else
    echo "   ❌ ERROR: 'git ls-remote' failed — cannot verify '$BRANCH' on origin." >&2
    echo "   Refusing to delete on an unverified remote state." >&2
    exit 1
  fi
fi

# --- 3. remove this worktree (from the main clone) --------------------------
# No --force. git refusing a dirty worktree IS the safeguard; the old retry
# overrode it one line later and destroyed uncommitted work on a routine
# cleanup (#210). A merged PR says nothing about local-only edits.
echo "🗑  Removing worktree $CWD..."
if ! git -C "$MAIN_CLONE" worktree remove "$CWD" 2>/dev/null; then
  echo "   ❌ ERROR: worktree removal refused — it likely has uncommitted or untracked changes." >&2
  echo "   Inspect with: git -C \"$CWD\" status --short" >&2
  echo "   Then commit, stash, or remove it by hand with --force once you are sure." >&2
  exit 1
fi

# --- 4. delete the remote branch -------------------------------------------
# Confirm the ref is actually gone rather than trusting the exit status alone:
# auth, network and protected-ref rejections were all being reported as
# "may already be deleted", under a final "✅ Cleanup complete" (#210).
echo "🗑  Deleting remote branch origin/$BRANCH..."
if git -C "$MAIN_CLONE" push origin --delete "$BRANCH" 2>/dev/null; then
  echo "   ✅ remote branch deleted."
elif REMAINS=$(git -C "$MAIN_CLONE" ls-remote --heads origin "$BRANCH" 2>/dev/null); then
  if [ -n "$REMAINS" ]; then
    echo "   ❌ ERROR: failed to delete remote branch origin/$BRANCH — it still exists." >&2
    echo "   The worktree was removed; the branch refs were left intact." >&2
    exit 1
  fi
  echo "   ℹ️  Remote branch was already deleted."
else
  echo "   ❌ ERROR: remote delete failed and 'ls-remote' could not confirm the branch state." >&2
  exit 1
fi

# --- 5. delete the local branch --------------------------------------------
# -D, not -d, and deliberately so. Under squash-merge git never considers the
# branch merged, so `git branch -d` would refuse every single legitimate
# cleanup. The proof of merge is the PR gate in step 2 — which is strictly
# stronger than git's ancestry test, because it also pins the tip to the exact
# commit the PR merged.
echo "🗑  Deleting local branch $BRANCH..."
if ! git -C "$MAIN_CLONE" branch -D "$BRANCH" 2>/dev/null; then
  echo "   ℹ️  Local branch already gone."
fi

echo "✅ Cleanup complete. Now in $MAIN_CLONE"
cd "$MAIN_CLONE"
