#!/usr/bin/env bash
# ---
# herdr-tab — the one place the "are we actually inside herdr?" predicate lives
# (#277). Sourceable library first, tiny CLI second.
#
#   . herdr-tab            defines herdr_available() and herdr_tab()
#   herdr-tab <cwd> <label>  opens one best-effort bookmark tab, always exit 0
#   herdr-tab --version      prints the resolved absolute path of this copy
#   herdr-tab -- <cwd> <label>  same, for a cwd or label starting with '-'
#
# --- why this is a separate file, not three inlined copies -------------------
# `wt-new` and `herdr-reap` both need the same guard, and the guard is subtle
# enough that three copies would drift the first time one of them was "fixed".
#
# --- THE DETECTION CONTRACT (the finding that determines the whole design) ---
# herdr compiles in a DEFAULT socket path. So `herdr <cmd>` answers exit 0 from
# ANY shell on this host — cron, CI, a plain SSH login — even with
# HERDR_SOCKET_PATH, HERDR_ENV and HERDR_PANE_ID all unset. It silently targets
# whatever session is running for that uid, and every pane/workspace-scoped
# command then resolves against the FOCUSED pane or workspace, i.e. "whatever
# Duppy happens to be looking at". Verified on 0.8.0:
#
#   $ env -u HERDR_SOCKET_PATH -u HERDR_ENV -u HERDR_PANE_ID herdr tab list >/dev/null; echo $?
#   0
#   $ env -u HERDR_PANE_ID herdr pane current     # answered with a pane in a DIFFERENT repo
#
# ⇒ Neither `command -v herdr`, nor socket reachability, nor exit status tells
# you whether THIS shell is inside herdr. Only the pane id does. herdr's own
# installed integration hook (~/.claude/hooks/herdr-agent-state.sh, v7) guards
# on exactly the same thing, with exit 0 on every bail.
#
# Corollary, and the reason --workspace is always passed explicitly below:
# implicit resolution means "the focused workspace", not "ours".
#
# --- herdr is decoration, never load-bearing --------------------------------
# Vanilla git owns the worktree lifecycle. Every call here is best-effort and
# silent when herdr is absent, and every path `return 0` so a caller's `set -e`
# cannot promote a missing convenience into a failed worktree.
#
# Observed against herdr 0.8.0 / protocol 19. `herdr tab create` takes
# --workspace/--cwd/--label/--focus/--no-focus; confirmed live, not read from
# release notes.
# ---

# ---
# True when this shell is inside a live herdr pane AND herdr is runnable.
# The ONLY correct form of the question — see the detection contract above.
# ---
herdr_available() {
	[ -n "${HERDR_PANE_ID:-}" ] || return 1
	[ -n "${HERDR_WORKSPACE_ID:-}" ] || return 1
	command -v herdr >/dev/null 2>&1 || return 1
	return 0
}

# ---
# Open a bookmark tab at $1 labelled $2. Never fails, never focuses.
#
# --no-focus ALWAYS: `wt-new` runs mid-turn while the human is reading
# something else, and yanking the cursor into a bare shell is a worse outcome
# than no tab at all.
#
# Returns 0 on every path — a caller's `set -e` must never see decoration fail.
# What actually happened is reported OUT OF BAND in $HERDR_TAB_RESULT, one of
# `created` / `skipped` / `failed`, so a caller can still tell the human the
# truth without being able to abort on it. (Losing that distinction into an
# always-cheerful message is the prose/reality gap #224 exists about; losing it
# into an exit code would make herdr load-bearing. This is the seam between
# those two.)
# ---
herdr_tab() { # $1 = cwd, $2 = label
	HERDR_TAB_RESULT=skipped
	herdr_available || return 0
	if herdr tab create --workspace "$HERDR_WORKSPACE_ID" \
		--cwd "$1" --label "$2" --no-focus >/dev/null 2>&1; then
		HERDR_TAB_RESULT=created
	else
		HERDR_TAB_RESULT=failed
	fi
	return 0
}

# ---
# CLI mode. `${BASH_SOURCE[0]}` equals `$0` only when this file was EXECUTED;
# when sourced, BASH_SOURCE[0] is this path while $0 is the caller's. So the
# block below is skipped on `. herdr-tab`, which is what keeps `set -euo
# pipefail` — correct for a script, hostile to a caller's interactive shell —
# out of a sourcing caller's environment.
# ---
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
	set -euo pipefail
	case "${1:-}" in
	-h | --help)
		# Header IS the help text.
		sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
		exit 0
		;;
	# #178: resolved absolute path of the running copy. Only meaningful in CLI
	# mode (this branch) — a sourced `. herdr-tab` never reaches here at all, so
	# there is no --version for the library half; the guard predicate lives in
	# herdr_available()/herdr_tab(), unaffected by this case. `readlink -f`
	# resolves a real file OR a symlink to its actual on-disk location. Not
	# built, so no commit-hash/semver stamp — PATH only.
	--version)
		readlink -f "$0"
		exit 0
		;;
	# #362: a leading dash is never a <cwd>. This refused already (the arg count
	# check below), but with a generic usage line that never named the offending
	# flag — so a typo'd flag read as "you passed the wrong number of arguments".
	# #367: the conventional escape, so a <cwd> or <label> that really does start
	# with a dash stays reachable now that both are guarded below. Same shape as
	# git-checkpoint's `--` and pr-threads' `--reply --`.
	--)
		shift
		ESCAPED=1
		;;
	-*)
		echo "herdr-tab: unknown flag: $1 (try --help)" >&2
		exit 2
		;;
	esac
	if [ $# -lt 2 ]; then
		echo "usage: herdr-tab <cwd> <label>   (or: . herdr-tab, then herdr_tab <cwd> <label>)" >&2
		exit 2
	fi
	# #367: name the extra argument rather than reprinting the usage line, which
	# read as "wrong number of arguments" for what is nearly always a typo.
	if [ $# -gt 2 ]; then
		echo "herdr-tab: unexpected argument: $3 — herdr-tab takes exactly <cwd> <label>." >&2
		echo "usage: herdr-tab <cwd> <label>" >&2
		exit 2
	fi
	# #367: the guard above caught a dash-leading <cwd> and let a dash-leading
	# LABEL straight through — the mirror asymmetry. A swallowed flag becoming a
	# tab label is harmless in itself, but it is the same class as `pr-reject -b
	# --json`, and "which argument happens to be checked" is not a contract.
	if [ "${ESCAPED:-0}" -eq 0 ]; then
		for arg in "$1" "$2"; do
			case "$arg" in
			-*)
				echo "herdr-tab: '$arg' looks like a flag, not a <cwd> or <label>." >&2
				echo "  For a value that really starts with '-': herdr-tab -- <cwd> <label>" >&2
				exit 2
				;;
			esac
		done
	fi
	herdr_tab "$1" "$2"
	exit 0
fi
