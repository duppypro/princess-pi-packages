#!/usr/bin/env bash
# ---
# pr-review — review this branch's diff before it becomes a PR.
#
# The intervention arm of duppypro/btw#59. That issue measured a paid reviewer at
# $1.28 per PR over 112 PRs in 8 days ($143.56 total), billed per run at a $0.50
# floor. This runs our own review first, where the marginal cost is zero.
#
# --- Why three lenses and not one pass ---
# Across three rounds on btw#61 the paid reviewer raised 11 findings, all real.
# The two that changed published numbers were not code defects — a power
# calculation that solved for point-estimate significance instead of statistical
# power, and a baseline inflated by counting findings from outside its own
# billing window. A linter, a type checker and a diff reader all pass that code.
# So one lens reads the code, one reads the CLAIMS against the code, and one
# reads the failure paths. Distinct lenses beat a repeated pass: redundancy finds
# the same things twice.
#
# --- Why it blocks ---
# Findings mean exit 7 and no PR. A gate that prints and proceeds is a gate an
# agent walks straight through, and the question this experiment asks is whether
# findings get ACTED ON before the PR opens, not whether they get printed.
# `--reviewed` on pr-open is the escape hatch, deliberately an explicit word.
#
# --- Why it fails open, and the exact limit of that promise ---
# `claude` missing, erroring, or TIMING OUT means the PR still gets created: a
# broken reviewer must never become a broken release path. The promise covers
# hangs too, which is why every lens is wrapped in `timeout` — an earlier version
# waited unconditionally and would have wedged pr-open on a stalled reviewer,
# the one failure this paragraph claims cannot happen.
#
# --- Exit codes ---
#   0  reviewed, nothing found (or fail-open: reviewer unavailable)
#   2  usage error
#   2  usage error — bad flags, or not run inside a git repository at all (the
#      shared #224 table assigns that condition 2, and this file amends that
#      table, so disagreeing with it here would ship the contradiction it fixes)
#   3  precondition — on a protected branch, or the diff itself failed
#   7  findings — the PR was NOT created; fix them or use `pr-open --reviewed`
#
# Under `set -euo pipefail` a few unguarded operations can still exit 1 with no
# message and no JSON: an unwritable log directory, the collector raising, a
# missing `timeout`. Those are NOT in the table above and this note is the honest
# statement of that rather than a claim of exhaustiveness the shell cannot keep.
# pr-open maps every non-7 status to "proceeding unreviewed", so the release path
# stays safe; a machine caller must therefore treat "no stdout" as "reviewer
# unavailable" and not as "clean".
#
# --- Environment ---
#   PR_REVIEW_MODEL    model for every lens and the clustering pass (default
#                      claude-opus-5; explicit, never inherited)
#   PR_REVIEW_TIMEOUT  per-lens wall-clock ceiling in seconds (default 600)
#   PR_REVIEW_LOG_DIR  where run logs land (default
#                      ${XDG_STATE_HOME:-$HOME/.local/state}/pr-review/<repo>)
#   PR_REVIEW_NO_CLUSTER=1  skip the clustering pass; distinct == raw
# ---
set -euo pipefail

LENSES=("correctness" "reasoning" "contract")
# Explicit, never inherited (~/git-projects/CLAUDE.md model-routing rule). Review
# is judgment work, not mechanical, so it pins the strong model rather than
# downshifting — and marginal cost is zero, so there is no reason to trade
# quality here. An inherited model would also make the review's depth a property
# of whoever happened to call it.
MODEL="${PR_REVIEW_MODEL:-claude-opus-5}"
LENS_TIMEOUT="${PR_REVIEW_TIMEOUT:-600}"
# A ceiling that is not a positive integer is not a ceiling. GNU `timeout 0`
# means "no timeout at all", so PR_REVIEW_TIMEOUT=0 silently removed the very
# protection this variable exists to provide — and a typo like `10m` or `-5`
# made `timeout` exit 125 immediately, failing every lens open. Refuse up front
# rather than discover it as three timed-out lenses (macroscopeapp, PR #379).
case "$LENS_TIMEOUT" in
  ''|*[!0-9]*) echo "pr-review: PR_REVIEW_TIMEOUT must be a positive whole number of seconds (got '$LENS_TIMEOUT')" >&2; exit 2 ;;
esac
[ "$LENS_TIMEOUT" -gt 0 ] || { echo "pr-review: PR_REVIEW_TIMEOUT must be greater than 0 — 'timeout 0' disables the ceiling entirely" >&2; exit 2; }
# TERM asks; KILL insists. `timeout` sends only TERM, so a reviewer that traps or
# ignores it keeps the lens wrapper — and the `wait` below — blocked forever,
# which is precisely the hang the ceiling was added to prevent. The grace is a
# fixed 30s rather than a fraction of the ceiling: it is time for a well-behaved
# child to flush and exit, not a second review budget.
LENS_KILL_AFTER=30

usage() {
  cat <<'EOF'
usage: pr-review [--base <ref>] [--json] [--quiet]
       pr-review -h | --help
       pr-review --version

Reviews the current branch's diff against its merge-base with the primary branch,
in three parallel lenses (correctness, reasoning, contract), and reports findings.

Findings are written to a JSON log OUTSIDE the repository, under
${XDG_STATE_HOME:-$HOME/.local/state}/pr-review/<repo>/ — on a default Linux host
XDG_STATE_HOME is unset, so that is ~/.local/state/pr-review/<repo>/. Keeping the
logs out of the tree is what stops `git add -A` committing them.

environment: PR_REVIEW_MODEL (default claude-opus-5) · PR_REVIEW_TIMEOUT (600s)
             PR_REVIEW_LOG_DIR · PR_REVIEW_NO_CLUSTER=1

exit codes: 0 clean (or reviewer unavailable) · 2 usage / not a git repo
            3 precondition (protected branch, diff failed) · 7 findings
            (set -e can still surface an undocumented 1 — see the header)
EOF
}

JSON_OUT=0
QUIET=0
BASE=""
# Terminal flags take no other arguments (#367): every other script in bin/
# refuses this, and `pr-review --json -h` silently dropping --json was the
# inconsistency.
for a in "$@"; do
  case "$a" in
    -h|--help|--version)
      if [ "$#" -ne 1 ]; then
        echo "pr-review: $a takes no other arguments (got: $*)" >&2
        exit 2
      fi ;;
  esac
done
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    # #178: which copy am I running? install-workflow-tools deploys this to
    # ~/bin, so a bare `pr-review` runs whatever was last installed.
    --version) readlink -f "$0"; exit 0 ;;
    --json) JSON_OUT=1; shift ;;
    --quiet) QUIET=1; shift ;;
    # A flag-shaped value is refused, not consumed (#367, same reason as
    # pr-reject's -b). `--base --json` used to set BASE=--json and silently drop
    # the real flag; git diff then failed, emit_status returned 3, and pr-open
    # read that as "proceeding unreviewed" — a one-token typo turned a usage
    # error into an unreviewed PR, the exact outcome this gate exists to prevent.
    --base)
      BASE="${2:-}"
      [ -n "$BASE" ] || { echo "pr-review: --base needs a ref" >&2; exit 2; }
      case "$BASE" in -*) echo "pr-review: --base got a flag-shaped value '$BASE'" >&2; exit 2 ;; esac
      shift 2 ;;
    *) echo "pr-review: unknown argument '$1'" >&2; usage >&2; exit 2 ;;
  esac
done

# Every exit path speaks the caller's language. A machine reader most needs to
# tell 'nothing to review' from 'reviewer unavailable' from 'clean', and the old
# version emitted a human sentence, an empty stdout, and JSON respectively.
emit_status() {  # emit_status <status> <human message> <exit code>
  if [ "$JSON_OUT" -eq 1 ]; then
    # Built by a JSON encoder, not `sed 's/"/\\"/g'`. That escaped double quotes
    # and nothing else, so a backslash, newline or control character in the
    # message — and $BASE flows in here verbatim from --base — produced an
    # invalid escape and broke the "exactly one parseable document" contract on
    # precisely the error paths a machine reader most needs.
    if command -v python3 >/dev/null 2>&1; then
      python3 -c 'import json,sys; print(json.dumps({"status":sys.argv[1],"findings":[],"distinct":[],"distinctFindings":0,"failedLenses":[],"lensesRan":0,"message":sys.argv[2]}))' "$1" "$2"
    else
      printf '{"status":"%s","findings":[],"distinct":[],"distinctFindings":0,"failedLenses":[],"lensesRan":0,"message":"reviewer unavailable"}\n' "$1"
    fi
  elif [ "$QUIET" -eq 0 ]; then
    printf '%s\n' "$2" >&2
  fi
  exit "$3"
}

# Code 2, not 3: the shared pr-* table (#224, docs/dev-workflow-spec.md) puts
# "not run inside a git repository at all" under usage error, and this change is
# the one amending that table — shipping a header that contradicts it would
# recreate the exact defect the exit-7 row was added to resolve.
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || \
  emit_status "not-a-repo" "pr-review: not inside a git repository." 2

BRANCH=$(git branch --show-current)
if [ -z "$BRANCH" ] || [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  emit_status "precondition" \
    "pr-review: on '${BRANCH:-detached HEAD}' — there is no feature diff to review." 3
fi

if [ -z "$BASE" ]; then
  PRIMARY=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || echo "origin/main")
  BASE=$(git merge-base "$PRIMARY" HEAD 2>/dev/null || true)
fi
[ -n "$BASE" ] || emit_status "precondition" "pr-review: cannot determine a base to diff against." 3

# Status checked SEPARATELY from emptiness. `|| true` used to collapse every git
# failure — a bogus --base, an unreadable object, a shallow clone — into an empty
# diff, which then read as "nothing to review" and exit 0, which pr-open read as
# "reviewed, clean". Three different facts arriving at the one outcome that opens
# PRs unreviewed.
diff_status=0
DIFF=$(git diff --unified=8 "$BASE"...HEAD 2>/dev/null) || diff_status=$?
if [ "$diff_status" -ne 0 ]; then
  emit_status "diff-failed" \
    "pr-review: 'git diff $BASE...HEAD' failed (status $diff_status) — cannot review." 3
fi
[ -n "$DIFF" ] || emit_status "no-changes" "🔍 pr-review: no changes against $BASE — nothing to review." 0

# Fail open, loudly, and name the real cause. python3 is guarded for the same
# reason claude is: without it the script died under `set -e` with 127, an exit
# code in no table, which pr-open reported as "proceeding unreviewed" with no
# hint that an interpreter was missing rather than a reviewer broken.
command -v claude >/dev/null 2>&1 || \
  emit_status "reviewer-unavailable" "⚠️  pr-review: 'claude' not on PATH — opening the PR unreviewed." 0
command -v python3 >/dev/null 2>&1 || \
  emit_status "reviewer-unavailable" "⚠️  pr-review: 'python3' not on PATH — opening the PR unreviewed." 0

# Logs live OUTSIDE the repository. The old default was the relative path
# `.claude/pr-review`, and NO repo ignores it — not even this one:
# `git check-ignore .claude/pr-review/x.json` matches nothing here, because
# .gitignore covers `.claude/worktrees` specifically, not `.claude/`. So the next
# `git add -A` swept the review logs into the branch being reviewed, everywhere,
# including btw (where this experiment's PRs are opened). A relative path also
# meant running from a subdirectory wrote somewhere no ignore rule would anchor.
# Neither problem exists if the logs are never in a repo.
#
# (An earlier version of this comment said princess-pi-packages ignored the path.
# It does not; the reason to move the logs out was stronger than stated, not
# weaker. Verified with git check-ignore rather than by reading .gitignore.)
REPO_NAME=$(basename "$(git rev-parse --show-toplevel)")
LOG_DIR="${PR_REVIEW_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/pr-review/$REPO_NAME}"
# Mapped, not raw. Under `set -e` a failed mkdir exited with mkdir's own status
# (1), which is not in this script's table at all — and the spec asserts pr-review
# is a member of the shared pr-* contract, so an unwritable PR_REVIEW_LOG_DIR
# documented a code the script did not emit (macroscopeapp, PR #379). 3 is the
# right row: a precondition the environment failed to meet, not a bad flag.
if ! mkdir -p "$LOG_DIR" 2>/dev/null; then
  echo "pr-review: cannot create the log directory '$LOG_DIR'." >&2
  echo "   Set PR_REVIEW_LOG_DIR to a writable path, or clear it to use the default." >&2
  exit 3
fi
STAMP=$(date -u +%Y-%m-%dT%H-%M-%SZ)
# $$ suffix: the stamp is second-resolution, and two runs in the same second
# (a retry after fixing a finding) silently overwrote each other. These logs are
# the evidence artifact for btw#59 — a lost run is lost measurement.
LOG="$LOG_DIR/${BRANCH//\//-}-$STAMP-$$.json"
WORK=$(mktemp -d "${TMPDIR:-/tmp}/pr-review.XXXXXXXX")
# EXIT cleans up; INT/TERM additionally kill the lens children and EXIT. A bare
# handler on INT/TERM returns to the interrupted command, so the background
# `timeout claude` processes survived as orphans still burning a reviewer call,
# and the collector then read from a directory that had just been deleted.
# Children are killed BY PID, never with `kill 0`. This script is not a process
# group leader when invoked normally, so `kill 0` signals the caller's entire
# group — pr-open, the shell that ran it, and any sibling job. Killing exactly
# what this script started is the only version that is safe to ship.
LENS_PIDS=()
# Each entry is the `{ ... } &` WRAPPER subshell, and killing that alone leaves
# the `timeout claude` it spawned running — an early version reaped the
# bookkeeping and left the expensive part alive.
#
# TERM ALONE IS NOT ENOUGH, and `--kill-after` does not cover this path
# (macroscopeapp, PR #379). That flag governs `timeout`'s OWN expiry: when
# `timeout` is itself signalled, it forwards the signal to its child and exits
# rather than waiting to escalate. So a reviewer that traps or ignores TERM
# outlived the trap as an orphan, still holding an in-flight model call — the
# exact resource leak the ceiling exists to prevent, reached by the other door.
# `pkill -P` also reaches only DIRECT children, so anything `claude` spawned was
# never signalled at all.
#
# So: walk the whole descendant tree, TERM it, allow a short grace to flush, then
# KILL unconditionally. Still BY PID, never `kill 0` — this script is not a
# process-group leader when invoked normally, and `kill 0` would signal the
# caller's entire group (pr-open, its shell, any sibling job).
#
# The grace is 2s, not the 30s of --kill-after: this path runs inside an INT
# trap, where a human is waiting on their own Ctrl-C.
_descendants() {
  local kid
  for kid in $(ps -o pid= --ppid "$1" 2>/dev/null); do
    _descendants "$kid"
    printf '%s\n' "$kid"
  done
}
kill_lenses() {
  local pid kid tree=""
  for pid in ${LENS_PIDS+"${LENS_PIDS[@]}"}; do
    tree="$tree $(_descendants "$pid" | tr '\n' ' ') $pid"
  done
  # shellcheck disable=SC2086
  set -- $tree
  [ "$#" -gt 0 ] || return 0
  for kid in "$@"; do kill -TERM "$kid" 2>/dev/null || true; done
  sleep 2
  # KILL is unconditional rather than conditional on liveness: `kill -KILL` on a
  # reaped pid is a suppressed error, and a liveness poll here would be one more
  # thing to get wrong on the path that exists precisely because something is
  # already misbehaving.
  for kid in "$@"; do kill -KILL "$kid" 2>/dev/null || true; done
}
trap 'rm -rf "$WORK"' EXIT
trap 'kill_lenses; rm -rf "$WORK"; exit 130' INT
trap 'kill_lenses; rm -rf "$WORK"; exit 143' TERM
printf '%s' "$DIFF" > "$WORK/diff"

lens_prompt() {
  case "$1" in
    correctness)
      echo "Review this diff for CORRECTNESS defects: logic errors, wrong conditions, off-by-one, \
unhandled inputs, race conditions, resource leaks, incorrect algorithms." ;;
    reasoning)
      echo "Review this diff for REASONING defects — the class a linter cannot see. Check every \
CLAIM the change makes (in comments, docstrings, documentation, commit messages, printed output, \
variable names) against what the code ACTUALLY computes. Verify arithmetic, statistics, units, \
percentages, sample sizes, thresholds and cited figures by recomputing them yourself. A number \
that is stated but not derivable from the code is a finding. Stated guarantees the code does not \
enforce are findings." ;;
    contract)
      echo "Review this diff for CONTRACT and failure-path defects: swallowed errors, \
'|| true' hiding real failures, unchecked exit statuses, silent truncation or partial results \
reported as complete, missing pagination, fixed /tmp paths, missing machine-readable output, \
exit codes that contradict documentation, and rules stated in prose but never enforced in code." ;;
  esac
}

for lens in "${LENSES[@]}"; do
  {
    # The prompt goes on STDIN, never argv. Linux caps a single argument at
    # MAX_ARG_STRLEN (131072 bytes) regardless of ARG_MAX, so passing the diff as
    # `-p "$prompt"` made every lens fail with E2BIG on any branch above ~128KB —
    # exit 0, no findings, PR opened. The failure was size-triggered, so the
    # largest changes were exactly the ones that went unreviewed.
    {
      lens_prompt "$lens"
      cat <<'RULES'

Return ONLY a JSON object, no prose around it:
{"findings":[{"severity":"Critical|High|Medium|Low","file":"path","line":123,"title":"short","detail":"what is wrong and why it matters"}]}
Return {"findings":[]} if you find nothing. Do not invent findings to seem useful; a clean diff is a valid result.

DIFF:
RULES
      cat "$WORK/diff"
    } > "$WORK/$lens.prompt"

    # `timeout` so a stalled reviewer cannot wedge pr-open. Expiry is recorded as
    # a failed lens, which is the same treatment as any other failure — never as
    # a clean one.
    if timeout --kill-after="$LENS_KILL_AFTER" "$LENS_TIMEOUT" \
         claude -p --output-format json --model "$MODEL" \
         < "$WORK/$lens.prompt" > "$WORK/$lens.out" 2> "$WORK/$lens.err"; then
      :
    else
      echo "exit $? (timeout ${LENS_TIMEOUT}s or reviewer failure)" >> "$WORK/$lens.err"
      : > "$WORK/$lens.fail"
    fi
  } &
  LENS_PIDS+=($!)
done
wait

# Collector. Paths go through argv, never string interpolation into `python3 -c`:
# git permits apostrophes in ref names and PR_REVIEW_LOG_DIR is unvalidated, so
# the old `json.load(open('$LOG'))` was a SyntaxError at best and arbitrary code
# execution in the release path at worst. Its summary goes to a FILE, not stdout,
# because an unredirected print made `--json` emit two concatenated documents
# with `findings` an integer in one and a list in the other.
python3 - "$WORK" "$LOG" "$BASE" "$BRANCH" "$STAMP" "$MODEL" "${LENSES[@]}" <<'PYEOF'
import json, os, sys


def _balanced_objects(text):
    """Every top-level brace-balanced {...} span, in order, ignoring braces
    inside strings.

    Was `_balanced_object`, returning only the FIRST. One `${VAR}` in the
    reviewer's prose, or any JSON-shaped preamble, therefore won the race against
    the real payload — and the lens was filed as unparseable, or worse, parsed as
    an object with no `findings` and counted as a CLEAN review (macroscopeapp,
    PR #379). Yielding every candidate lets the caller pick the one that is
    actually a review result instead of trusting position.
    """
    depth = 0
    start = -1
    in_str = False
    esc = False
    for i, ch in enumerate(text):
        if in_str:
            if esc:
                esc = False
            elif ch == "\\":
                esc = True
            elif ch == '"':
                in_str = False
            continue
        if ch == '"':
            in_str = True
        elif ch == "{":
            if depth == 0:
                start = i
            depth += 1
        elif ch == "}":
            if depth > 0:
                depth -= 1
                if depth == 0 and start >= 0:
                    yield start, i


def _review_payload(text):
    """The first balanced object that is actually a review result.

    A review result is an object with a `findings` LIST. Both halves matter:
    `parsed.get("findings", [])` used to default a missing key to empty, so
    `{"error": "rate limited"}` became a lens that ran and found nothing —
    a clean review manufactured out of a failure. Requiring the key means a
    response that never contained one is a FAILED lens, which is the treatment
    every other unusable response already gets here.

    Returns (span, parsed) or (None, reason).
    """
    reason = "response contains no JSON object"
    for s, e in _balanced_objects(text):
        reason = "no JSON object in the response carried a 'findings' list"
        try:
            parsed = json.loads(text[s:e + 1])
        except Exception:
            continue
        if not isinstance(parsed, dict) or "findings" not in parsed:
            continue
        if not isinstance(parsed["findings"], list):
            return None, (f"findings is {type(parsed['findings']).__name__}, expected list")
        return (s, e), parsed
    return None, reason


def _clip(text, limit):
    """Truncate WITH a marker. A silently clipped stack trace or response reads as
    complete, and these logs are the recovery path for a dropped finding."""
    if text is None:
        return None
    if len(text) <= limit:
        return text
    return text[:limit] + f"\n…[truncated {len(text) - limit} of {len(text)} bytes]"


work, log, base, branch, stamp, model = sys.argv[1:7]
lenses = sys.argv[7:]
findings, failed, warnings = [], [], []


def fail(lens, why):
    err = os.path.join(work, f"{lens}.err")
    detail = ""
    if os.path.exists(err):
        # Keep the CAUSE. It used to be captured and then deleted unread by the
        # EXIT trap, leaving "N of 3 lenses failed" with no way to tell E2BIG
        # from expired auth from a rate limit — while the script failed open.
        detail = _clip(open(err, errors="replace").read().strip(), 500)
    failed.append({"lens": lens, "why": why, "stderr": detail})


for lens in lenses:
    if os.path.exists(os.path.join(work, f"{lens}.fail")):
        fail(lens, "reviewer exited nonzero or timed out"); continue
    path = os.path.join(work, f"{lens}.out")
    if not os.path.exists(path):
        fail(lens, "no output"); continue
    # EVERY shape check lives inside the try. `env.get(...)` used to sit outside
    # it, so an envelope that parsed as a JSON array rather than an object raised
    # AttributeError, killed the whole collector, and left no log and no summary
    # file — `read < "$WORK/summary"` then failed under `set -e` and pr-review
    # exited 1. pr-open maps 1 to "proceeding unreviewed", so ONE malformed lens
    # response discarded the findings of all three and opened the PR. A bad lens
    # may only ever cost its own lens.
    try:
        env = json.load(open(path))
        if not isinstance(env, dict):
            raise TypeError(f"envelope is {type(env).__name__}, expected object")
        if env.get("is_error"):
            raise ValueError("reviewer reported is_error")
        text = env.get("result")
        if not isinstance(text, str):
            raise TypeError(f"result is {type(text).__name__}, expected string")
    except Exception as exc:
        fail(lens, f"unusable envelope: {exc}"); continue
    # Scan for a BALANCED object rather than first-{ .. last-}. The greedy span
    # broke on any prose brace before or after the payload (a sentence quoting
    # ${VAR}, a trailing explanation), and the lens was then filed as "could not
    # look" — downgrading a lens that had actually found defects into
    # coverage-incomplete, with the findings surviving only in the log's raw field.
    span, parsed = _review_payload(text)
    if span is None:
        # "Could not parse the answer" is NOT "the reviewer broke", and the raw
        # text is kept so a dropped finding stays recoverable. `parsed` carries
        # the reason string in this branch.
        failed.append({"lens": lens, "why": str(parsed),
                       "raw": _clip(text, 2000)})
        continue
    s, e = span
    try:
        items = parsed["findings"]
        # Each finding validated individually: a lens that returns nine good
        # objects and one string keeps its nine.
        good = []
        for f in items:
            if isinstance(f, dict):
                f["lens"] = lens
                good.append(f)
        findings.extend(good)
        if len(good) != len(items):
            # A WARNING, not a failure. This lens ran, returned parseable output,
            # and contributed findings — filing it under failedLenses made
            # `lensesRan` under-report coverage and could flip the status to
            # reviewed-partial on a lens that fully worked, which is the same
            # "could not look" / "found nothing" merge this file forbids
            # everywhere else, one severity down.
            warnings.append({"lens": lens,
                             "why": f"dropped {len(items) - len(good)} malformed finding(s)",
                             "raw": _clip(text[s:e + 1], 2000)})
    except Exception as exc:
        failed.append({"lens": lens, "why": f"findings JSON invalid: {exc}",
                       "raw": _clip(text[s:e + 1], 2000)})
        continue

# STATUS distinguishes complete from partial coverage. Collapsing them into
# "reviewed" let a consumer keying on status record a clean review that never
# happened — the same merge the human path is explicitly gated against.
ran = len(lenses) - len(failed)
status = "reviewed" if not failed else ("reviewed-none" if ran == 0 else "reviewed-partial")

json.dump({"status": status, "branch": branch, "base": base, "utc": stamp,
           "model": model, "lenses": lenses, "failedLenses": failed,
           "lensWarnings": warnings, "lensesRan": ran, "findings": findings},
          open(log, "w"), indent=2)
with open(os.path.join(work, "summary"), "w") as fh:
    fh.write(f"{len(findings)} {len(failed)} {ran}\n")
PYEOF

read -r RAWCOUNT NFAILED NRAN < "$WORK/summary"

# --- Clustering pass (#377 round 2) ---
# The experiment's metric is DISTINCT defects, because the control arm it is
# compared against (btw#59) is a deduplicated per-reviewer count. String keys
# cannot produce that: measured on a live 19-finding run, `file+line+title`
# deduplicated 0%, and no threshold works — genuine duplicate pairs spanned
# 0.09-0.56 title similarity and 0-260 lines apart, because three lenses run
# three different prompts and describe the same defect in different words at
# different lines. Only something that reads the findings can group
# "fail-open on a missing pr-review is silent" with "Missing pr-review is
# skipped silently".
#
# So: one more call, which is affordable precisely because marginal cost is zero.
# It FAILS OPEN to the raw count with `dedup: "failed"` recorded in the log —
# an un-deduplicated number that says so is usable; one that pretends is not.
if [ "$RAWCOUNT" -gt 1 ] && [ "${PR_REVIEW_NO_CLUSTER:-0}" != "1" ]; then
  {
    cat <<'CRULES'
You are given code-review findings produced by three independent reviewers with different
prompts. Several may describe THE SAME underlying defect in different words, at different
line numbers. Group them.

Two findings belong to the same group only if fixing one necessarily fixes the other.
Different defects in the same file, or the same symptom with different causes, are separate.

Return ONLY JSON: {"groups":[[0,3],[1],[2,4,5]]} — arrays of the integer ids below.
Every id must appear exactly once.

FINDINGS:
CRULES
    python3 - "$LOG" <<'PYIDS'
import json, sys
d = json.load(open(sys.argv[1]))
for i, f in enumerate(d["findings"]):
    print(f'{i}: [{f.get("severity","?")}] {f.get("file","?")}:{f.get("line","?")} — '
          f'{f.get("title","")} :: {str(f.get("detail",""))[:300]}')
PYIDS
  } > "$WORK/cluster.prompt"

  if timeout --kill-after="$LENS_KILL_AFTER" "$LENS_TIMEOUT" \
       claude -p --output-format json --model "$MODEL" \
       < "$WORK/cluster.prompt" > "$WORK/cluster.out" 2>"$WORK/cluster.err"; then
    :
  else
    : > "$WORK/cluster.fail"
  fi

  python3 - "$WORK" "$LOG" <<'PYCLUSTER'
import json, os, sys
work, log = sys.argv[1], sys.argv[2]
d = json.load(open(log))
raw = d["findings"]


def finish(distinct, method, note=None):
    d["distinct"] = distinct
    d["distinctFindings"] = len(distinct)
    d["dedup"] = method
    if note:
        d["dedupNote"] = note
    json.dump(d, open(log, "w"), indent=2)
    with open(os.path.join(work, "distinct"), "w") as fh:
        fh.write(f"{len(distinct)}\n")


if os.path.exists(os.path.join(work, "cluster.fail")):
    finish(raw, "failed", "clustering call failed; count is RAW, not deduplicated")
    sys.exit(0)
try:
    env = json.load(open(os.path.join(work, "cluster.out")))
    if env.get("is_error"):
        raise ValueError("is_error")
    text = env.get("result") or ""
    st, en = text.find("{"), text.rfind("}")
    groups = json.loads(text[st:en + 1])["groups"]
    seen = sorted(i for g in groups for i in g)
    # Reject a grouping that does not partition the input. A dropped or repeated
    # id would silently change the count, which is the number the experiment turns on.
    if seen != list(range(len(raw))):
        raise ValueError(f"not a partition: {len(seen)} ids for {len(raw)} findings")
    # Representative = highest severity in the group, so a High merged with a Low
    # is still reported as a High.
    order = {"Critical": 0, "High": 1, "Medium": 2, "Low": 3}
    distinct = []
    for g in groups:
        members = [raw[i] for i in g]
        rep = dict(sorted(members, key=lambda f: order.get(f.get("severity", "Low"), 9))[0])
        if len(members) > 1:
            rep["mergedFrom"] = [f"{m.get('lens')}:{m.get('file')}:{m.get('line')}" for m in members]
        distinct.append(rep)
    finish(distinct, "clustered")
except Exception as exc:
    finish(raw, "failed", f"clustering unusable ({exc}); count is RAW, not deduplicated")
PYCLUSTER
  read -r COUNT < "$WORK/distinct"
else
  python3 - "$LOG" <<'PYNOCLUSTER'
import json, sys
d = json.load(open(sys.argv[1]))
d["distinct"] = d["findings"]
d["distinctFindings"] = len(d["findings"])
d["dedup"] = "not-needed" if len(d["findings"]) <= 1 else "disabled"
json.dump(d, open(sys.argv[1], "w"), indent=2)
PYNOCLUSTER
  COUNT="$RAWCOUNT"
fi

if [ "$JSON_OUT" -eq 1 ]; then
  cat "$LOG"
elif [ "$QUIET" -eq 0 ]; then
  # The ✅ is gated on coverage, not just on the count, and reports the number of
  # lenses that ACTUALLY RAN rather than the number declared. Printing
  # "no findings across 3 lenses" while stderr said "3 of 3 lenses failed" was
  # the exact merge this file's collector comment forbids — and anything reading
  # the last stdout line recorded a clean review that never happened.
  if [ "$NFAILED" -gt 0 ]; then
    echo "⚠️  pr-review: $NFAILED of ${#LENSES[@]} lenses failed — COVERAGE INCOMPLETE." >&2
    # Heredoc, not `python3 -c '...'`: escaped double quotes inside an f-string
    # expression are a SyntaxError, and getting them past both the shell and the
    # f-string parser is not worth the cleverness.
    python3 - "$LOG" <<'PYFAIL' >&2
import json, sys
d = json.load(open(sys.argv[1]))
for f in d["failedLenses"]:
    print("    {}: {}".format(f["lens"], f["why"]))
    if f.get("stderr"):
        print("      " + f["stderr"].splitlines()[0][:160])
PYFAIL
  fi
  if [ "$COUNT" -eq 0 ]; then
    if [ "$NFAILED" -gt 0 ]; then
      echo "❔ pr-review: no findings from the $NRAN lens(es) that ran — $NFAILED did not. Log: $LOG"
    else
      echo "✅ pr-review: no findings across $NRAN lenses. Log: $LOG"
    fi
  else
    DEDUP=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("dedup","?"))' "$LOG")
    if [ "$DEDUP" = "failed" ]; then
      echo "🔎 pr-review: $COUNT finding(s) from $NRAN lens(es) — NOT deduplicated (clustering failed). Log: $LOG"
    else
      echo "🔎 pr-review: $COUNT distinct finding(s) from $NRAN lens(es) [$RAWCOUNT raw]. Log: $LOG"
    fi
    python3 - "$LOG" <<'PYSHOW'
import json, sys
d = json.load(open(sys.argv[1]))
order = {"Critical": 0, "High": 1, "Medium": 2, "Low": 3}
for f in sorted(d["distinct"], key=lambda x: order.get(x.get("severity", "Low"), 9)):
    print("  [{}/{}] {}:{}  {}".format(f.get("severity", "?"), f.get("lens", "?"),
                                       f.get("file", "?"), f.get("line", "?"), f.get("title", "")))
    print("      " + str(f.get("detail", "")))
PYSHOW
  fi
fi

[ "$COUNT" -gt 0 ] && exit 7
exit 0
