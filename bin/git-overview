#!/usr/bin/env bash
# git-overview — one-command repo status snapshot.
# Equivalent to the 4-command cluster agents repeat constantly.
#
# Usage: run `git-overview --help`. Deliberately NOT restated here — this header
# carried its own Usage block until #362, and it drifted (it omitted -h/--help
# and miscounted the cluster as 3). One copy, reachable from the command line.
set -euo pipefail

# #367: -h/--help/--version are terminal — they take no other arguments (full
# rationale in bin/pr-open). The scan stops at `--`.
for a in "$@"; do
  if [ "$a" = "--" ]; then break; fi
  case "$a" in
    -h|--help|--version)
      if [ "$#" -ne 1 ]; then
        echo "git-overview: $a takes no other arguments (got: $*)" >&2
        exit 2
      fi ;;
  esac
done

# #178: resolved absolute path of the running copy — install-workflow-tools
# deploys this script to ~/bin, so a bare `git-overview` from a feature
# worktree runs whatever was last installed there, not the worktree's own
# copy. `readlink -f` resolves both a real file and a symlink to its actual
# on-disk location. Not built, so no commit-hash/semver stamp — PATH only.
case "${1:-}" in
  --version) readlink -f "$0"; exit 0 ;;
  # #362: the usage text above existed only as a header comment — unreachable
  # from the command line, so --version had nowhere to be discovered either.
  -h|--help)
    cat <<'USAGE'
usage: git-overview
       git-overview -h | --help
       git-overview --version

One-command repo status snapshot. Replaces the 4-command cluster agents repeat
constantly, printing four sections in this order:

  branch    git branch --show-current   (empty line when HEAD is detached)
  status    git status --short
  diff stat git diff --stat             (UNSTAGED only — a fully staged change
                                         prints an empty section)
  commits   git log --oneline -5        (fixed at 5, not configurable)

Takes no arguments. Any argument is refused (exit 2) — leading-dash since #362,
non-dash since #367. Exits 0, 2 for an unknown flag or unexpected argument, or
128 if git itself fails (e.g. run outside a repository).

  -h, --help  this text.
  --version   resolved path of the running copy.
USAGE
    exit 0 ;;
  # #362: an unknown flag used to fall through this case and RUN the script.
  # On pr-reject that closed a real PR (#364, open for two seconds) because the
  # flag was taken as the close reason. A flag is never a branch name, a message,
  # or a reason — refuse it here, exit 2 per the #224 shared table.
  -*) echo "git-overview: unknown flag: $1 (try --help)" >&2; exit 2 ;;
  # #367: a non-dash positional fell through and printed the snapshot at exit 0.
  # Harmless here — git-overview only reads — but it is the same "argument the
  # caller typed, silently dropped" shape that let `pr-open <branch>` act on a
  # different branch, and #362's help text documented the hole rather than
  # closing it. Refuse it, so the family contract holds without an exception.
  "") ;;
  *) echo "git-overview: unexpected argument: $1 — git-overview takes none (try --help)" >&2; exit 2 ;;
esac

echo "=== branch ==="
git branch --show-current
echo ""
echo "=== status ==="
git status --short
echo ""
echo "=== diff stat ==="
git diff --stat
echo ""
echo "=== recent commits ==="
git log --oneline -5
