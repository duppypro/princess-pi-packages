#!/usr/bin/env bash
# post-merge-cleanup — hygiene after a PR is merged.
# Usage: post-merge-cleanup <branch> [worktree-path]
#   <branch>       Feature branch name (e.g. 42-verbose-flag)
#   [worktree]     Optional path to the worktree to remove
#
# Must be run from the main clone (not a worktree), with main checked out
# and up-to-date. The agent pulls main BEFORE calling this script.
set -euo pipefail

BRANCH="${1:-}"
WORKTREE="${2:-}"

if [ -z "$BRANCH" ]; then
  echo "Usage: post-merge-cleanup <branch> [worktree-path]" >&2
  echo "  Run from the main clone with main checked out and up-to-date." >&2
  exit 1
fi

echo "🧹 post-merge cleanup for branch '$BRANCH'"

# 0. Safety gate — verify the PR for this branch was merged.
#    (Squash-merge makes the branch commits non-ancestors of main, so
#    ancestor-check is unreliable. Use gh to check PR state instead.)
echo "🔍 Verifying '$BRANCH' PR was merged..."

# Find the PR for this branch (search by head branch name AND verify the
# merge commit is in origin/main — guards against reused branch names
# matching an old PR).
PR_INFO=$(gh pr list --head "$BRANCH" --state merged --json number,url,mergeCommit --jq '.[0]' 2>/dev/null || true)
if [ -n "$PR_INFO" ] && [ "$PR_INFO" != "null" ]; then
  PR_NUM=$(echo "$PR_INFO" | jq -r '.number')
  PR_MERGE_SHA=$(echo "$PR_INFO" | jq -r '.mergeCommit.oid // empty')
  if [ -n "$PR_MERGE_SHA" ] && git merge-base --is-ancestor "$PR_MERGE_SHA" origin/main 2>/dev/null; then
    echo "   ✅ PR #$PR_NUM was merged into origin/main — safe to delete."
  else
    echo "   ❌ ERROR: PR #$PR_NUM is marked merged but its merge commit is not in origin/main." >&2
    echo "   The branch name may have been reused. Verify before deleting." >&2
    exit 1
  fi
else
  # PR not found as merged — check if branch even exists on remote
  if git ls-remote --heads origin "$BRANCH" 2>/dev/null | grep -q "$BRANCH"; then
    echo "   ❌ ERROR: '$BRANCH' exists on origin but no merged PR was found." >&2
    echo "   Refusing to delete. Verify the PR was merged before cleaning up." >&2
    exit 1
  else
    echo "   ℹ️  '$BRANCH' does not exist on origin (may already be deleted). Proceeding."
  fi
fi

# 1. Remove worktree first (if specified) — branch can't be deleted while
#    checked out in a worktree.
if [ -n "$WORKTREE" ]; then
  if [ -d "$WORKTREE" ]; then
    echo "🗑  Removing worktree $WORKTREE..."
    git worktree remove "$WORKTREE" || git worktree remove --force "$WORKTREE" || {
      echo "   ❌ ERROR: worktree removal failed." >&2
      exit 1
    }
  else
    echo "   (worktree path '$WORKTREE' does not exist — skipping)"
  fi
fi

# 2. Delete remote branch.
echo "🗑  Deleting remote branch origin/$BRANCH..."
if git push origin --delete "$BRANCH"; then
  echo "   ✅ remote branch deleted."
else
  echo "   ℹ️  Remote branch may already be deleted — continuing."
fi

# 3. Delete local branch.
echo "🗑  Deleting local branch $BRANCH..."
if git branch -D "$BRANCH"; then
  echo "   ✅ local branch deleted."
else
  echo "   ℹ️  Local branch may already be deleted — continuing."
fi

echo "✅ Cleanup complete."
