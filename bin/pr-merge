#!/usr/bin/env bash
# pr-merge [<branch>] — squash-merge the PR for a feature branch.
# Defaults to the current branch. Human-only command.
#
# --- #258 → #349: gated on the SERVER before the network call ----------
# `pr-threads` has been the documented scriptable merge gate since #232, and
# nothing called it — pr-merge went straight to `gh pr merge --squash` and let
# the server's ruleset be the one to say no. #258 added a gate so the human
# finds out WHAT is blocking and WHERE, before a raw "rule violation" API
# error sends them hunting.
#
# #349 corrected WHAT that gate asks. #258 refused on pr-threads exit 1, which
# collapses "unresolved threads" and "no review covers the current head" into
# one code — and only the first is enforced by any ruleset. The result was a
# PR with a green merge button in the web UI being refused here, with a
# message blaming required_review_thread_resolution, the rule it satisfied.
#
# Now: GitHub's own mergeable/mergeStateStatus is the gate — the same
# computation behind the web UI's button — and pr-threads is the explainer.
# Unresolved threads still refuse (our policy, stated as ours). Head coverage
# warns and never blocks. `pr-open` gets neither check: opening a PR with
# unresolved threads from an earlier review is normal.
#
# Fails CLOSED (#210's governing rule) in three distinct ways, so "refused"
# is never confused with "could not tell": a server verdict we recognise as
# refusing → 6; unresolved threads → 6; mergeability still UNKNOWN after the
# retry budget, or pr-threads producing no readable document → 5, could not
# verify. An unrecognised mergeStateStatus refuses rather than guesses.
#
# --- TOCTOU between the gate and the merge (macroscopeapp finding on PR #267,
# rated High) --------------------------------------------------------------
# pr-threads approving a head sha and `gh pr merge --squash` actually merging
# one is two separate API calls with a gap between them — a push landing in
# that gap would merge a commit nobody reviewed, with the gate having said
# yes to a DIFFERENT commit. The reviewer's suggested fix was `gh pr merge
# --match-head-commit`, refusing atomically server-side if the head moved.
#
# NOT implemented that way here. Independent verification (source at
# github.com/cli/cli tag v2.50.0, and `strings` on this host's actual gh
# binary) both show `--match-head-commit` registered on `gh pr merge` — it
# was added in cli/cli#5692 (merged 2022-06-20), long before this host's gh
# 2.50.0 (2024-05-29). The premise that the flag is unavailable here does not
# hold. It was still left out of THIS fix: `gh pr merge` is human-only and
# blocked by this repo's own git-guardrails hook for every agent session
# (including this one), so the exact flag syntax/behavior could never be
# exercised against the real binary before shipping — only read from source.
# Adopting it is a good next step for a human to verify with `gh pr merge
# --help` and switch to directly; until then this closes the same race
# without depending on it:
#
# Capture the head sha immediately BEFORE the pr-threads gate runs, then
# re-resolve it again immediately BEFORE the merge call. If they differ, the
# branch moved during verification — abort (exit 6) rather than merge a
# commit the gate never actually saw. Narrows the window to "between the
# second gh pr view and gh pr merge" instead of closing it atomically, but
# needs no new gh capability and is fully covered by the existing stub-gh
# test harness.
# ---
#
# --- Exit codes (#224 table) ---
#   0  success — merged (refresh of other open PRs, #332, is best-effort and
#      NEVER changes this — see the refresh section below)
#   2  usage error — unknown flag, a second positional argument, or a
#      protected branch (main/master) named EXPLICITLY as the <branch>
#      argument (#330: automation cannot tell "you told me something invalid"
#      apart from "you told me nothing and cwd can't answer" unless the
#      script itself tracks which one happened — same fix as pr-reject's
#      BRANCH_SOURCE, #324)
#   3  precondition not met — on main/master with nothing to discover
#      otherwise: the branch was DISCOVERED from cwd, not named explicitly
#   4  not found — no open PR for this branch
#   5  remote/API failure — `gh pr list`/`gh pr view` (or pr-threads itself)
#      could not determine state, or `gh pr merge` itself failed and the merge
#      did NOT happen (#332: that case used to escape as gh's own status under
#      `set -e`, and briefly as a bare 0 — see the merge call at the bottom)
#   6  safety gate refused — pr-threads found unresolved threads, or GitHub's
#      own mergeStateStatus is one this script recognises as refusing
#      (DIRTY/DRAFT/BLOCKED) or does not recognise at all (#349; an uncovered
#      review head is NO LONGER in this list — it warns and merges);
#      PR selection was ambiguous (more than one open PR shares the branch's
#      head, refusing to guess which one to merge); or the branch's head
#      moved between the pr-threads gate and the merge call (TOCTOU guard —
#      re-run pr-merge to re-verify the new head)
# ---
#
# --- #332: post-merge refresh of every other open PR ------------------------
# The ruleset sets strict_required_status_checks_policy: true ("require
# branches to be up to date before merging"), so merging THIS PR marks every
# OTHER open PR out of date. Each then needs GitHub's "Update branch" button
# pressed — re-running CI — before IT can merge. With several PRs open (the
# normal shape of an agent session), that serializes the whole merge burst.
#
# Right after a successful merge, pr-merge now presses that button itself for
# every other open PR targeting the same base, via the same API call the
# button makes: `gh api -X PUT repos/<owner>/<repo>/pulls/<n>/update-branch`.
# Draft PRs and PRs targeting a different base are skipped. `--no-refresh`
# opts out.
#
# Best-effort — THE hard rule (req #2): this must NEVER change pr-merge's own
# exit code. The merge already happened and is irreversible; a refresh
# failure reported as a merge failure would be actively misleading. Every
# call in refresh_other_open_prs() is individually guarded (explicit status
# capture under `set +e`, restored before returning) and the function always
# returns 0. It is reached only after MERGE_STATUS has been checked and found
# zero, and the path it sits on ends in a hardcoded `exit 0`.
#
# The mirror-image rule, learned the hard way: a merge that did NOT happen
# must never exit 0 either. The first cut of this refactor wrapped the merge
# as `if gh pr merge …; then … fi` with `exit $?` after the `fi` — and an `if`
# whose condition fails with no `else` returns 0, so a failed merge reported
# success. See the merge call at the bottom for the shape that replaced it.
#
# Output is machine-readable per this repo's Agent-First Output standard: one
# `refresh <pr#> <status> [<detail>]` line per PR, flat, stable keys —
#   refresh <pr#> ok
#   refresh <pr#> skipped up-to-date      (422 "no new commits" — not a failure)
#   refresh <pr#> skipped draft
#   refresh <pr#> skipped different-base
#   refresh <pr#> failed <reason>
#   refresh - warning list-truncated-at-<n>   (the open-PR listing came back
#                                              full, so PRs beyond it were
#                                              never considered — `-` in the
#                                              pr# slot means "not about one
#                                              specific PR")
# ---
set -euo pipefail

# Flags are scanned out first (shift-driven loop, same convention as
# bin/pr-threads) so `--no-refresh` and `--help` can appear in either order
# relative to the optional branch name; a flag is never mistaken for a branch
# name or a message (#310).
# #367: -h/--help/--version are terminal — they take no other arguments (full
# rationale in bin/pr-open). The scan stops at `--`.
for a in "$@"; do
  if [ "$a" = "--" ]; then break; fi
  case "$a" in
    -h|--help|--version)
      if [ "$#" -ne 1 ]; then
        echo "pr-merge: $a takes no other arguments (got: $*)" >&2
        exit 2
      fi ;;
  esac
done

NO_REFRESH=0
BRANCH=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      cat <<'EOF'
usage: pr-merge [--no-refresh] [<branch>]
       pr-merge -h | --help
       pr-merge --version

Human-only: squash-merge the open PR for <branch> (default: current branch),
gated on pr-threads (0 unresolved conversations, head reviewed). After a
successful merge, refreshes every other open PR targeting the same base
branch (best-effort, never changes the exit code); --no-refresh disables it.

exit codes: 0 ok · 2 usage · 3 precondition · 4 not found · 5 remote · 6 refused
EOF
      exit 0 ;;
    # #178: resolved absolute path of the running copy — install-workflow-tools
    # deploys this script to ~/bin, so a bare `pr-merge` from a feature
    # worktree runs whatever was last installed there. `readlink -f` resolves
    # a real file OR a symlink to its actual on-disk location. Not built, so
    # no commit-hash/semver stamp — PATH only.
    --version) readlink -f "$0"; exit 0 ;;
    --no-refresh) NO_REFRESH=1; shift ;;
    -*) echo "pr-merge: unknown flag: $1" >&2; exit 2 ;;
    *)
      # A second positional is a typo, never a second branch — `pr-merge` acts
      # on exactly one PR. Silently shifting it past made `pr-merge feature
      # typo` merge `feature` while the user's actual intent was unknowable
      # (macroscopeapp on PR #333). Refuse rather than guess: this is a
      # human-only command whose effect is irreversible, and `pr-cleanup`
      # already takes the same hard line with `[ $# -ne 1 ]`.
      if [ -n "$BRANCH" ]; then
        echo "pr-merge: unexpected argument: $1" >&2
        echo "usage: pr-merge [--no-refresh] [<branch>]" >&2
        exit 2
      fi
      # An empty <branch> would leave BRANCH empty and fall through to the cwd
      # discovery below — merging the CURRENT branch's PR while the caller named
      # a different target. Same shape macroscopeapp found in `pr-reject -b ""`
      # on PR #370, and this command is irreversible.
      if [ -z "$1" ]; then
        echo "pr-merge: <branch> is empty — name a branch, or pass none to use the current one." >&2
        echo "usage: pr-merge [--no-refresh] [<branch>]" >&2
        exit 2
      fi
      BRANCH="$1"
      shift
      ;;
  esac
done

# The advertised `pr-merge <branch>` form used to be a lie: BRANCH was hardcoded
# to the current branch, so the argument was ignored — on main it still errored,
# and on a feature branch it merged that branch instead of the one named (#209).
# BRANCH_SOURCE tracks whether BRANCH came from the positional argument or from
# cwd, so the main/master check below can tell "you told me something invalid"
# (explicit → 2) apart from "you told me nothing and cwd can't answer" (cwd → 3)
# — #330, same shape as pr-reject's BRANCH_SOURCE (#324).
if [ -n "$BRANCH" ]; then
  BRANCH_SOURCE="explicit"
else
  BRANCH_SOURCE="cwd"
  BRANCH="$(git branch --show-current)"
fi

# --- the protected-branch predicate lives in one file (#222) ----------------
# Sourced from beside $0, the same discipline `wt-new` uses for `herdr-tab`.
# Unlike herdr-tab this FAILS CLOSED: herdr is decoration, and a guard that
# degrades is simply absent — which is the state #222 was filed about. No
# inline main/master fallback, because a fallback would restore the four copies
# pr-guard exists to delete, silently, on exactly the hosts already broken.
# `readlink -f`, not dirname+pwd: ~/bin copies may be symlinks (bun link), and a
# link's own directory need not hold pr-guard — so the plain spelling made a
# symlinked pr-* refuse with exit 3 while pr-guard sat right there beside the
# real file. Also keeps the resolution INSIDE the if-condition: a bare
# `X="$(cd ...)"` under `set -euo pipefail` dies with cd's raw status before
# reaching the message below (both found by macroscopeapp on PR #380).
# shellcheck source=bin/pr-guard
if ! PR_GUARD_LIB="$(dirname "$(readlink -f "$0")")/pr-guard" \
   || [ ! -r "$PR_GUARD_LIB" ] || ! . "$PR_GUARD_LIB"; then
  echo "pr-merge: cannot source the protected-branch guard at $PR_GUARD_LIB." >&2
  echo "   Refusing rather than proceeding without it. Run: install-workflow-tools" >&2
  exit 3
fi

if pr_is_protected "$BRANCH"; then
  if [ "$BRANCH_SOURCE" = "explicit" ]; then
    echo "pr-merge: '$BRANCH' is a protected branch — refusing to merge it via an explicit argument." >&2
    echo "  pr-merge <branch>" >&2
    exit 2
  fi
  echo "pr-merge: on main — pass a branch name or switch to a feature worktree." >&2
  echo "  pr-merge <branch>" >&2
  exit 3
fi

# --- select the PR ---------------------------------------------------------
# `gh pr list --head` matches by head branch NAME across every fork, so a fork
# with the same branch name is an equal candidate and `.[0]` could squash-merge
# a stranger's PR (#209). Constrain to head branches in OUR OWN repo, and refuse
# rather than guess when more than one survives.
if ! OWNER=$(gh repo view --json owner --jq '.owner.login'); then
  echo "pr-merge: 'gh repo view' failed — cannot determine the repo owner." >&2
  exit 5
fi
# No `2>/dev/null || true` here: it would make a network outage, expired auth or
# API error indistinguishable from "no PR found", and send the user hunting for
# a missing PR instead of showing them the actual error. Fail loudly instead.
# baseRefName rides along with the fetch (#332) so the just-merged PR's base is
# available for the post-merge refresh without a second `gh` round-trip.
if ! CANDIDATES_JSON=$(gh pr list --head "$BRANCH" --state open \
  --json number,headRepositoryOwner,baseRefName); then
  echo "pr-merge: 'gh pr list' failed — cannot determine the PR for '$BRANCH'." >&2
  exit 5
fi
CANDIDATES=$(printf '%s' "$CANDIDATES_JSON" | jq -r "[.[] | select(.headRepositoryOwner.login == \"$OWNER\") | .number] | @tsv")

# shellcheck disable=SC2206  # deliberate word-split: @tsv output, numbers only
PRS=($CANDIDATES)

if [ "${#PRS[@]}" -eq 0 ]; then
  echo "pr-merge: no open PR found for branch '$BRANCH' in $OWNER's repo." >&2
  exit 4
fi
if [ "${#PRS[@]}" -gt 1 ]; then
  echo "pr-merge: ambiguous — ${#PRS[@]} open PRs share head branch '$BRANCH':" >&2
  for p in "${PRS[@]}"; do echo "  #$p" >&2; done
  echo "  Refusing to guess. Merge the intended one via 'gh pr merge <N> --squash'." >&2
  exit 6
fi
PR="${PRS[0]}"
BASE=$(printf '%s' "$CANDIDATES_JSON" | jq -r --argjson pr "$PR" '.[] | select(.number == $pr) | .baseRefName // empty')

# resolve_head <PR> — current headRefOid for the PR, or exit 5 (state could
# not be determined; same treatment as any other gh/API failure in this
# script). Used twice: once before the gate, once immediately before the
# merge (the TOCTOU guard below).
resolve_head() {
  local pr="$1" oid
  if ! oid=$(gh pr view "$pr" --json headRefOid --jq .headRefOid 2>&1); then
    echo "pr-merge: 'gh pr view' failed — cannot determine the current head for PR #$pr:" >&2
    echo "$oid" >&2
    exit 5
  fi
  printf '%s' "$oid"
}

HEAD_BEFORE_GATE=$(resolve_head "$PR")

# --- #349: the SERVER decides; pr-threads explains -------------------------
# #258 gated on `pr-threads` exit 1 and refused. That exit collapses TWO
# conditions into one signal — unresolved threads, and "no review covers the
# current head" — so pr-merge could not tell them apart and refused for
# either. Only the first is enforced anywhere: required_review_thread_
# resolution is a real ruleset rule, while head coverage is our own #254
# invention that no server rule mentions. On duppypro/btw #53 the PR had 0
# unresolved threads, a review that predated the last push, mergeStateStatus
# CLEAN and a green merge button in the web UI — and pr-merge refused it,
# citing required_review_thread_resolution, the one rule that was satisfied.
# A wrong reason in an error message is worse than a vague one: it tells the
# caller not to attempt the thing that would have succeeded.
#
# So ask GitHub whether it will accept the merge (mergeable / mergeStateStatus
# — the same computation behind the web UI's button) and keep pr-threads as
# the EXPLAINER for why not. That is this repo's own Agent-First rule pointed
# inward: never infer a producer's state from something you can read from the
# producer. It also means this gate stops being repo-dependent — a repo that
# really does require approvals and last-push approval reports BLOCKED, and we
# refuse for the reason the server gives rather than one we guessed.
#
# Unresolved threads still refuse on OUR side, whatever the server says: a
# reviewer asked a question and nobody answered it, and that is worth refusing
# over in a repo whose ruleset happens not to require resolution. Stale head
# coverage is now a WARNING — printed, never blocking.

# --- the server's verdict --------------------------------------------------
# Mergeability is computed LAZILY: a fresh or just-pushed PR answers UNKNOWN
# until GitHub finishes. Re-query rather than read UNKNOWN as either answer;
# still UNKNOWN after the budget means state could not be determined (5) —
# never a merge, and never a "clean" claim.
RETRY_SLEEP="${PR_MERGE_RETRY_SLEEP:-2}"
MERGE_TRIES=3
MERGEABLE=UNKNOWN
MERGE_STATE=UNKNOWN
try=0
while [ "$try" -lt "$MERGE_TRIES" ]; do
  if ! STATE_JSON=$(gh pr view "$PR" --json mergeable,mergeStateStatus 2>&1); then
    echo "pr-merge: 'gh pr view' failed — cannot determine mergeability for PR #$PR:" >&2
    echo "$STATE_JSON" >&2
    exit 5
  fi
  MERGEABLE=$(printf '%s' "$STATE_JSON" | jq -r '.mergeable // "UNKNOWN"' 2>/dev/null || echo UNKNOWN)
  MERGE_STATE=$(printf '%s' "$STATE_JSON" | jq -r '.mergeStateStatus // "UNKNOWN"' 2>/dev/null || echo UNKNOWN)
  # BOTH fields, not just mergeable. They are computed separately, so a
  # response can carry mergeable=MERGEABLE while mergeStateStatus is still
  # UNKNOWN. Breaking on mergeable alone let that reach the case below, where
  # UNKNOWN matches no arm and got refused as "a state we do not recognise" —
  # turning "GitHub hasn't finished thinking" into a merge refusal.
  [ "$MERGEABLE" != "UNKNOWN" ] && [ "$MERGE_STATE" != "UNKNOWN" ] && break
  try=$((try + 1))
  if [ "$try" -lt "$MERGE_TRIES" ] && [ "$RETRY_SLEEP" != "0" ]; then
    sleep "$RETRY_SLEEP"
  fi
done

# Same asymmetry, one line later: guarding on MERGEABLE alone would let a
# persistently UNKNOWN mergeStateStatus fall through to the case below and be
# refused as unrecognised. Either field still unknown means the same thing —
# state could not be determined (5), never refused (6).
if [ "$MERGEABLE" = "UNKNOWN" ] || [ "$MERGE_STATE" = "UNKNOWN" ]; then
  echo "⚠️  pr-merge: GitHub has not finished computing mergeability for PR #$PR" >&2
  echo "   (mergeable=$MERGEABLE, mergeStateStatus=$MERGE_STATE after $MERGE_TRIES queries)." >&2
  echo "   Aborting rather than merging blind — this is 'could not determine', not" >&2
  echo "   'found a problem'. Re-run in a moment." >&2
  exit 5
fi

# --- review state, read structurally (#349) --------------------------------
# `--json` because the human-readable exit code cannot distinguish the two
# conditions. pr-threads emits its document and THEN exits, so a parseable
# document means the check ran — even on exit 5, which it also uses for
# "coverage indeterminate". No document at all is the real failure.
set +e
THREAD_JSON=$(pr-threads "$PR" --json 2>&1)
THREAD_STATUS=$?
set -e

# Two independent conditions, and BOTH must hold. `0|1|5` are pr-threads' whole
# read-path vocabulary (clean / not-clean / coverage-indeterminate); 2 and 4 are
# usage and not-found, and 127 is "no such command" — none of those describe the
# review, so a document arriving alongside one of them is not evidence about
# this PR. Checking only for a parseable document would let a `4` (wrong PR
# number, wrong repo) merge on the strength of JSON that answered a different
# question.
UNRESOLVED=""
case "$THREAD_STATUS" in
  0|1|5) UNRESOLVED=$(printf '%s' "$THREAD_JSON" | jq -r '.unresolvedCount // empty' 2>/dev/null || true) ;;
esac
if ! printf '%s' "$UNRESOLVED" | grep -Eq '^[0-9]+$'; then
  echo "⚠️  pr-merge: could not verify review state for PR #$PR — pr-threads exited" >&2
  echo "   $THREAD_STATUS with no readable document (the check itself failed, not" >&2
  echo "   'found a problem'). Aborting rather than merging blind:" >&2
  echo "$THREAD_JSON" | sed 's/^/   /' >&2
  exit 5
fi
THREAD_HEAD=$(printf '%s' "$THREAD_JSON" | jq -r '.head // ""' 2>/dev/null || true)
# headIsReviewed is a BOOLEAN — "does some review cover the current head" — not
# the sha that was reviewed; that lives in latestReviewCommit. It shipped as
# `reviewedHead`, a noun phrase between two shas, and was renamed in #372 for
# exactly the reason this comment used to have to exist: readers kept inferring
# a sha from the name and comparing it to one, which is always unequal.
HEAD_IS_REVIEWED=$(printf '%s' "$THREAD_JSON" | jq -r '.headIsReviewed' 2>/dev/null || true)
LATEST_REVIEW=$(printf '%s' "$THREAD_JSON" | jq -r '.latestReviewCommit // ""' 2>/dev/null || true)

# Version skew is the one way #372's rename can bite: a pr-threads still emitting
# `reviewedHead` gives null here, the coverage test below reads that as "no review
# covers head", and it warns on every reviewed PR — wrong, and quietly so. Test the
# FIELD, not the schema string, so a later additive @3 still passes.
if [ "$HEAD_IS_REVIEWED" != "true" ] && [ "$HEAD_IS_REVIEWED" != "false" ]; then
  THREAD_SCHEMA=$(printf '%s' "$THREAD_JSON" | jq -r '.schema // "none"' 2>/dev/null || true)
  echo "❌ pr-merge: pr-threads emitted no boolean headIsReviewed (schema: $THREAD_SCHEMA)." >&2
  echo "   The copy on PATH predates #372 and this one does not speak its shape." >&2
  echo "   Run: install-workflow-tools" >&2
  exit 5
fi

# Our own policy, not a prediction about the server: an unanswered review
# question blocks. The human-readable rendering is worth a second call HERE
# only — on the refusal path, where the thread list is what the caller needs.
if [ "$UNRESOLVED" -gt 0 ]; then
  echo "❌ pr-merge: PR #$PR has $UNRESOLVED unresolved review conversation(s)." >&2
  set +e
  THREAD_TEXT=$(pr-threads "$PR" 2>&1)
  set -e
  echo "$THREAD_TEXT" | sed 's/^/   /' >&2
  echo "   Resolve them first: pr-threads $PR --resolve <thread-id> --reply <text>" >&2
  echo "   (server verdict for this PR: mergeStateStatus=$MERGE_STATE)" >&2
  exit 6
fi

# --- what the server said, in its own words --------------------------------
# CLEAN/HAS_HOOKS/UNSTABLE are the states whose merge button is enabled in the
# web UI — UNSTABLE means non-required checks are red, which GitHub merges.
# Everything else gets refused for the reason GITHUB gave, quoted verbatim, so
# no message here asserts a rule this script never read.
case "$MERGE_STATE" in
  # BEHIND is in the ELIGIBLE list, not refused. "The head ref is out of date"
  # only blocks where the repo requires branches to be up to date; without that
  # setting GitHub merges a behind branch happily. Refusing here would be this
  # PR's own bug one state over — predicting a rule instead of reading it — and
  # these scripts run against every repo under ~/git-projects, not just the one
  # whose ruleset sets strict_required_status_checks_policy. The merge attempt
  # is cheap and non-destructive; if the server does refuse, the failure path
  # below turns its error into the actionable fix.
  CLEAN|HAS_HOOKS|UNSTABLE|BEHIND) ;;
  DIRTY)
    echo "❌ pr-merge: PR #$PR has merge conflicts with its base (mergeStateStatus=DIRTY)." >&2
    echo "   Resolve them on the branch, then re-run." >&2
    exit 6
    ;;
  DRAFT)
    echo "❌ pr-merge: PR #$PR is a draft — mark it ready for review first." >&2
    exit 6
    ;;
  BLOCKED)
    echo "❌ pr-merge: GitHub refuses this merge (mergeStateStatus=BLOCKED) — a branch" >&2
    echo "   protection rule on this repo is not satisfied. This is the server's own" >&2
    echo "   verdict, not a prediction: the web UI's merge button is disabled too." >&2
    echo "   Review state for context:" >&2
    set +e
    THREAD_TEXT=$(pr-threads "$PR" 2>&1)
    set -e
    echo "$THREAD_TEXT" | sed 's/^/   /' >&2
    exit 6
    ;;
  *)
    echo "❌ pr-merge: GitHub reports mergeStateStatus=$MERGE_STATE for PR #$PR, which this" >&2
    echo "   script does not recognise as mergeable. Refusing rather than guessing." >&2
    exit 6
    ;;
esac

if [ "$MERGEABLE" = "CONFLICTING" ]; then
  echo "❌ pr-merge: PR #$PR has merge conflicts with its base (mergeable=CONFLICTING)." >&2
  echo "   Resolve them on the branch, then re-run." >&2
  exit 6
fi

# Advisory only (#349): nothing enforces head coverage, so it never blocks —
# but it is exactly the case #254 was filed over (a bot that reviews once per
# PR never sees the commits written in response to its own findings), so it
# stays visible.
# Two conditions, and both are needed. `headIsReviewed != true` is "no review
# covers this head"; a non-null LATEST_REVIEW is "a review exists at all" — a
# PR nobody has reviewed has nothing stale about it, which is the case #254
# deliberately does not gate on.
if [ "$HEAD_IS_REVIEWED" != "true" ] && [ -n "$LATEST_REVIEW" ] && [ "$LATEST_REVIEW" != "null" ]; then
  echo "⚠️  pr-merge: no review covers head ${THREAD_HEAD:0:7} (latest review: ${LATEST_REVIEW:0:7})." >&2
  echo "   Merging anyway — no rule on this repo requires it (mergeStateStatus=$MERGE_STATE)." >&2
fi

# --- TOCTOU guard (see header): re-resolve the head immediately before the
# merge call. pr-threads approved HEAD_BEFORE_GATE — if a push landed in the
# gap between that check and here, the sha about to be merged is one the gate
# never actually saw. Abort rather than merge it; re-running pr-merge
# re-verifies whatever landed.
HEAD_BEFORE_MERGE=$(resolve_head "$PR")
if [ "$HEAD_BEFORE_MERGE" != "$HEAD_BEFORE_GATE" ]; then
  echo "❌ pr-merge: PR #$PR's branch moved during verification — refusing to merge." >&2
  echo "   pr-threads approved head ${HEAD_BEFORE_GATE:0:7}, but the branch is now at" >&2
  echo "   ${HEAD_BEFORE_MERGE:0:7}. Re-run pr-merge to verify the new head." >&2
  exit 6
fi

# refresh_other_open_prs <merged-pr#> <base> — #332, best-effort only.
# Presses GitHub's "Update branch" (gh api -X PUT .../update-branch) for every
# OTHER open PR targeting the same base, so its CI is already running by the
# time a human reaches it. Every gh/jq call here is individually guarded
# under `set +e`: this function must never `exit`, and its own return status
# is never inspected by its caller — nothing it does may affect pr-merge's
# exit code (the hard rule, req #2). Output is one `refresh <pr#> ...` line
# per PR — see the header comment for the full format.
refresh_other_open_prs() {
  local merged_pr="$1" base="$2"
  set +e

  if [ -z "$base" ]; then
    echo "refresh - failed could-not-determine-base"
    set -e
    return 0
  fi

  local repo_full
  repo_full=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)
  if [ -z "$repo_full" ]; then
    echo "refresh - failed could-not-determine-repo"
    set -e
    return 0
  fi

  # `gh pr list` defaults to 30 results, so PRs past the 30th were never
  # refreshed and stayed stale with nothing said about it (macroscopeapp on
  # PR #333). A cap that nobody is told about is the failure mode this repo's
  # Agent-First standard calls out by name — "no silent caps: if a workflow
  # bounds coverage, log what was dropped" — so raise the limit AND report
  # when the listing came back full, since at that point the set may be
  # incomplete and this run cannot know which PRs it never saw.
  local REFRESH_LIST_LIMIT=200
  local others_json
  others_json=$(gh pr list --state open --limit "$REFRESH_LIST_LIMIT" --json number,baseRefName,isDraft 2>/dev/null)
  if [ -z "$others_json" ]; then
    echo "refresh - failed could-not-list-open-prs"
    set -e
    return 0
  fi

  local listed
  listed=$(printf '%s' "$others_json" | jq 'length' 2>/dev/null) || listed=0
  if [ "${listed:-0}" -ge "$REFRESH_LIST_LIMIT" ]; then
    echo "refresh - warning list-truncated-at-$REFRESH_LIST_LIMIT"
  fi

  local nums n
  nums=$(printf '%s' "$others_json" | jq -r --argjson pr "$merged_pr" '.[] | select(.number != $pr) | .number')
  for n in $nums; do
    local is_draft pr_base
    is_draft=$(printf '%s' "$others_json" | jq -r --argjson n "$n" '.[] | select(.number == $n) | .isDraft')
    pr_base=$(printf '%s' "$others_json" | jq -r --argjson n "$n" '.[] | select(.number == $n) | .baseRefName')

    if [ "$is_draft" = "true" ]; then
      echo "refresh $n skipped draft"
      continue
    fi
    if [ "$pr_base" != "$base" ]; then
      echo "refresh $n skipped different-base"
      continue
    fi

    local api_out api_status
    api_out=$(gh api -X PUT "repos/$repo_full/pulls/$n/update-branch" \
      -H "Accept: application/vnd.github+json" 2>&1)
    api_status=$?
    if [ "$api_status" -eq 0 ]; then
      echo "refresh $n ok"
    elif printf '%s' "$api_out" | grep -qi "no new commits"; then
      echo "refresh $n skipped up-to-date"
    else
      echo "refresh $n failed ${api_out//$'\n'/ }"
    fi
  done

  set -e
  return 0
}

echo "🔀 Squash-merging PR #$PR (branch: $BRANCH)..."
# Capture the merge status explicitly instead of `if gh pr merge …; then … fi`
# followed by `exit $?`. An `if` whose condition FAILS and which has no `else`
# returns **0**, so that shape reported a failed merge as success — verified:
# `if bash -c "exit 7"; then exit 0; fi; exit $?` exits 0. Before #332 this
# was the script's last line under `set -e`, so a failure aborted with gh's own
# status; the refresh refactor is what put a compound command in between.
# Whatever else changes here, a merge that did not happen must never exit 0.
set +e
gh pr merge "$PR" --squash
MERGE_STATUS=$?
set -e
if [ "$MERGE_STATUS" -ne 0 ]; then
  echo "   ❌ ERROR: 'gh pr merge' failed for PR #$PR (gh exit $MERGE_STATUS) — the merge did NOT happen." >&2
  # The one state where gh's own error is famously unhelpful and the remedy is
  # exact. We no longer refuse BEHIND up front (the server decides), so this is
  # where that guidance has to live — after a real refusal, not instead of one.
  if [ "$MERGE_STATE" = "BEHIND" ]; then
    echo "   PR #$PR was BEHIND its base and this repo requires branches to be up to date." >&2
    echo "   Fix: gh pr update-branch $PR   (or merge from the web UI, which offers it)" >&2
  fi
  echo "   No other PR was refreshed: refresh runs only after a merge succeeds." >&2
  exit 5
fi

if [ "$NO_REFRESH" -eq 0 ]; then
  refresh_other_open_prs "$PR" "$BASE"
fi
exit 0
