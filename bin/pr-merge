#!/usr/bin/env bash
# pr-merge [<branch>] — squash-merge the PR for a feature branch.
# Defaults to the current branch. Human-only command.
#
# --- #258: gated on pr-threads before the network call -----------------
# `pr-threads` has been the documented scriptable merge gate since #232, and
# nothing called it — pr-merge went straight to `gh pr merge --squash` and let
# the server's required_review_thread_resolution ruleset be the one to say no.
# The server is still the enforcement (current_user_can_bypass: never); this
# gate exists so the human finds out WHAT is blocking and WHERE the unresolved
# threads are, before a raw "rule violation" API error sends them hunting.
#
# No override flag: the server refuses regardless, so a flag here would only
# buy a slower failure. `pr-open` does not get this check — opening a PR with
# unresolved threads from an earlier review is normal.
#
# Fails CLOSED (#210's governing rule, applied via pr-threads' own exit
# contract — see bin/pr-threads header): pr-threads exit 1 means "checked, and
# it says no" — print the details and refuse to merge. Any OTHER non-zero exit
# (2/4/5 — usage error, PR not found, gh/API failure) means the check itself
# could not run, and pr-merge aborts just as hard, but says so differently: it
# could not verify, not that it found a problem.
#
# --- TOCTOU between the gate and the merge (macroscopeapp finding on PR #267,
# rated High) --------------------------------------------------------------
# pr-threads approving a head sha and `gh pr merge --squash` actually merging
# one is two separate API calls with a gap between them — a push landing in
# that gap would merge a commit nobody reviewed, with the gate having said
# yes to a DIFFERENT commit. The reviewer's suggested fix was `gh pr merge
# --match-head-commit`, refusing atomically server-side if the head moved.
#
# NOT implemented that way here. Independent verification (source at
# github.com/cli/cli tag v2.50.0, and `strings` on this host's actual gh
# binary) both show `--match-head-commit` registered on `gh pr merge` — it
# was added in cli/cli#5692 (merged 2022-06-20), long before this host's gh
# 2.50.0 (2024-05-29). The premise that the flag is unavailable here does not
# hold. It was still left out of THIS fix: `gh pr merge` is human-only and
# blocked by this repo's own git-guardrails hook for every agent session
# (including this one), so the exact flag syntax/behavior could never be
# exercised against the real binary before shipping — only read from source.
# Adopting it is a good next step for a human to verify with `gh pr merge
# --help` and switch to directly; until then this closes the same race
# without depending on it:
#
# Capture the head sha immediately BEFORE the pr-threads gate runs, then
# re-resolve it again immediately BEFORE the merge call. If they differ, the
# branch moved during verification — abort (exit 6) rather than merge a
# commit the gate never actually saw. Narrows the window to "between the
# second gh pr view and gh pr merge" instead of closing it atomically, but
# needs no new gh capability and is fully covered by the existing stub-gh
# test harness.
# ---
#
# --- Exit codes (#224 table) ---
#   0  success — merged (refresh of other open PRs, #332, is best-effort and
#      NEVER changes this — see the refresh section below)
#   2  usage error (unknown flag)
#   3  precondition not met — on main/master
#   4  not found — no open PR for this branch
#   5  remote/API failure — `gh pr list`/`gh pr view` (or pr-threads itself)
#      could not determine state, or `gh pr merge` itself failed and the merge
#      did NOT happen (#332: that case used to escape as gh's own status under
#      `set -e`, and briefly as a bare 0 — see the merge call at the bottom)
#   6  safety gate refused — pr-threads found unresolved threads and/or an
#      uncovered review head (the merge is refused before the network call);
#      PR selection was ambiguous (more than one open PR shares the branch's
#      head, refusing to guess which one to merge); or the branch's head
#      moved between the pr-threads gate and the merge call (TOCTOU guard —
#      re-run pr-merge to re-verify the new head)
# ---
#
# --- #332: post-merge refresh of every other open PR ------------------------
# The ruleset sets strict_required_status_checks_policy: true ("require
# branches to be up to date before merging"), so merging THIS PR marks every
# OTHER open PR out of date. Each then needs GitHub's "Update branch" button
# pressed — re-running CI — before IT can merge. With several PRs open (the
# normal shape of an agent session), that serializes the whole merge burst.
#
# Right after a successful merge, pr-merge now presses that button itself for
# every other open PR targeting the same base, via the same API call the
# button makes: `gh api -X PUT repos/<owner>/<repo>/pulls/<n>/update-branch`.
# Draft PRs and PRs targeting a different base are skipped. `--no-refresh`
# opts out.
#
# Best-effort — THE hard rule (req #2): this must NEVER change pr-merge's own
# exit code. The merge already happened and is irreversible; a refresh
# failure reported as a merge failure would be actively misleading. Every
# call in refresh_other_open_prs() is individually guarded (explicit status
# capture under `set +e`, restored before returning) and the function always
# returns 0. It is reached only after MERGE_STATUS has been checked and found
# zero, and the path it sits on ends in a hardcoded `exit 0`.
#
# The mirror-image rule, learned the hard way: a merge that did NOT happen
# must never exit 0 either. The first cut of this refactor wrapped the merge
# as `if gh pr merge …; then … fi` with `exit $?` after the `fi` — and an `if`
# whose condition fails with no `else` returns 0, so a failed merge reported
# success. See the merge call at the bottom for the shape that replaced it.
#
# Output is machine-readable per this repo's Agent-First Output standard: one
# `refresh <pr#> <status> [<detail>]` line per PR, flat, stable keys —
#   refresh <pr#> ok
#   refresh <pr#> skipped up-to-date      (422 "no new commits" — not a failure)
#   refresh <pr#> skipped draft
#   refresh <pr#> skipped different-base
#   refresh <pr#> failed <reason>
# ---
set -euo pipefail

# Flags are scanned out first (shift-driven loop, same convention as
# bin/pr-threads) so `--no-refresh` and `--help` can appear in either order
# relative to the optional branch name; a flag is never mistaken for a branch
# name or a message (#310).
NO_REFRESH=0
BRANCH=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      cat <<'EOF'
usage: pr-merge [--no-refresh] [<branch>]

Human-only: squash-merge the open PR for <branch> (default: current branch),
gated on pr-threads (0 unresolved conversations, head reviewed). After a
successful merge, refreshes every other open PR targeting the same base
branch (best-effort, never changes the exit code); --no-refresh disables it.

exit codes: 0 ok · 2 usage · 3 precondition · 4 not found · 5 remote · 6 refused
EOF
      exit 0 ;;
    --no-refresh) NO_REFRESH=1; shift ;;
    -*) echo "pr-merge: unknown flag: $1" >&2; exit 2 ;;
    *)
      if [ -z "$BRANCH" ]; then BRANCH="$1"; fi
      shift
      ;;
  esac
done

# The advertised `pr-merge <branch>` form used to be a lie: BRANCH was hardcoded
# to the current branch, so the argument was ignored — on main it still errored,
# and on a feature branch it merged that branch instead of the one named (#209).
BRANCH="${BRANCH:-$(git branch --show-current)}"

if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  echo "pr-merge: on main — pass a branch name or switch to a feature worktree." >&2
  echo "  pr-merge <branch>" >&2
  exit 3
fi

# --- select the PR ---------------------------------------------------------
# `gh pr list --head` matches by head branch NAME across every fork, so a fork
# with the same branch name is an equal candidate and `.[0]` could squash-merge
# a stranger's PR (#209). Constrain to head branches in OUR OWN repo, and refuse
# rather than guess when more than one survives.
if ! OWNER=$(gh repo view --json owner --jq '.owner.login'); then
  echo "pr-merge: 'gh repo view' failed — cannot determine the repo owner." >&2
  exit 5
fi
# No `2>/dev/null || true` here: it would make a network outage, expired auth or
# API error indistinguishable from "no PR found", and send the user hunting for
# a missing PR instead of showing them the actual error. Fail loudly instead.
# baseRefName rides along with the fetch (#332) so the just-merged PR's base is
# available for the post-merge refresh without a second `gh` round-trip.
if ! CANDIDATES_JSON=$(gh pr list --head "$BRANCH" --state open \
  --json number,headRepositoryOwner,baseRefName); then
  echo "pr-merge: 'gh pr list' failed — cannot determine the PR for '$BRANCH'." >&2
  exit 5
fi
CANDIDATES=$(printf '%s' "$CANDIDATES_JSON" | jq -r "[.[] | select(.headRepositoryOwner.login == \"$OWNER\") | .number] | @tsv")

# shellcheck disable=SC2206  # deliberate word-split: @tsv output, numbers only
PRS=($CANDIDATES)

if [ "${#PRS[@]}" -eq 0 ]; then
  echo "pr-merge: no open PR found for branch '$BRANCH' in $OWNER's repo." >&2
  exit 4
fi
if [ "${#PRS[@]}" -gt 1 ]; then
  echo "pr-merge: ambiguous — ${#PRS[@]} open PRs share head branch '$BRANCH':" >&2
  for p in "${PRS[@]}"; do echo "  #$p" >&2; done
  echo "  Refusing to guess. Merge the intended one via 'gh pr merge <N> --squash'." >&2
  exit 6
fi
PR="${PRS[0]}"
BASE=$(printf '%s' "$CANDIDATES_JSON" | jq -r --argjson pr "$PR" '.[] | select(.number == $pr) | .baseRefName // empty')

# resolve_head <PR> — current headRefOid for the PR, or exit 5 (state could
# not be determined; same treatment as any other gh/API failure in this
# script). Used twice: once before the gate, once immediately before the
# merge (the TOCTOU guard below).
resolve_head() {
  local pr="$1" oid
  if ! oid=$(gh pr view "$pr" --json headRefOid --jq .headRefOid 2>&1); then
    echo "pr-merge: 'gh pr view' failed — cannot determine the current head for PR #$pr:" >&2
    echo "$oid" >&2
    exit 5
  fi
  printf '%s' "$oid"
}

HEAD_BEFORE_GATE=$(resolve_head "$PR")

# --- #258: pr-threads gate, reusing the PR number resolved above -----------
# pr-threads' exit codes are documented in its own header: 0 = clean, 1 =
# checked-and-found-a-problem (unresolved threads and/or an uncovered review
# head), anything else = the check itself could not run. Only 1 gets the
# "here is what to fix" framing; everything else gets "could not verify".
set +e
THREAD_OUTPUT=$(pr-threads "$PR" 2>&1)
THREAD_STATUS=$?
set -e

if [ "$THREAD_STATUS" -eq 1 ]; then
  echo "❌ pr-merge: PR #$PR is not clear to merge — pr-threads found unresolved" >&2
  echo "   threads and/or a review that doesn't cover the current head:" >&2
  echo "$THREAD_OUTPUT" | sed 's/^/   /' >&2
  echo "   The server ruleset (required_review_thread_resolution) will refuse this" >&2
  echo "   merge too — there is no override flag here." >&2
  exit 6
elif [ "$THREAD_STATUS" -ne 0 ]; then
  echo "⚠️  pr-merge: could not verify review state for PR #$PR — pr-threads exited" >&2
  echo "   $THREAD_STATUS (not 'found a problem', the check itself failed). Aborting" >&2
  echo "   rather than merging blind:" >&2
  echo "$THREAD_OUTPUT" | sed 's/^/   /' >&2
  exit 5
fi

# --- TOCTOU guard (see header): re-resolve the head immediately before the
# merge call. pr-threads approved HEAD_BEFORE_GATE — if a push landed in the
# gap between that check and here, the sha about to be merged is one the gate
# never actually saw. Abort rather than merge it; re-running pr-merge
# re-verifies whatever landed.
HEAD_BEFORE_MERGE=$(resolve_head "$PR")
if [ "$HEAD_BEFORE_MERGE" != "$HEAD_BEFORE_GATE" ]; then
  echo "❌ pr-merge: PR #$PR's branch moved during verification — refusing to merge." >&2
  echo "   pr-threads approved head ${HEAD_BEFORE_GATE:0:7}, but the branch is now at" >&2
  echo "   ${HEAD_BEFORE_MERGE:0:7}. Re-run pr-merge to verify the new head." >&2
  exit 6
fi

# refresh_other_open_prs <merged-pr#> <base> — #332, best-effort only.
# Presses GitHub's "Update branch" (gh api -X PUT .../update-branch) for every
# OTHER open PR targeting the same base, so its CI is already running by the
# time a human reaches it. Every gh/jq call here is individually guarded
# under `set +e`: this function must never `exit`, and its own return status
# is never inspected by its caller — nothing it does may affect pr-merge's
# exit code (the hard rule, req #2). Output is one `refresh <pr#> ...` line
# per PR — see the header comment for the full format.
refresh_other_open_prs() {
  local merged_pr="$1" base="$2"
  set +e

  if [ -z "$base" ]; then
    echo "refresh - failed could-not-determine-base"
    set -e
    return 0
  fi

  local repo_full
  repo_full=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)
  if [ -z "$repo_full" ]; then
    echo "refresh - failed could-not-determine-repo"
    set -e
    return 0
  fi

  local others_json
  others_json=$(gh pr list --state open --json number,baseRefName,isDraft 2>/dev/null)
  if [ -z "$others_json" ]; then
    echo "refresh - failed could-not-list-open-prs"
    set -e
    return 0
  fi

  local nums n
  nums=$(printf '%s' "$others_json" | jq -r --argjson pr "$merged_pr" '.[] | select(.number != $pr) | .number')
  for n in $nums; do
    local is_draft pr_base
    is_draft=$(printf '%s' "$others_json" | jq -r --argjson n "$n" '.[] | select(.number == $n) | .isDraft')
    pr_base=$(printf '%s' "$others_json" | jq -r --argjson n "$n" '.[] | select(.number == $n) | .baseRefName')

    if [ "$is_draft" = "true" ]; then
      echo "refresh $n skipped draft"
      continue
    fi
    if [ "$pr_base" != "$base" ]; then
      echo "refresh $n skipped different-base"
      continue
    fi

    local api_out api_status
    api_out=$(gh api -X PUT "repos/$repo_full/pulls/$n/update-branch" \
      -H "Accept: application/vnd.github+json" 2>&1)
    api_status=$?
    if [ "$api_status" -eq 0 ]; then
      echo "refresh $n ok"
    elif printf '%s' "$api_out" | grep -qi "no new commits"; then
      echo "refresh $n skipped up-to-date"
    else
      echo "refresh $n failed ${api_out//$'\n'/ }"
    fi
  done

  set -e
  return 0
}

echo "🔀 Squash-merging PR #$PR (branch: $BRANCH)..."
# Capture the merge status explicitly instead of `if gh pr merge …; then … fi`
# followed by `exit $?`. An `if` whose condition FAILS and which has no `else`
# returns **0**, so that shape reported a failed merge as success — verified:
# `if bash -c "exit 7"; then exit 0; fi; exit $?` exits 0. Before #332 this
# was the script's last line under `set -e`, so a failure aborted with gh's own
# status; the refresh refactor is what put a compound command in between.
# Whatever else changes here, a merge that did not happen must never exit 0.
set +e
gh pr merge "$PR" --squash
MERGE_STATUS=$?
set -e
if [ "$MERGE_STATUS" -ne 0 ]; then
  echo "   ❌ ERROR: 'gh pr merge' failed for PR #$PR (gh exit $MERGE_STATUS) — the merge did NOT happen." >&2
  echo "   No other PR was refreshed: refresh runs only after a merge succeeds." >&2
  exit 5
fi

if [ "$NO_REFRESH" -eq 0 ]; then
  refresh_other_open_prs "$PR" "$BASE"
fi
exit 0
