#!/usr/bin/env bash
# ---
# pr-open — create a PR for the current feature branch.
# Auto-discovers branch from cwd. Ensures pushed, checks pre-conditions,
# then runs "gh pr create".
#
# Push decision (step 3, #223): compares RESOLVED SHAS, not containment.
# `git merge-base --is-ancestor HEAD "origin/$BRANCH"` used to decide "already
# pushed", but that predicate tests CONTAINMENT — it is also true when local
# HEAD is BEHIND origin (local's tip is an ancestor of the remote's, since the
# remote just has more commits on top). A branch behind origin then skipped
# the push and opened a PR whose head ref carried another session's commits
# under this session's PR description. Fixed to `git rev-parse` both sides and
# push whenever they differ — including when `origin/$BRANCH` doesn't resolve
# at all (a first push) — and skip ONLY on exact sha equality.
#
# Diverged branches (remote ref exists and is not an ancestor of HEAD — a
# behind, amended, or rebased branch) are refused BEFORE the push is attempted,
# with pr-open's own message naming `--force-with-lease`, rather than left to
# `set -euo pipefail` killing the script on git's raw non-fast-forward
# rejection. The spec endorses force-pushing a feature branch as normal
# (docs/dev-workflow-spec.md § "Tests reveal a design flaw"), so pr-open must
# hand the user the exact command, not a crash.
#
# Step 2's `git fetch origin` carries `--prune`: without it, a stale
# `origin/<branch>` left behind by a prior `pr-cleanup` keeps reading as a live
# remote branch at its last-known sha, and the push decision above is made
# against a ref that no longer exists upstream.
#
# Step 2 checks `origin` exists (`git remote get-url origin`, purely local, no
# network) BEFORE fetching. A missing remote and an unreachable one both make
# `git fetch` fail the same way, but they are not the same fact: a missing
# `origin` is determinate local git config (#224 code 4), not undeterminable
# remote state (code 5). Matches bin/wt-new's identical check (#250).
#
# The divergence pre-check at step 3 (`git merge-base --is-ancestor
# "$REMOTE_SHA" "$LOCAL_SHA"`) captures the command's exit status rather than
# trusting a bare `!`: exit 1 is a real, checked "not an ancestor" (code 6),
# but exit 128 means the check itself could not run (a bad/absent commit
# object) and must not be read as a confirmed divergence (code 5). Matches
# bin/pr-cleanup's identical idiom for its own merge-base gates.
#
# Exit codes (#224 contract, shared table: docs/dev-workflow-spec.md):
#   0  success
#   2  usage error — an unknown flag (#362), or not run inside a git repository
#   3  precondition not met — on a protected branch (main/master), detached
#      HEAD with no branch to open a PR from, or the worktree isn't clean
#   4  not found — no `origin` remote configured
#   5  remote/API failure — state could not be determined (fetch failed, a
#      merge-base divergence check that could not even run — exit 128, a
#      bad/absent object — `gh pr create` itself failed, or the push failed
#      for a reason other than the remote rejecting it — network/auth/DNS,
#      git exit != 1)
#   6  safety gate refused (diverged branch — a merge-base check that DID run
#      and found HEAD does not build on origin/$BRANCH — declined to auto
#      force-push — OR the push itself was rejected by the remote, git exit 1)
#   7  pr-review found issues — the PR was NOT created (#377). Fix them and
#      re-run, or accept them with `pr-open --reviewed`. Distinct from 6: 6 is a
#      git-state refusal that a force-push resolves, 7 is a review refusal that
#      only a code change or an explicit override resolves.
#   8  pr-review could not review this branch — zero lenses ran (#401): the
#      reviewer was available but every lens failed or timed out, so "found
#      nothing" and "looked at nothing" are different facts and the PR was NOT
#      created. Same escape hatch as 7 (`pr-open --reviewed`, which skips
#      pr-review entirely and so never even reaches this check). Distinct from
#      7 the same way 5 is distinct from 6: 7 means the review ran and found a
#      problem, 8 means the review never actually ran.
# 5 vs 6 is the load-bearing distinction: "I could not check" (5) vs "I
# checked and it says no" (6). pr-open never leaks git's raw exit status —
# every push failure is mapped to one of these two.
# ---
set -euo pipefail

# #367: -h/--help/--version are TERMINAL — they take no other arguments. Every
# script in this family short-circuits on the first flag it recognises, so
# `pr-cleanup --version extra-arg` printed the path and exited 0, silently
# ignoring the extra word while pr-cleanup's own header called extra arguments a
# usage error. Same silent-drop shape as an ignored positional. Duplicated per
# script by necessity, not by preference: install-workflow-tools copies each of
# these to ~/bin as a standalone file, so there is no shared library to source.
# The scan stops at `--`, so a value that legitimately reads `--version` stays
# reachable.
for a in "$@"; do
  if [ "$a" = "--" ]; then break; fi
  case "$a" in
    -h|--help|--version)
      if [ "$#" -ne 1 ]; then
        echo "pr-open: $a takes no other arguments (got: $*)" >&2
        exit 2
      fi ;;
  esac
done

# -h/--help prints usage and exits 0 (#310) — a flag is never a branch name or a
# message, and "pr-open --help" used to be treated as one.
SKIP_REVIEW=0
if [ "${1:-}" = "--reviewed" ]; then SKIP_REVIEW=1; shift; fi
case "${1:-}" in
  -h|--help)
    cat <<'EOF'
usage: pr-open
       pr-open --reviewed
       pr-open -h | --help
       pr-open --version

Create the PR for the CURRENT feature branch (from its worktree): pushes,
then `gh pr create` with the branch's commits as the body.

Runs 'pr-review' first and REFUSES to open the PR if it finds anything (#377).
--reviewed skips that gate and opens the PR anyway.

Takes no other arguments: a branch name or anything else is REFUSED (exit 2),
not ignored (#367). To open another branch's PR, run this from its worktree.

exit codes: 0 ok · 2 usage · 3 precondition · 4 not found · 5 remote · 6 refused
            7 review found issues, PR not created
            8 review could not run (zero lenses), PR not created (#401)
EOF
    exit 0 ;;
  # #178: resolved absolute path of the running copy — install-workflow-tools
  # deploys this script to ~/bin, so a bare `pr-open` from a feature worktree
  # runs whatever was last installed there. `readlink -f` resolves a real
  # file OR a symlink to its actual on-disk location. Not built, so no
  # commit-hash/semver stamp — PATH only.
  --version) readlink -f "$0"; exit 0 ;;
  # #362: an unknown flag used to fall through this case and RUN the script.
  # On pr-reject that closed a real PR (#364, open for two seconds) because the
  # flag was taken as the close reason. A flag is never a branch name, a message,
  # or a reason — refuse it here, exit 2 per the #224 shared table.
  -*) echo "pr-open: unknown flag: $1 (try --help)" >&2; exit 2 ;;
esac

# #367: a NON-dash argument used to fall through this case too, and pr-open then
# discovered the branch from cwd — so `pr-open some-other-branch` opened the PR
# for the CURRENT branch while the caller had named a different one. That is the
# #209 shape (acting on a target the caller did not name), and it is exactly what
# bin/pr-reject's `-b` flag exists to prevent. pr-open takes no arguments other
# than `--reviewed` (#377), which is consumed before this check:
# the branch IS the worktree it runs in, so there is no argument to accept.
if [ "$#" -gt 0 ]; then
  echo "pr-open: unexpected argument: $1 — pr-open takes no arguments other than --reviewed." >&2
  echo "  It opens the PR for the branch checked out in the current worktree." >&2
  echo "  To open another branch's PR, run pr-open from that branch's worktree." >&2
  exit 2
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "pr-open: not inside a git repository." >&2
  exit 2
fi

# --- the protected-branch predicate lives in one file (#222) ----------------
# Sourced from beside $0, the same discipline `wt-new` uses for `herdr-tab`.
# Unlike herdr-tab this FAILS CLOSED: herdr is decoration, and a guard that
# degrades is simply absent — which is the state #222 was filed about. No
# inline main/master fallback, because a fallback would restore the four copies
# pr-guard exists to delete, silently, on exactly the hosts already broken.
# `readlink -f`, not dirname+pwd: ~/bin copies may be symlinks (bun link), and a
# link's own directory need not hold pr-guard — the plain spelling made a
# symlinked pr-* refuse while pr-guard sat beside the real file.
#
# The path is then REQUIRED TO BE ABSOLUTE, and that check is not defensive
# padding — it closes a code-execution hole (macroscopeapp on PR #380, rated
# Critical). `readlink -f` is not portable: it fails on older macOS. Nested as
# `dirname "$(readlink -f "$0")"` that failure is laundered into success, because
# `dirname ""` prints `.` and exits 0 — so PR_GUARD_LIB became `./pr-guard`, the
# `if !` never fired, and the script SOURCED a file from the caller's current
# directory. In a checkout whose contents are not ours, that is arbitrary code
# execution from a tool whose entire job is refusing unsafe operations.
#
# Requiring a leading `/` makes the laundering impossible: `.` never matches, so
# resolution failure lands in the fail-closed block below instead of picking up a
# stranger's file. On a host where `readlink -f` does not work, these scripts
# refuse and say so rather than running with no guard.
PR_GUARD_SELF="$(readlink -f "$0" 2>/dev/null || true)"
case "${PR_GUARD_SELF:-}" in
  /*) PR_GUARD_LIB="${PR_GUARD_SELF%/*}/pr-guard" ;;
  *)  PR_GUARD_LIB="" ;;
esac
# shellcheck source=bin/pr-guard
if [ -z "$PR_GUARD_LIB" ] || [ ! -r "$PR_GUARD_LIB" ] || ! . "$PR_GUARD_LIB"; then
  echo "pr-open: cannot source the protected-branch guard at $PR_GUARD_LIB." >&2
  echo "   Refusing rather than proceeding without it. Run: install-workflow-tools" >&2
  exit 3
fi

BRANCH=$(git branch --show-current)
if pr_is_protected "$BRANCH"; then
  echo "pr-open: cannot create a PR from '$BRANCH'. Switch to a feature branch." >&2
  exit 3
fi
# `git branch --show-current` is empty on detached HEAD — the check above
# passes right through it (empty != "main"), and BRANCH="" then reaches
# `git push origin ""` at exit 128, git's raw rejection. Matches
# bin/pr-cleanup's own detached-HEAD handling (#264/E-4).
if [ -z "$BRANCH" ]; then
  echo "pr-open: cwd is not on any branch (detached HEAD) — nothing to open a PR from." >&2
  exit 3
fi

# 1. Worktree must be clean
if [ -n "$(git status --porcelain)" ]; then
  echo "pr-open: worktree not clean — commit or stash changes first." >&2
  git status --short
  exit 3
fi

# 2. Fetch to get latest remote state. `origin` must exist first — a missing
# remote is a determinate fact about local git config (#224 code 4, "not
# found"), not an undeterminable remote failure (code 5). `git fetch` itself
# fails the same way (128) whether `origin` is absent or merely unreachable
# (bad host, DNS, auth), so the two cases are told apart with a purely local,
# no-network check BEFORE the fetch is attempted — matching bin/wt-new, which
# has carried this same check since #250.
# --prune: see header — a deleted upstream branch must stop reading as a live one.
if ! git remote get-url origin >/dev/null 2>&1; then
  echo "pr-open: no 'origin' remote configured." >&2
  exit 4
fi

echo "📡 Fetching origin..."
if ! git fetch origin --prune; then
  echo "pr-open: could not fetch origin — remote state undetermined." >&2
  exit 5
fi

# 3. Ensure branch is pushed. Equality on resolved shas, not containment
# (#223) — see header. REMOTE_SHA is legitimately empty on a first push.
LOCAL_SHA=$(git rev-parse HEAD)
# --verify -q: a bare `git rev-parse origin/$BRANCH` on a ref that does not
# exist still exits non-zero but ALSO echoes the literal arg to stdout — so a
# plain `2>/dev/null || echo ""` captured "origin/$BRANCH" as the sha on a
# first push instead of empty. `--verify -q` fails silent on both streams.
REMOTE_SHA=$(git rev-parse --verify -q "origin/$BRANCH" 2>/dev/null || echo "")

if [ "$LOCAL_SHA" != "$REMOTE_SHA" ]; then
  if [ -n "$REMOTE_SHA" ]; then
    # `merge-base --is-ancestor` exits 1 for "not an ancestor" (a real, checked
    # "no") but 128 for a bad/absent object (could not even run the check).
    # Collapsing both into exit 6 asserted the negative on a check that never
    # happened. Capture the status explicitly rather than trusting `!` alone —
    # 128 maps to 5 ("could not check"), 1 stays 6 ("checked, and it says no").
    # Matches bin/pr-cleanup's identical idiom for its own merge-base gates.
    mb_status=0
    git merge-base --is-ancestor "$REMOTE_SHA" "$LOCAL_SHA" 2>/dev/null || mb_status=$?
    if [ "$mb_status" -eq 128 ]; then
      echo "pr-open: could not check whether '$BRANCH' has diverged from origin/$BRANCH (merge-base failed)." >&2
      exit 5
    fi
    if [ "$mb_status" -ne 0 ]; then
      # origin/$BRANCH exists and HEAD does not build on it — a plain push
      # would be a non-fast-forward. Refuse with pr-open's own message instead
      # of letting `set -e` surface git's raw rejection mid-flow.
      echo "pr-open: '$BRANCH' has diverged from origin/$BRANCH — local and remote" >&2
      echo "  history do not agree (rebase, amend, or another session pushed here)." >&2
      echo "  Re-run after: git push --force-with-lease origin $BRANCH" >&2
      exit 6
    fi
  fi
  echo "📡 Pushing $BRANCH to origin..."
  # Captured, not left to `set -e`: git push exits 1 when the remote REJECTS
  # (non-fast-forward, protected branch, a server-side hook declining) — a
  # determined "no" (#224 code 6). Anything else (128 on an unreachable host,
  # auth failure, DNS) is undetermined (#224 code 5). This is git's own
  # convention (verified empirically, not documented as a promise upstream),
  # not this script's guess — do not weaken it back to a bare passthrough.
  if git push origin "$BRANCH"; then
    :
  else
    push_status=$?
    if [ "$push_status" -eq 1 ]; then
      echo "pr-open: push to origin/$BRANCH was rejected by the remote" >&2
      echo "  (non-fast-forward, protected branch, or a server-side hook declined it)." >&2
      echo "  Re-run after: git push --force-with-lease origin $BRANCH" >&2
      exit 6
    else
      echo "pr-open: push to origin/$BRANCH failed (git exit $push_status) —" >&2
      echo "  remote could not be reached, or the request could not complete." >&2
      exit 5
    fi
  fi
fi

# 4. Verify branch is up-to-date with main (no conflicts)
if ! git merge-base --is-ancestor origin/main HEAD 2>/dev/null && \
   ! git merge-base --is-ancestor HEAD origin/main 2>/dev/null; then
  echo "⚠️  Branch has diverged from origin/main. Consider rebasing." >&2
fi

# 5. Warn if this branch is stacked on another unmerged branch.
#
# We squash-merge, which replaces a branch's commits with one NEW commit. A
# branch built on top of another therefore still carries the originals after its
# parent lands, and git reads them as unmerged changes conflicting with content
# already in main — every stacked PR goes red the moment its parent merges.
# Observed live: #212 merged and #213/#214/#215/#216 broke simultaneously.
#
# The signal is precise: another origin branch that is NOT an ancestor of
# origin/main (so, unmerged) whose tip IS an ancestor of HEAD (so, we are built
# on it). Branches merely open alongside ours contain nothing of ours and are
# correctly ignored — warning on those would train everyone to ignore this one.
#
# A warning, never a gate. Stacking is sometimes the right call — it was during
# #207, when main was red and a fresh worktree could not even `bun install` —
# and a blocked pr-open would be worse than the surprise it prevents.
STACKED_ON=""
while IFS= read -r ref; do
  short="${ref#refs/remotes/origin/}"
  case "$short" in HEAD | main | master | "$BRANCH") continue ;; esac
  # already merged → its commits are in main under some sha; nothing to rebase past
  git merge-base --is-ancestor "$ref" origin/main 2>/dev/null && continue
  # unmerged, and we contain its tip → we are built on it
  if git merge-base --is-ancestor "$ref" HEAD 2>/dev/null; then
    STACKED_ON="$STACKED_ON $short"
  fi
done < <(git for-each-ref --format='%(refname)' refs/remotes/origin)

if [ -n "$STACKED_ON" ]; then
  echo "⚠️  '$BRANCH' is stacked on unmerged branch(es):$STACKED_ON" >&2
  echo "   This repo squash-merges, so those commits will land under a NEW sha and" >&2
  echo "   this PR will conflict until it is rebased past them:" >&2
  for s in $STACKED_ON; do
    # Resolve the boundary to a sha NOW, at warn time (#265/#248). By the time
    # anyone actually needs this recipe, `pr-cleanup` has usually already
    # deleted `origin/$s` — the recipe exists precisely for the
    # after-the-parent-merged case, so printing the branch name alone hands
    # back a ref that is gone by design. A sha is a concrete object and
    # survives the branch's deletion; the branch name stays in a trailing
    # comment purely so the line still reads clearly in scrollback.
    #
    # The boundary is the FORK POINT, not the parent's tip (macroscopeapp on
    # PR #323). Today the two are the same sha — the detection above only
    # reaches here when `origin/$s` is already an ancestor of HEAD, which makes
    # merge-base(origin/$s, HEAD) equal to its tip. They stop being the same
    # the moment the parent advances past what we contain, and then the tip
    # would replay the parent's newer commits onto main as if they were ours.
    # merge-base is the definition we actually mean, so use it and the case
    # never arises.
    sha="$(git merge-base "origin/$s" HEAD)"
    echo "     git rebase --onto origin/main $sha $BRANCH   # $s" >&2
  done
  echo "   The boundary sha is frozen as of now. If '$BRANCH' later pulls in newer" >&2
  echo "   commits from a parent, recompute with 'git merge-base <parent> $BRANCH'" >&2
  echo "   while that parent still exists — a stale boundary replays its commits." >&2
  echo "   Proceeding — stacking is sometimes right. See docs/dev-workflow-spec.md" >&2
  echo "   → 'A stacked PR conflicts after its parent merges'." >&2
fi

# 5.5 Review before opening (#377, the intervention arm of btw#59)
#
# Runs BEFORE `gh pr create`, because the whole point is that findings are fixed
# while the PR does not yet exist. Reviewing after it opens would already have
# paid the per-run charge this is meant to avoid.
#
# BLOCKS on findings (exit 7 from pr-review) rather than printing and proceeding:
# a gate an agent can walk through is not a gate, and the experiment asks whether
# findings get acted on, not whether they get displayed. `--reviewed` is the
# escape hatch and is deliberately an explicit word.
#
# ALSO BLOCKS on exit 8 (#401, PR #393): zero lenses completing is "could not
# review", not "reviewed, clean" — collapsing the two into one exit-0 path let
# a PR open with no review coverage and no message. `--reviewed` covers this
# too, since it skips pr-review outright before this check ever runs.
#
# FAILS OPEN on anything else. pr-review returns 0 only when `claude`/`python3`
# were never on PATH to begin with, so a broken reviewer can never become a
# broken release path — but a reviewer that WAS available and still produced
# nothing (exit 8) is no longer "anything else".
if [ "$SKIP_REVIEW" -eq 0 ] && command -v pr-review >/dev/null 2>&1; then
  echo "🔍 Reviewing before opening (pr-review, 3 lenses)..."
  review_status=0
  pr-review || review_status=$?
  if [ "$review_status" -eq 7 ]; then
    echo "" >&2
    echo "pr-open: review found issues — the PR was NOT created (#377)." >&2
    echo "  Fix them and re-run 'pr-open', or accept them with 'pr-open --reviewed'." >&2
    exit 7
  elif [ "$review_status" -eq 8 ]; then
    echo "" >&2
    echo "pr-open: pr-review could not review this branch — zero lenses ran (#401)." >&2
    echo "  The reviewer is broken, or every lens timed out; a real finding could be" >&2
    echo "  hiding in the coverage that never ran. Fix the reviewer and re-run" >&2
    echo "  'pr-open', or accept the gap with 'pr-open --reviewed'." >&2
    exit 8
  elif [ "$review_status" -ne 0 ]; then
    echo "pr-open: pr-review exited $review_status — proceeding unreviewed." >&2
  fi
elif [ "$SKIP_REVIEW" -eq 0 ]; then
  # LOUD. Every other fail-open path in this design announces itself, and
  # install-workflow-tools groups the pr-open/pr-review deploy specifically to
  # prevent this state — "every PR opens unreviewed while pr-open still exits 0",
  # named there as the failure hardest to notice. Silence here was the one
  # condition producing no output at all.
  echo "⚠️  pr-open: 'pr-review' not on PATH — opening the PR UNREVIEWED (#377)." >&2
  echo "   Fix with: install-workflow-tools" >&2
fi

# 6. Create the PR
echo "📡 Creating pull request..."
if ! gh pr create --fill --base main; then
  echo "pr-open: 'gh pr create' failed — see gh's output above." >&2
  exit 5
fi
