#!/usr/bin/env bash
# git-checkpoint — add all changes, commit, and push in one command.
# Usage: git-checkpoint "your commit message"
#        git-checkpoint --push "message"      (force the push, see #368)
#        git-checkpoint -- "-a message that starts with a dash"
#        git-checkpoint -h | --help
#        git-checkpoint --version
#
# --- Why the push is sometimes withheld (#368) ---
# Macroscope bills a $0.50 floor per review run and re-reviews on every push.
# Measured over 2026-08-11..19 across five repos: 269 runs, $143.56, of which
# 157 runs / $64.58 / 45% were re-reviews (btw#59). Pushes made BEFORE a PR
# exists cost nothing — the opening review bundles them, and the timing proves
# it: on 7-11 commit PRs the first review fires within seconds of PR creation.
#
# So the push is held back in exactly one situation — a PR is already open on
# this branch — and sent as one batch when the fix round is done. Before the PR
# exists, this script pushes on every commit exactly as it always has, because
# that push is free and that is the phase where losing work actually hurts.
#
# Unpushed commits during a fix round are safe from pr-cleanup: its LOCAL_TIP
# vs PR_HEAD_OID gate (#216, #317) refuses to delete a branch that is ahead of
# the PR head.
#
# --- Exit codes ---
#   0  success — committed, and pushed unless batched behind an open PR
#   1  usage error — no message given, or a flag-shaped argument that is not
#      -h/--help/-- (#310: `git-checkpoint --help` used to commit AND push
#      with the message "--help"; a flag is never a message)
#   3  precondition not met — on main/master (#225 gap 1), or the branch has no
#      upstream to push to (#228)
# ---
set -euo pipefail

usage() {
  cat <<'EOF'
usage: git-checkpoint "<commit message>"
       git-checkpoint --push "<commit message>"
       git-checkpoint -- "<message that starts with ->"
       git-checkpoint -h | --help
       git-checkpoint --version

Adds ALL changes (git add -A), commits with the message + 👑π🐱, and pushes.
Refuses on main/master, on a detached HEAD, and on a branch with no upstream.

While a PR is OPEN on this branch the push is held back and the commits pile up
locally, so a fix round costs one code review instead of one per commit (#368).
Send them with `git push`, or use --push to commit and push in one step anyway.
Before a PR exists, every commit is pushed as usual.

exit codes: 0 ok · 1 usage · 3 precondition (protected branch / no upstream)
EOF
}

# #367: -h/--help/--version are terminal — they take no other arguments (full
# rationale in bin/pr-open). Exit 1 here, not 2: this script's usage-error code
# is documented as 1 in docs/dev-workflow-spec.md, and reconciling the family's
# three vocabularies is #366's call, not a side effect of this guard. The scan
# stops at `--`, so `git-checkpoint -- "--version"` still commits that message.
for a in "$@"; do
  if [ "$a" = "--" ]; then break; fi
  case "$a" in
    -h|--help|--version)
      if [ "$#" -ne 1 ]; then
        echo "git-checkpoint: $a takes no other arguments (got: $*)" >&2
        exit 1
      fi ;;
  esac
done

# A flag is never a commit message (#310). Only -h/--help, --version, and the
# `--` terminator are recognised; any other leading '-' is refused rather than
# committed, because the cost of guessing wrong is a staged, committed AND
# pushed "--typo".
FORCE_PUSH=0
# A LOOP, not a single `case` (macroscopeapp, PR #369): `--push` shifted itself
# out and the `case` then ended, so neither the `--` terminator nor the
# flag-shaped-message refusal below ever ran against what followed it.
# `git-checkpoint --push -- "-fix"` committed the message `--`. That is #310
# reopening through a flag added after it — every flag added here from now on
# composes, instead of each one needing its own re-validation.
while [ $# -gt 0 ]; do
  case "$1" in
  -h|--help) usage; exit 0 ;;
  # --push opts out of the open-PR batching below and restores the
  # unconditional push, for when the re-review is the point (#368).
  --push) FORCE_PUSH=1; shift ;;
  # #178: this is the whole answer to "am I running the worktree copy or
  # ~/bin's?" — install-workflow-tools deploys this script to ~/bin, so a bare
  # `git-checkpoint` from a feature worktree runs whatever was last installed,
  # not the worktree's own copy. `readlink -f` resolves both a real file and a
  # symlink to its actual on-disk location. Not built (no .mjs step for shell
  # scripts), so there is no commit-hash/semver stamp to print alongside it —
  # this is the PATH half only.
  --version) readlink -f "$0"; exit 0 ;;
  # `break`, not a bare `shift`: everything after `--` is the message, verbatim,
  # and must not be re-scanned as flags.
  --) shift; break ;;
  -*)
    echo "git-checkpoint: '$1' looks like a flag, not a commit message — refusing to commit it." >&2
    echo "  For a message that really starts with '-': git-checkpoint -- \"$1\"" >&2
    echo "  Usage: git-checkpoint --help" >&2
    exit 1 ;;
  # The first non-flag word is the message. Stop scanning so the arity check
  # below sees the message and only the message.
  *) break ;;
  esac
done

MSG="${1:-}"
if [ -z "$MSG" ]; then
  echo "git-checkpoint: message required" >&2
  echo "  git-checkpoint \"feat: add widget (#42)\"" >&2
  exit 1
fi
# #367: `MSG="$1"` took the first word and dropped the rest, so an UNQUOTED
# message committed and PUSHED only its first word — `git-checkpoint fix the
# parser` committed "fix". Silent truncation of an already-pushed commit message
# is the expensive half of #367's finding 3; refusing costs one retry with
# quotes. Joining the words instead was the road not taken: this script's whole
# contract is "the message is ONE quoted argument" (that is why `--` exists),
# and guessing at spacing for a message that is about to be pushed is the kind
# of helpful guess #209 was filed over.
if [ "$#" -gt 1 ]; then
  shift
  echo "git-checkpoint: unexpected argument: '$1' — the message must be ONE quoted argument." >&2
  echo "  git-checkpoint \"feat: add widget (#42)\"" >&2
  exit 1
fi

BRANCH=$(git branch --show-current)
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ] || [ -z "$BRANCH" ]; then
  echo "git-checkpoint: on '${BRANCH:-detached HEAD}' — this command commits AND pushes in one" >&2
  echo "  step; refusing on the primary branch. Start feature work first:" >&2
  echo "  git checkout -b <issue#>-<slug>" >&2
  exit 3
fi

# A bare `git push` needs an upstream, and this script does NOT create one:
# `wt-new` already pushes every branch with its upstream set, so a branch without
# one is off the sanctioned path. Silently creating the remote branch here would
# hide that rather than teach it (#228). Checked BEFORE committing — checked after,
# a re-run once the config is fixed would hit "nothing to commit" and fail again.
#
# Found by running the suite under an empty $HOME while wiring CI: the old bare
# push worked only because of this developer's global `push.autoSetupRemote=true`,
# making the script's behaviour a property of the host rather than of the script.
if ! git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' >/dev/null 2>&1; then
  echo "git-checkpoint: '$BRANCH' has no upstream, so there is nothing to push to." >&2
  echo "  Fix for this host:   git config --global push.autoSetupRemote true" >&2
  echo "  Or just this branch: git push --set-upstream origin $BRANCH" >&2
  echo "  wt-new normally does this for you when it creates the branch." >&2
  exit 3
fi

# --- Is a PR already open on this branch? (#368) ---
# `gh pr list --json` is the machine-readable contract: exit 0 with a JSON array
# on success, non-zero on failure. That separates the three answers cleanly —
# a count of `0` means no PR of ours, a positive count means one is open, and a
# non-zero exit means gh could not tell us. No human-facing text is parsed
# (Agent-First Output); `--jq` does the counting so this stays jq-free itself.
#
# FAIL OPEN. If gh is missing, unauthenticated, rate-limited, or offline, this
# pushes exactly as it did before. The asymmetry is the reason: a missed
# detection costs $0.50, a wrongly-withheld push risks the work itself.
#
# SCOPED TO OUR OWN REPO (macroscopeapp, PR #369, rated High). `--head` matches by
# branch NAME across every fork, so an open PR on a stranger's `42-feature` used
# to answer for ours and withhold this branch's push — silently and indefinitely,
# because nothing here has a PR to explain why the commits are piling up. Same
# fork-collision guard bin/pr-reject and bin/pr-merge have carried since #209.
# The owner lookup is a second call, and a failure of EITHER falls open, so the
# guard cannot cost a push.
pr_is_open() {
  command -v gh >/dev/null 2>&1 || return 1
  local owner ours
  owner=$(gh repo view --json owner --jq '.owner.login' 2>/dev/null) || return 1
  [ -n "$owner" ] || return 1
  ours=$(gh pr list --head "$BRANCH" --state open --json number,headRepositoryOwner \
    --jq "[.[] | select(.headRepositoryOwner.login == \"$owner\")] | length" 2>/dev/null) || return 1
  [ -n "$ours" ] && [ "$ours" != "0" ]
}

git add -A
git commit -m "${MSG} 👑π🐱"

if [ "$FORCE_PUSH" -eq 0 ] && pr_is_open; then
  # `@{upstream}..HEAD` counts what origin has not seen yet — the real batch
  # size, not just this run's one commit, since earlier checkpoints in the same
  # fix round are also still sitting here.
  PENDING=$(git rev-list --count '@{upstream}..HEAD' 2>/dev/null || echo "?")
  echo "📦 committed — push held back: a PR is open on '$BRANCH' and every push"
  echo "   buys another paid code review (#368)."
  echo "   $PENDING commit(s) waiting. Send the batch when the fix round is done:"
  echo "     git push"
  echo "   Or commit and push in one step next time: git-checkpoint --push \"...\""
  exit 0
fi

git push
