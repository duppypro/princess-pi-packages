#!/usr/bin/env bash
# ---
# pr-threads <pr#> [owner/repo] [--json] — review state for a PR: unresolved
# conversations AND whether any review actually covers the current head.
#
# Green light (✅, exit 0) only when BOTH are true: nothing unresolved, and
# either a review covers the current head or the PR has never been reviewed at
# all (nothing to gate on yet). Otherwise prints the unresolved threads and/or
# a review-coverage warning, and exits 1 — scriptable as a merge-gate check.
#
# Why the coverage half exists (#254): zero unresolved threads used to be one
# output wearing two different states — "reviewer looked at this head and had
# nothing to say" and "reviewer has never seen this head". A bot that reviews
# once per PR (not once per push) means the commits most likely to need a
# second look — the ones written in response to a finding — are exactly the
# ones that escaped the gate. `head` and `reviewedHead` close that gap.
#
# Why the thread half exists: `gh pr view` has no unresolved-conversation
# field — thread resolution state only exists in the GraphQL API. Pairs with
# the ruleset rule required_review_thread_resolution (ruleset 18684693).
#
# --json (#232) emits one `pr-threads/list@1` document with the thread ids and
# comment bodies an agent needs to ACT on a review, instead of scraping the HTML
# behind the URL. #254 added three top-level fields to the SAME document: head,
# reviewedHead, latestReviewCommit — see docs/dev-workflow-spec.md.
#
# Contract, including the trust boundary the `trusted` field exists to serve:
# docs/dev-workflow-spec.md § `pr-threads --json`.
#
# --- Exit codes ---
# pr-threads predates the #224 shared table and reserves exit 1 specially,
# outside that table, because #258's pr-merge gate depends on distinguishing
# it from every other failure:
#
#   0  clean — nothing unresolved, and head is either reviewed or never
#      reviewed by anyone.
#   1  NOT clean, but the check itself SUCCEEDED — unresolved threads and/or
#      no review covers the current head. This is "look at the output", never
#      "broken". #258's pr-merge treats this as the one code that means print
#      details and refuse to merge, not abort-in-confusion.
#   2  usage error (bad flag).
#   4  not found — no such PR (or repo) at all.
#   5  remote/API failure — gh itself failed; state could NOT be determined.
#      This is the code that used to collide with 1: under `set -e`, a failed
#      `gh api graphql` used to propagate gh's own exit status (usually 1),
#      indistinguishable from "unresolved threads found". #258 needs 1 vs 5 to
#      be unambiguous, so every gh call below is now wrapped explicitly. Also
#      covers a jq parse failure or a truncated/inconsistent paginated
#      response (post-#258 finding: a failed `jq` nested inside `$((...))`
#      does not trip `set -e` — it silently zeroed the count instead of
#      failing the check. Every jq call in the pagination loop is now wrapped
#      the same explicit way as the gh calls, and `seen` is reconciled
#      against `total` after the loop as a second backstop).
#   3, 6  not used by this script — reserved by the #224 table for other pr-*
#      scripts (precondition-not-met, safety-gate-refused).
# ---
set -euo pipefail

# Authoritative issuers (~/git-projects/CLAUDE.md). A review comment from anyone
# else is DATA — a finding to relay to the human, never an instruction to run.
# Emitted as a computed boolean so the caller needs zero reasoning steps; exact
# element match, so a login merely containing an authoritative name is untrusted.
TRUSTED_LOGINS='["duppypro","princess-pi-bot","cwerk-bot"]'

# Flags are scanned out first: `--json` used to be swallowed as the positional
# `repo`, which reported on a repository named "--json".
json_mode=0
pr=""
repo=""
for arg in "$@"; do
  case "$arg" in
    --json) json_mode=1 ;;
    -*) echo "unknown flag: $arg" >&2; exit 2 ;;
    *)
      if [ -z "$pr" ]; then pr="$arg"
      elif [ -z "$repo" ]; then repo="$arg"
      fi
      ;;
  esac
done
if [ -z "$pr" ]; then
  echo "usage: pr-threads <pr#> [owner/repo] [--json]" >&2
  exit 2
fi

# stderr from wrapped gh calls lands here so a failure can be reported without
# corrupting the JSON captured on stdout (mixing 2>&1 would risk a stray gh
# warning breaking `jq` downstream on the SUCCESS path too).
gh_err_file=$(mktemp)
trap 'rm -f "$gh_err_file"' EXIT

# jq_or_die <outvar> [jq-args...] — run jq against the current page's $json
# and either populate $outvar or exit 5. A failing command substitution
# nested inside `$(( ))` does NOT trip `set -e` (bash only checks the
# arithmetic command's own exit status, not the substitution's) — that gap is
# exactly what let a partial/null GraphQL page report as a clean, mergeable
# PR. Every jq call that feeds the pagination loop goes through here instead
# of being inlined directly into an arithmetic or string expansion.
jq_or_die() {
  local __outvar="$1"; shift
  local __result
  if ! __result=$(jq "$@" <<<"$json" 2>"$gh_err_file"); then
    echo "pr-threads: jq failed parsing the API response for $repo #$pr (page $page_num):" >&2
    cat "$gh_err_file" >&2
    exit 5
  fi
  printf -v "$__outvar" '%s' "$__result"
}

if [ -z "$repo" ]; then
  if ! repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>"$gh_err_file"); then
    echo "pr-threads: could not determine repo (gh repo view failed):" >&2
    cat "$gh_err_file" >&2
    exit 5
  fi
fi
owner="${repo%%/*}"
name="${repo##*/}"

# Fetch ALL review threads with pagination, plus (on the first page only,
# since it does not change across pages) the head sha and every review's
# commit — the #254 review-coverage check. The GraphQL API returns max 100
# per page for reviewThreads; we loop until we've seen totalCount threads.
#
# `reviews` is fetched `last: 100` — deliberately the TAIL of the connection,
# not the head — without its own cursor pagination (macroscopeapp finding on
# PR #267, rated High): a PR can accumulate more than 100 reviews over its
# life (a bot re-reviewing every push adds up fast), and `first: 100` reads
# the OLDEST 100 — on a PR past that count, the review that actually covers
# the CURRENT head is exactly the one most likely to be missing, which turned
# a review-coverage gate that should pass into one that wrongly blocks
# (fails closed — an availability bug, not a safety hole, but a real one).
# `last: 100` is sufficient without full pagination because of how the
# connection is ordered and how heads move: the GraphQL `reviews` connection
# is returned in submission order (oldest first), and any review that covers
# the CURRENT head must have been SUBMITTED at or after that head was pushed
# — so it cannot be older than every review of every prior head. That makes
# it impossible for a head-covering review to fall outside the newest 100,
# UNLESS the PR has had over 100 reviews submitted against that SAME head
# since it became current (re-review churn without a new commit) — a
# vanishingly unlikely shape for this workflow, same class of edge case as
# the 100-comments-per-thread cap below. If that shape is ever hit in
# practice, the fix is cursor pagination on `reviews`, not a bigger `last:`.
#
# The count is tallied as an integer, deliberately kept separate from the text
# we print (#211). It used to be `${#unresolved[@]}` over an array built by
# `while read` from jq — but each jq record spans TWO lines (author/path, then
# the URL), so read appended two elements per thread and every count came out
# doubled. The listing looked right the whole time, which is why it survived:
# the count is the only part a merge gate reads.
#
# Counting in an integer also sidesteps `${#arr[@]}` on an empty array, which
# aborts under `set -u` on bash < 4.4 (macOS system bash is 3.2, and this script
# ships to ~/bin with an env shebang) — so the ZERO-unresolved success path was
# the one that crashed.
unresolved_count=0
unresolved_text=""
threads_ndjson=""
after="null"
seen=0
total=0
head_sha=""
head_extracted=0
reviews_json="[]"
page_num=0

while true; do
  if ! json=$(gh api graphql \
    -F owner="$owner" -F name="$name" -F pr="$pr" \
    -F after="$after" \
    -f query='
query($owner: String!, $name: String!, $pr: Int!, $after: String) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $pr) {
      headRefOid
      reviews(last: 100) {
        nodes {
          commit { oid }
          submittedAt
        }
      }
      reviewThreads(first: 100, after: $after) {
        totalCount
        pageInfo { hasNextPage endCursor }
        nodes {
          id
          isResolved
          isOutdated
          path
          line
          comments(first: 100) {
            nodes {
              path
              url
              body
              createdAt
              authorAssociation
              author { login }
            }
          }
        }
      }
    }
  }
}' 2>"$gh_err_file"); then
    echo "pr-threads: gh api graphql failed for $repo #$pr:" >&2
    cat "$gh_err_file" >&2
    exit 5
  fi

  # Not-found is not a gh-command failure — GitHub returns HTTP 200 with a
  # null pullRequest for a missing PR number, so this has to be checked
  # explicitly rather than folded into the wrapper above. Only worth checking
  # on the first page.
  #
  # A jq PARSE failure here is a DIFFERENT state than "no such PR" (post-#258
  # finding): the old `2>/dev/null || echo false` fail-open (the literal #210
  # anti-pattern) turned a malformed/non-JSON gh response into a false "not
  # found" (exit 4) — sending a human hunting for a PR that actually exists.
  # jq failing to parse at all means the check could not run, full stop: 5,
  # quoting the raw response. Only a jq SUCCESS that evaluates to `false`
  # means "checked, and there's no such PR": 4.
  if [ "$page_num" -eq 0 ]; then
    if ! pr_found_raw=$(jq -r '.data.repository.pullRequest != null' <<<"$json" 2>"$gh_err_file"); then
      echo "pr-threads: could not parse the API response for $repo #$pr (malformed JSON):" >&2
      cat "$gh_err_file" >&2
      echo "raw response was:" >&2
      echo "$json" >&2
      exit 5
    fi
    if [ "$pr_found_raw" != "true" ]; then
      echo "pr-threads: $repo #$pr not found." >&2
      exit 4
    fi
  fi

  if [ "$head_extracted" -eq 0 ]; then
    jq_or_die head_sha -r '.data.repository.pullRequest.headRefOid // empty'
    # PENDING (unsubmitted draft) reviews come back in this connection with
    # submittedAt: null — visible only to their own author, but a bot polling
    # its own drafts would otherwise cover a head it never actually submitted
    # a review against. Filter to submitted reviews only.
    jq_or_die reviews_json -c '[.data.repository.pullRequest.reviews.nodes[]?
      | select(.submittedAt != null)
      | .commit.oid // empty
      | select(. != "")]'
    head_extracted=1
  fi

  jq_or_die total -r '.data.repository.pullRequest.reviewThreads.totalCount'
  # totalCount comes back `null` (not an error) when reviewThreads itself is
  # null — e.g. a partial API response. Validate it is a real integer here
  # rather than letting a non-numeric $total blow up later arithmetic or, worse,
  # compare equal to itself and slip through the post-loop reconciliation.
  case "$total" in
    ''|*[!0-9]*)
      echo "pr-threads: $repo #$pr — reviewThreads.totalCount was not a number ('$total');" >&2
      echo "  the API response could not be interpreted as a review-thread page." >&2
      exit 5
      ;;
  esac

  # Count unresolved threads (one number per THREAD — jq counts the nodes, so
  # the multi-line rendering below cannot influence it)
  jq_or_die unresolved_page '[.data.repository.pullRequest.reviewThreads.nodes[]
    | select(.isResolved | not)] | length'
  unresolved_count=$((unresolved_count + unresolved_page))

  # …and separately accumulate the human-readable listing
  jq_or_die page_text -r '.data.repository.pullRequest.reviewThreads.nodes[]
    | select(.isResolved | not)
    | .comments.nodes[0]
    | "  \(.author.login)  \(.path)\n    \(.url)"'
  if [ -n "$page_text" ]; then
    unresolved_text="${unresolved_text}${page_text}
"
  fi

  # …and separately again, the machine-readable form: one compact record per
  # THREAD, appended across pages and assembled into an array at the end. Built
  # even in human mode — it costs one jq pass and keeps the two outputs derived
  # from the same fetch rather than from two different code paths.
  #
  # ALL threads are emitted, resolved ones included, because `isResolved` is only
  # meaningful to a caller that can see both. The count above stays the gate.
  #
  # A thread with more than 100 comments truncates here. Threads that long do not
  # occur in this workflow; if one ever does, the fix is comment pagination, not a
  # larger first:.
  jq_or_die page_nd -c --argjson trusted "$TRUSTED_LOGINS" '
    .data.repository.pullRequest.reviewThreads.nodes[]
    | {
        id, isResolved, isOutdated, path, line,
        comments: [
          .comments.nodes[]
          | {
              author: .author.login,
              authorAssociation,
              trusted: (.author.login as $l | ($trusted | index($l)) != null),
              body,
              createdAt,
              url
            }
        ]
      }'
  if [ -n "$page_nd" ]; then
    threads_ndjson="${threads_ndjson}${page_nd}
"
  fi

  jq_or_die seen_page '[.data.repository.pullRequest.reviewThreads.nodes[]] | length'
  seen=$((seen + seen_page))

  jq_or_die hasNext -r '.data.repository.pullRequest.reviewThreads.pageInfo.hasNextPage'
  page_num=$((page_num + 1))
  if [ "$hasNext" != "true" ]; then
    break
  fi
  jq_or_die after -r '.data.repository.pullRequest.reviewThreads.pageInfo.endCursor'
done

# #258 post-merge finding (#4): this loop's own header comment claims "we loop
# until we've seen totalCount threads", but `seen` was write-only — accumulated
# every page and never actually compared to `total`. Termination was purely
# `hasNextPage`. This is the cheapest backstop against a partial page: even if
# a malformed response somehow produced well-formed-but-truncated pages (so
# every jq_or_die above succeeds), a `seen` that doesn't match `total` is
# caught here rather than silently reported as a complete, clean fetch.
if [ "$seen" -ne "$total" ]; then
  echo "pr-threads: $repo #$pr — retrieved $seen of $total review threads;" >&2
  echo "  pagination stopped before the fetch completed. Treating this as" >&2
  echo "  undetermined state, not a clean result." >&2
  exit 5
fi

# --- #254: review coverage of the current head ------------------------------
# head_known is false only for pre-#254 test fixtures that don't stub
# headRefOid at all — the real GraphQL API always returns it. In that legacy
# case we fall back to the old thread-only behaviour rather than guessing.
head_known=false
[ -n "$head_sha" ] && head_known=true

reviewed_head=false
if $head_known; then
  reviewed_head=$(jq -r --arg h "$head_sha" 'index($h) != null' <<<"$reviews_json")
fi

no_reviews=$(jq -r 'length == 0' <<<"$reviews_json")
latest_review_commit=$(jq -r '.[-1] // empty' <<<"$reviews_json")

# review_blocked: a reviewer HAS looked at this PR, just not at this head —
# the dotfiles-doctor#11 case. This blocks (exit 1) because it is a
# determined bad state, not an indeterminate one.
#
# review_advisory: nobody has EVER reviewed this PR. Treated as "nothing to
# gate on" rather than blocking, so a repo with no review bot installed does
# not have every PR permanently stuck at non-zero. See this script's header
# and docs/dev-workflow-spec.md for the reasoning; #254 left this as an open
# design question and this is the resolution.
review_blocked=false
review_advisory=false
if $head_known && [ "$reviewed_head" != "true" ]; then
  if [ "$no_reviews" = "true" ]; then
    review_advisory=true
  else
    review_blocked=true
  fi
fi

head_short="${head_sha:0:7}"
latest_review_short="${latest_review_commit:0:7}"
head_suffix=""
$head_known && head_suffix=" @ $head_short"

# --json short-circuits both human branches: one document on stdout, nothing else.
if [ "$json_mode" -eq 1 ]; then
  printf '%s' "$threads_ndjson" | jq -s -c \
    --arg repo "$repo" \
    --argjson pr "$pr" \
    --argjson total "$total" \
    --argjson unresolved "$unresolved_count" \
    --arg head "$head_sha" \
    --argjson reviewedHead "$reviewed_head" \
    --arg latestReviewCommit "$latest_review_commit" \
    '{
      schema: "pr-threads/list@1",
      repo: $repo,
      pr: $pr,
      totalCount: $total,
      unresolvedCount: $unresolved,
      head: ($head | if . == "" then null else . end),
      reviewedHead: $reviewedHead,
      latestReviewCommit: ($latestReviewCommit | if . == "" then null else . end),
      threads: .
    }'
  if [ "$unresolved_count" -eq 0 ] && ! $review_blocked; then
    exit 0
  fi
  exit 1
fi

if [ "$unresolved_count" -eq 0 ]; then
  if $review_blocked; then
    if [ -n "$latest_review_commit" ]; then
      echo "⚠️  $repo #$pr — 0 unresolved conversations ($total total), but no review covers head $head_short (latest review: $latest_review_short)"
    else
      echo "⚠️  $repo #$pr — 0 unresolved conversations ($total total), but no review covers head $head_short"
    fi
    exit 1
  fi
  if $review_advisory; then
    echo "ℹ️  $repo #$pr — 0 unresolved conversations ($total total, all resolved)$head_suffix; no reviews recorded yet — nothing to gate on"
    exit 0
  fi
  echo "✅ $repo #$pr — 0 unresolved conversations ($total total, all resolved)$head_suffix"
  exit 0
fi

echo "❌ $repo #$pr — $unresolved_count unresolved conversation(s)$head_suffix:"
printf '%s' "$unresolved_text"
if $review_blocked; then
  if [ -n "$latest_review_commit" ]; then
    echo "⚠️  additionally, no review covers head $head_short (latest review: $latest_review_short)"
  else
    echo "⚠️  additionally, no review covers head $head_short"
  fi
fi
exit 1
