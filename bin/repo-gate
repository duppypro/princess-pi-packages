#!/usr/bin/env bash
# ---
# repo-gate [<repo>...] [--json] [--policy <path>] [--remedy <repo>] — compare every
# repo's live branch-protection ruleset against the declared policy in
# docs/repo-policy.json, and report the difference. Also asserts that the bot login
# named in the policy (`.bot_login`) holds write access on every in-scope repo — a
# repo missing that grant looks identical to a correctly configured one until an
# agent tries to push and is refused (#304). REPORT ONLY: this script never writes
# to GitHub (#288).
#
# Why it exists: "is this repo governed?" was answerable only by opening the GitHub
# UI one repo at a time, 29 times. Nothing recorded what the answer was *supposed*
# to be, so a repo that drifted looked exactly like a repo that was deliberately
# different. The policy file supplies the intent; this script supplies the diff.
#
# Why report-only: the fix is a PUT that rewrites branch protection on a repo, or
# one that adds a collaborator. That is worth a human reading the payload the first
# few times. Every drift record carries a `remedy` naming the exact command, so an
# agent can act without re-deriving it — and so a future applier executes strings
# that already shipped and are already under test.
#
# --- Exit codes (the shared pr-* contract, docs/dev-workflow-spec.md#exit-codes) ---
#   0  every in-scope repo matches the declared policy AND the bot has write access
#   2  usage error — bad flag, or a repo named that the policy does not govern
#   3  precondition not met — policy file found but unreadable/invalid JSON, or
#      missing `.bot_login`
#   4  not found — no policy file at any searched path
#   5  remote/API failure — state could NOT be determined for at least one repo,
#      including "the bot's collaborator permission could not be read"
#   6  drift found — state WAS determined, and it differs from the policy, including
#      "the bot is not a collaborator" or "the bot's access is below write"
#
# 5 vs 6 is the distinction that carries weight here, same as everywhere else in
# this family: "I could not check" is not "I checked and it says no." A missing or
# insufficient bot grant is 6, same as ruleset drift; a `gh api` failure while
# probing it is 5, never silently reported as "no access".
# ---
set -uo pipefail

SELF="$(basename "$0")"

# ---
# ARGUMENT PARSING
# ---

JSON=0
POLICY=""
REMEDY=""
declare -a ONLY=()

usage() {
	cat <<'EOF'
repo-gate — report how each repo's live branch protection differs from the declared policy.

USAGE
  repo-gate                            report every repo the policy governs
  repo-gate watu does-it-glider        report only these repos
  repo-gate --json                     one repo-gate/report@1 document on stdout
  repo-gate --remedy watu              print the exact command that would fix watu
  repo-gate --policy ./other.json      use a policy file other than the default

FLAGS
  --json             machine-readable output; the exit code is unchanged
  --policy <path>    policy file to read (default: search order below)
  --remedy <repo>    print the fix for one repo and exit; writes nothing
  --why              why you would run this
  -h, --help         this text

POLICY SEARCH ORDER
  1. --policy <path>
  2. $PWD/docs/repo-policy.json
  3. ~/git-projects/princess-pi-packages/docs/repo-policy.json

EXIT CODES
  0  every governed repo matches its tier (or is a held waiver), and the bot has write
  2  usage error — unknown flag, missing argument, repo not governed by the policy
  3  environment or policy is unusable — gh/jq missing, policy not JSON, no .owner,
     no .bot_login
  4  no policy file found in the search order
  5  the account could not be fully read — some repo's state is UNKNOWN, not clean.
     Never conflated with 6: "I could not look" and "I looked and found drift" are
     different facts, and only one of them is safe to ignore. Includes "the bot's
     collaborator permission could not be read".
  6  drift — at least one repo differs from its declared tier, or the bot login named
     in the policy lacks write access on it

This script never writes to GitHub. See --why for what it does and does not prove.
EOF
}

why() {
	cat <<'EOF'
repo-gate — why would I run this?

SCENARIO  You are about to trust a repo's branch protection and want to know whether
          it matches what was decided, without opening 29 GitHub settings pages.
  repo-gate
RESULT    One line per repo: ok, drift (with exactly which rules differ, and whether
          the policy's bot_login lacks write access), or n/a. Exit 6 if anything
          drifted, so it works as a check in a script.

SCENARIO  A repo came back red and you want to fix it.
  repo-gate --remedy watu
RESULT    The literal `gh api` command, payload included. You run it; repo-gate does
          not. Re-run `repo-gate watu` afterwards to confirm it took.

SCENARIO  You added a new repo and want to know whether it is governed.
  repo-gate
RESULT    A repo that is in scope by the policy's own rule but absent from its repos
          map is reported as `unlisted` — drift, not silence. Adding a repo to GitHub
          therefore forces a decision about it here.

SCENARIO  An agent needs to act on the result.
  repo-gate --json
RESULT    A repo-gate/report@1 document: flat per-repo records with stable keys, each
          drift carrying a `remedy` string. No prose parsing.

NOT FOR   Proving that anything is enforced. Every governed repo grants the owner
          bypass `always` by design, so these rules bind nobody who is an admin — a
          PR can show BLOCKED and still merge. repo-gate prints that disclosure on
          every run precisely so this output is not mistaken for an enforcement
          guarantee. It also does not check CI health, only that the required check
          is *named* in the ruleset.

Run repo-gate --help for the full flag reference.
EOF
}

while [ $# -gt 0 ]; do
	case "$1" in
		--json) JSON=1; shift ;;
		--policy) POLICY="${2:-}"; [ -n "$POLICY" ] || { echo "$SELF: --policy needs a path" >&2; exit 2; }; shift 2 ;;
		--remedy) REMEDY="${2:-}"; [ -n "$REMEDY" ] || { echo "$SELF: --remedy needs a repo name" >&2; exit 2; }; shift 2 ;;
		--why) why; exit 0 ;;
		-h|--help) usage; exit 0 ;;
		-*) echo "$SELF: unknown flag '$1' (try --help)" >&2; exit 2 ;;
		*) ONLY+=("$1"); shift ;;
	esac
done

command -v gh >/dev/null 2>&1 || { echo "$SELF: gh is not on PATH" >&2; exit 3; }
command -v jq >/dev/null 2>&1 || { echo "$SELF: jq is not on PATH" >&2; exit 3; }

# ---
# POLICY LOCATION
# ---

# Searched rather than derived from $0: the installed copy lives in ~/bin, detached
# from any clone, so "next to the script" resolves to nothing useful. Refuses with
# the search order rather than inventing a default — a report run against a policy
# the caller did not mean is worse than no report.
if [ -z "$POLICY" ]; then
	for candidate in \
		"$PWD/docs/repo-policy.json" \
		"$HOME/git-projects/princess-pi-packages/docs/repo-policy.json"
	do
		if [ -r "$candidate" ]; then POLICY="$candidate"; break; fi
	done
fi

# -e, not -r: a policy that EXISTS but cannot be read is a different fact from one
# that is not there, and 4 would send the reader hunting for a file sitting in front
# of them. Same "could not proceed" vs "not there" split the rest of this family draws.
if [ -n "$POLICY" ] && [ -e "$POLICY" ] && [ ! -r "$POLICY" ]; then
	echo "$SELF: '$POLICY' exists but is not readable." >&2
	echo "  Check its permissions — this is not a missing-file problem." >&2
	exit 3
fi

if [ -z "$POLICY" ] || [ ! -e "$POLICY" ]; then
	echo "$SELF: no policy file found." >&2
	echo "  Searched: \$PWD/docs/repo-policy.json" >&2
	echo "            ~/git-projects/princess-pi-packages/docs/repo-policy.json" >&2
	echo "  Name one: $SELF --policy <path>" >&2
	exit 4
fi

if ! jq -e . "$POLICY" >/dev/null 2>&1; then
	echo "$SELF: '$POLICY' is not valid JSON." >&2
	exit 3
fi

# Every structure this script later reads WITHOUT a guard is checked here, because
# the failure is silent and points the wrong way: a policy missing `.repos` produced
# an empty target list, an empty summary, three "integer expression expected" errors
# — and **exit 0**. A caller reading only the exit code concludes the fleet is
# compliant. For a compliance tool that is the worst reachable outcome, so an
# unusable policy must be a loud 3 and never a quiet 0.
#
# Listed individually rather than as one boolean so the error names the missing key.
POLICY_REQUIRED='
  ["owner",                            "string"],
  ["ruleset_name",                     "string"],
  ["bot_login",                        "string"],
  ["repos",                            "object"],
  ["tiers",                            "object"],
  ["scope",                            "object"],
  ["scope.target",                     "string"],
  ["scope.excluded",                   "object"],
  ["enforcement_disclosure.bypass_actors", "array"]
'
missing=$(jq -r "[ $POLICY_REQUIRED ]"' as $req
	| . as $pol
	| [ $req[]
	    | . as [$path, $want]
	    | ($path | split(".")) as $parts
	    | ($pol | getpath($parts)) as $got
	    | select(($got | type) != $want)
	    | "  ." + $path + ": want " + $want + ", got " + ($got | type)
	  ] | join("\n")' "$POLICY" 2>/dev/null) || missing="  (policy could not be inspected)"
if [ -n "$missing" ]; then
	echo "$SELF: '$POLICY' is not a usable policy." >&2
	echo "$missing" >&2
	echo "  Refusing to audit against it — an incomplete policy would report an empty fleet as compliant." >&2
	exit 3
fi

# Type-checking the containers is not enough: a repo pointing at a tier that does not
# exist produced an EMPTY payload and a POST remedy that would create a ruleset with no
# rules in it, while the run exited 6 as though it had merely found drift. A policy that
# cannot describe its own repos is unusable, which is 3.
bad_tiers=$(jq -r '
	.tiers as $t
	| [ .repos | to_entries[]
    # A tier must exist, and must carry EITHER .rules (it describes a ruleset) or
    # expect_no_ruleset (it is a waiver). plan-blocked is the second kind and has no
    # rules by design — demanding .rules of every tier would reject the real policy.
	    | select(($t[.value] | type) != "object"
	             or (($t[.value].rules | type) != "object" and $t[.value].expect_no_ruleset != true))
	    | "  .repos." + .key + ": tier \"" + .value + "\" is undefined, or defines neither .rules nor expect_no_ruleset"
	  ] | join("\n")' "$POLICY" 2>/dev/null) || bad_tiers=""
if [ -n "$bad_tiers" ]; then
	echo "$SELF: '$POLICY' assigns repos to tiers it does not define." >&2
	echo "$bad_tiers" >&2
	echo "  Refusing to audit — the remedy for such a repo would be a ruleset with no rules." >&2
	exit 3
fi

OWNER=$(jq -r '.owner' "$POLICY")
RULESET_NAME=$(jq -r '.ruleset_name' "$POLICY")
BOT_LOGIN=$(jq -r '.bot_login' "$POLICY")

# Structurally present but empty is not the same fact as "not there" (the
# POLICY_REQUIRED gate above), and it is the specific way this field would fail
# silently: every bot-access check below would probe `collaborators//permission`
# — a 404 that reads exactly like "not a collaborator" instead of "policy is broken".
if [ -z "$BOT_LOGIN" ]; then
	echo "$SELF: '$POLICY' has .bot_login but it is empty." >&2
	echo "  Refusing to probe bot access against no login — every check would look like a 404." >&2
	exit 3
fi

# ---
# REMEDY SYNTHESIS
# ---

# Built from the tier definition, never stored alongside it: a remedy string kept as
# its own field would be a second copy of the baseline, free to drift from the one
# the comparison uses. Derived, the remedy is wrong only when the check is also wrong.
build_payload() {
	local tier="$1"
	jq -c --arg tier "$tier" --arg name "$RULESET_NAME" '
		. as $p
		| $p.tiers[$tier] as $t
		| {
			name: $name,
			target: "branch",
			enforcement: ($t.enforcement // "active"),
			conditions: { ref_name: { include: [$p.scope.target], exclude: [] } },
			bypass_actors: $p.enforcement_disclosure.bypass_actors,
			rules: [
				$t.rules | to_entries[]
				| if .value == null then { type: .key }
				  elif .key == "pull_request" then {
				    type: .key,
				    parameters: ({
				      "allowed_merge_methods": ["merge","squash","rebase"],
				      "dismiss_stale_reviews_on_push": false,
				      "require_code_owner_review": false,
				      "require_last_push_approval": false,
				      "required_reviewers": []
				    } + .value)
				  }
				  else { type: .key, parameters: .value } end
			]
		}
	' "$POLICY"
}

remedy_for() {
	local repo="$1" tier="$2" existing_id="$3"
	if [ "$tier" = "plan-blocked" ]; then
		echo "none — private repo, account plan does not offer rulesets"
		return
	fi
	local payload quoted
	payload=$(build_payload "$tier")
	# %q, not a literal '\''...'\''. The payload is JSON built from the policy file, and a
	# single apostrophe anywhere in it — a ruleset name like "O'\''Reilly rules" — would
	# close the quote early and print a command that is silently altered rather than
	# obviously broken. This output exists to be pasted, so it has to survive pasting.
	# Escape only apostrophes, keeping the single-quoted form: identical output to
	# before when the payload has none (the normal case), and correct when it does.
	# `printf %q` would also be safe but renders the JSON as backslash soup, which
	# defeats the line above telling you to review the payload before running it.
	quoted="'${payload//\'/\'\\\'\'}'"
	if [ -n "$existing_id" ] && [ "$existing_id" != "null" ]; then
		echo "gh api -X PUT repos/$OWNER/$repo/rulesets/$existing_id --input - <<< $quoted"
	else
		echo "gh api -X POST repos/$OWNER/$repo/rulesets --input - <<< $quoted"
	fi
}

# ---
# BOT ACCESS PROBE
# ---

# Rulesets only decide who a rule binds; they say nothing about whether the bot can
# push at all. A repo missing the collaborator grant looks IDENTICAL to a correctly
# configured one until an agent tries to push and the server refuses it — this probe
# exists so that gap shows up here, in a report, instead of at push time (#304).
#
# The three outcomes the issue calls for, kept distinct rather than folded into one
# boolean: `ok` (write/maintain/admin — all three satisfy "can push"), `insufficient`
# (a collaborator, but below write — read/triage), and `none` (not a collaborator at
# all). `error` is a fourth state and is NOT one of the three: it means the probe
# itself failed, which must never be reported as "no access" — an API hiccup and a
# missing grant are different facts, same as everywhere else in this script.
#
# Emits one JSON object on stdout: {status, permission, detail}. Never touches
# $records directly, so it stays a pure function of one `gh api` call and is callable
# from both the main loop and the single-repo --remedy path.
bot_access_of() {
	local repo="$1"
	local perm_json
	if ! perm_json=$(gh api "repos/$OWNER/$repo/collaborators/$BOT_LOGIN/permission" 2>/dev/null); then
		jq -n --arg login "$BOT_LOGIN" '{
			status: "error", permission: null,
			detail: ($login + "'"'"'s permission on this repo could not be determined — gh api failed")
		}'
		return
	fi
	jq -n --arg login "$BOT_LOGIN" --argjson r "$perm_json" '
		($r.permission // "") as $perm
		| if ($perm == "admin" or $perm == "maintain" or $perm == "write") then
			{ status: "ok", permission: $perm, detail: ($login + " has " + $perm + " access") }
		  elif ($perm == "" or $perm == "none") then
			{ status: "none", permission: (if $perm == "" then null else $perm end),
			  detail: ($login + " is not a collaborator on this repo") }
		  else
			{ status: "insufficient", permission: $perm,
			  detail: ($login + " has permission " + $perm + " (below write)") }
		  end
	'
}

bot_remedy_for() {
	local repo="$1"
	echo "gh api -X PUT repos/$OWNER/$repo/collaborators/$BOT_LOGIN --input - <<< '{\"permission\":\"push\"}'"
}

# ---
# ACCOUNT PLAN PROBE
# ---

# The plan-blocked tier is a waiver, and a waiver that cannot expire is a blind spot.
# So the plan is re-probed every run: the day private rulesets become available, those
# repos stop being excused and go red on their own.
#
# `/user` only carries `.plan` when the token holds the `user` scope. Without it the
# field is absent — which is NOT the same fact as "free plan", and is reported as
# indeterminate rather than quietly satisfying the waiver.
PLAN_STATUS="indeterminate"
PLAN_DETAIL="/user exposes no .plan field with this token's scopes — waiver held but unverified"
if user_json=$(gh api user 2>/dev/null); then
	plan_name=$(jq -r '.plan.name // ""' <<<"$user_json" 2>/dev/null) || plan_name=""
	if [ -n "$plan_name" ]; then
		if [ "$plan_name" = "free" ]; then
			PLAN_STATUS="blocked"
			PLAN_DETAIL="plan '$plan_name' does not offer private-repo rulesets — waiver stands"
		else
			PLAN_STATUS="expired"
			PLAN_DETAIL="plan '$plan_name' offers private-repo rulesets — the plan-blocked waiver has expired"
		fi
	fi
fi

# An indeterminate probe is not a passing one. The waiver is the ONLY thing excusing
# these repos from having a ruleset, so if it could not be checked their state is
# unknown — and a run reporting them n/a and exiting 0 claims an audit it did not do.
# Recorded here, consumed after the loop so it only fires when such a repo is targeted.
PLAN_UNVERIFIED=0
[ "$PLAN_STATUS" = "indeterminate" ] && PLAN_UNVERIFIED=1

if [ -n "$REMEDY" ]; then
	tier=$(jq -r --arg r "$REMEDY" '.repos[$r] // "null"' "$POLICY")
	if [ "$tier" = "null" ]; then
		echo "$SELF: '$REMEDY' is not governed by $POLICY." >&2
		exit 2
	fi
	# A failed lookup MUST NOT degrade to "no ruleset exists". The two print
	# differently — absent means POST (create), present means PUT (update) — so a
	# transient API error would hand you a command that creates a SECOND ruleset on
	# an already-protected repo. Refusing to guess is the only safe answer, and it
	# is why this exits 5 (API) rather than printing a best-effort remedy.
	if ! rs_pages=$(gh api --paginate --slurp "repos/$OWNER/$REMEDY/rulesets?per_page=100" 2>/dev/null); then
		echo "$SELF: could not list rulesets for '$REMEDY' — no remedy printed." >&2
		echo "  An unread repo is indistinguishable from an unprotected one, and guessing" >&2
		echo "  wrong prints a POST that would duplicate a ruleset already in place." >&2
		exit 5
	fi
	rs=$(jq -c 'add // []' <<<"$rs_pages" 2>/dev/null) || rs="[]"
	# Same duplicate-name hazard as the report path. A PUT against the first match
	# would update one ruleset and leave the others in force, so there is no single
	# command to print. Exits 6 (drift): the state IS known, and it is wrong.
	n_named=$(jq -r --arg n "$RULESET_NAME" '[.[] | select(.name == $n)] | length' <<<"$rs" 2>/dev/null) || n_named=0
	if [ "${n_named:-0}" -gt 1 ]; then
		echo "$SELF: '$REMEDY' has $n_named rulesets named '$RULESET_NAME' — no remedy printed." >&2
		echo "  A PUT would update one and leave the rest in force. Delete the extras first:" >&2
		echo "    gh api repos/$OWNER/$REMEDY/rulesets --jq '.[] | select(.name==\"$RULESET_NAME\") | .id'" >&2
		echo "    gh api -X DELETE repos/$OWNER/$REMEDY/rulesets/<id>" >&2
		exit 6
	fi
	id=$(jq -r --arg n "$RULESET_NAME" 'map(select(.name == $n)) | .[0].id // ""' <<<"$rs" 2>/dev/null) || id=""
	# The waiver can expire, and --remedy must agree with the report about that.
	# The report already routes an expired plan-blocked repo through the protected
	# remedy; if this path kept printing "none", the two surfaces would contradict
	# each other about the same repo in the same run — and the one people paste from
	# would be the one saying there is nothing to do. That is why the plan probe now
	# runs BEFORE this block rather than after it.
	eff_tier="$tier"
	if [ "$tier" = "plan-blocked" ] && [ "$PLAN_STATUS" = "expired" ]; then
		eff_tier="protected"
	fi
	echo "# $REMEDY — tier '$tier'. Review the payload before running it; repo-gate never writes."
	if [ "$eff_tier" != "$tier" ]; then
		echo "# Waiver expired: $PLAN_DETAIL"
		echo "# Printing the '$eff_tier' remedy, not 'none' — this matches what the report says."
	fi
	remedy_for "$REMEDY" "$eff_tier" "$id"

	# The bot-access half of the remedy (#304). Probed and printed regardless of
	# tier — a plan-blocked repo still needs the bot to be able to push, ruleset or
	# not — but never merged into the ruleset payload above: they are two different
	# APIs (rulesets vs. collaborators) and two different writes.
	bot=$(bot_access_of "$REMEDY")
	bstatus=$(jq -r '.status' <<<"$bot")
	case "$bstatus" in
		ok) : ;;
		error)
			bdetail=$(jq -r '.detail' <<<"$bot")
			echo "# $bdetail — no collaborator remedy printed." >&2
			exit 5
			;;
		*)
			bdetail=$(jq -r '.detail' <<<"$bot")
			echo "# $bdetail"
			bot_remedy_for "$REMEDY"
			;;
	esac
	exit 0
fi

# ---
# LIVE REPO ENUMERATION
# ---

# Enumerated so a repo can be in scope by the policy's own rule yet absent from its
# repos map — reported as `unlisted`. Without this, creating a repo on GitHub silently
# leaves it ungoverned and the report stays green while coverage shrinks.
if ! live_repos=$(gh api --paginate "user/repos?per_page=100&type=owner" 2>/dev/null); then
	echo "$SELF: could not list repositories — gh api failed." >&2
	exit 5
fi

# --paginate concatenates one JSON array per page; -s + add flattens them into one.
live_index=$(jq -sc --arg owner "$OWNER" '
	[ add[] | select(.owner.login == $owner) ]
	| map({ key: .name, value: { private: .private, fork: .fork, created: .created_at } })
	| from_entries
' <<<"$live_repos" 2>/dev/null) || {
	echo "$SELF: could not parse the repository list." >&2
	exit 5
}

# The scope rule, applied to live repos, so `unlisted` means "the policy's own rule
# says this belongs and the file does not mention it" rather than "any repo at all".
in_scope_live=$(jq -rc '
	to_entries
	| map(select(.value.fork | not))
	| map(select((.value.private | not) or (.value.created | startswith("2026"))))
	| map(.key)
' <<<"$live_index" 2>/dev/null) || in_scope_live='[]'

# ---
# PER-REPO EVALUATION
# ---

if [ ${#ONLY[@]} -gt 0 ]; then
	for r in "${ONLY[@]}"; do
		t=$(jq -r --arg r "$r" '.repos[$r] // "null"' "$POLICY")
		if [ "$t" = "null" ]; then
			echo "$SELF: '$r' is not governed by $POLICY (try: $SELF --json | jq '.repos[].repo')" >&2
			exit 2
		fi
	done
	mapfile -t TARGETS < <(printf '%s\n' "${ONLY[@]}")
else
	mapfile -t TARGETS < <(jq -r '.repos | keys[]' "$POLICY")
fi

records="[]"
api_failed=0

for repo in "${TARGETS[@]}"; do
	tier=$(jq -r --arg r "$repo" '.repos[$r]' "$POLICY")

	if ! jq -e --arg r "$repo" 'has($r)' <<<"$live_index" >/dev/null 2>&1; then
		records=$(jq -c --arg repo "$repo" --arg tier "$tier" '
			. + [{ repo: $repo, tier: $tier, status: "gone", detail: "declared in the policy but not present on the account", remedy: "remove it from the policy repos map, or restore the repo" }]
		' <<<"$records")
		continue
	fi

	# --paginate: the API defaults to 30 per page, and a ruleset on page 2 read as
	# absent would be reported as drift with a duplicate-creating POST as its remedy.
	# Captured to a variable BEFORE the jq combine, never piped into it: a pipeline
	# reports jq's exit status, which would swallow exactly the gh failure that
	# `api_failed` exists to catch, and turn an unread repo into a confident "ok".
	if ! ruleset_pages=$(gh api --paginate --slurp "repos/$OWNER/$repo/rulesets?per_page=100" 2>/dev/null); then
		api_failed=1
		records=$(jq -c --arg repo "$repo" --arg tier "$tier" '
			. + [{ repo: $repo, tier: $tier, status: "error", detail: "gh api repos/rulesets failed — state could not be determined", remedy: "" }]
		' <<<"$records")
		continue
	fi
	if ! rulesets=$(jq -c 'add // []' <<<"$ruleset_pages" 2>/dev/null); then
		api_failed=1
		records=$(jq -c --arg repo "$repo" --arg tier "$tier" '
			. + [{ repo: $repo, tier: $tier, status: "error", detail: "ruleset pages did not combine into an array — state could not be determined", remedy: "" }]
		' <<<"$records")
		continue
	fi

	# plan-blocked expects NO ruleset. Its own status word, never "ok" and never
	# "drift": folding it into either would make 12 of 29 repos claim a state
	# they were never in a position to reach.
	if [ "$tier" = "plan-blocked" ]; then
		count=$(jq 'length' <<<"$rulesets" 2>/dev/null) || count=0
		if [ "$PLAN_STATUS" = "expired" ]; then
			# Pass the existing id when there is one. Handing remedy_for an empty id
			# makes it synthesize a POST, which on a repo that ALREADY has the ruleset
			# creates a second one — the same duplicate this PR fixed elsewhere, reached
			# by a different road.
			pb_id=$(jq -r --arg n "$RULESET_NAME" 'map(select(.name == $n)) | .[0].id // ""' <<<"$rulesets" 2>/dev/null) || pb_id=""
			records=$(jq -c --arg repo "$repo" --arg tier "$tier" --arg d "$PLAN_DETAIL" \
				--arg rem "$(remedy_for "$repo" protected "$pb_id")" '
				. + [{ repo: $repo, tier: $tier, status: "drift", detail: $d, remedy: $rem }]
			' <<<"$records")
		elif [ "$count" -gt 0 ]; then
			records=$(jq -c --arg repo "$repo" --arg tier "$tier" --arg c "$count" '
				. + [{ repo: $repo, tier: $tier, status: "drift", detail: ("expected no ruleset, found " + $c + " — the plan-blocked assumption is wrong for this repo"), remedy: "re-tier this repo in docs/repo-policy.json" }]
			' <<<"$records")
		else
			records=$(jq -c --arg repo "$repo" --arg tier "$tier" --arg d "$PLAN_DETAIL" '
				. + [{ repo: $repo, tier: $tier, status: "n/a", detail: $d, remedy: "" }]
			' <<<"$records")
		fi
		continue
	fi

	# The named ruleset is fetched individually: the list endpoint omits `rules`
	# and `bypass_actors` entirely, so comparing against the list would have
	# reported every repo as missing every rule.
	# Ruleset names are NOT unique on GitHub, and this tool can itself create a
	# duplicate — a stale `--remedy` POST is exactly how. `.[0]` would compare the
	# first match, report `ok`, and hide a second ruleset that is equally in force.
	# Counted first, because "ok" here would be a lie about the protected state.
	rs_count=$(jq -r --arg n "$RULESET_NAME" '[.[] | select(.name == $n)] | length' <<<"$rulesets" 2>/dev/null) || rs_count=0
	if [ "${rs_count:-0}" -gt 1 ]; then
		# $sq carries a literal apostrophe: jq has no \x escape (a `\x27` here parsed as
		# an invalid escape, jq exited non-zero, the record was silently dropped, and the
		# run exited 0 with the repo missing from the report entirely — caught by
		# tests/repo-gate-compare.test.ts, which is why that file exists).
		records=$(jq -c --arg repo "$repo" --arg tier "$tier" --arg n "$RULESET_NAME" \
			--arg c "$rs_count" --arg owner "$OWNER" --arg sq "'" '
			. + [{ repo: $repo, tier: $tier, status: "drift",
			       detail: ($c + " rulesets share the name \"" + $n + "\" — all are in force, and which one this report would have described is arbitrary"),
			       remedy: ("# Ambiguous: no single-ruleset remedy is safe, a PUT would fix one and leave the rest.\n# List them, then delete all but one:\n#   gh api repos/" + $owner + "/" + $repo + "/rulesets --jq " + $sq + ".[] | select(.name==\"" + $n + "\") | .id" + $sq + "\n#   gh api -X DELETE repos/" + $owner + "/" + $repo + "/rulesets/<id>") }]
		' <<<"$records")
		continue
	fi
	rs_id=$(jq -r --arg n "$RULESET_NAME" 'map(select(.name == $n)) | .[0].id // ""' <<<"$rulesets" 2>/dev/null) || rs_id=""

	if [ -z "$rs_id" ]; then
		records=$(jq -c --arg repo "$repo" --arg tier "$tier" --arg n "$RULESET_NAME" \
			--arg rem "$(remedy_for "$repo" "$tier" "")" '
			. + [{ repo: $repo, tier: $tier, status: "drift", detail: ("no ruleset named " + $n), remedy: $rem }]
		' <<<"$records")
		continue
	fi

	if ! live=$(gh api "repos/$OWNER/$repo/rulesets/$rs_id" 2>/dev/null); then
		api_failed=1
		records=$(jq -c --arg repo "$repo" --arg tier "$tier" '
			. + [{ repo: $repo, tier: $tier, status: "error", detail: "ruleset listed but could not be read", remedy: "" }]
		' <<<"$records")
		continue
	fi

	diff=$(jq -n --slurpfile p "$POLICY" --argjson live "$live" --arg tier "$tier" '
		# Arrays are order-insensitive here: GitHub returns required_status_checks in
		# whatever order it stored them, and a reordered list is not a policy change.
		# Defined first: a `def` mid-pipeline is a jq syntax error, and the failure
		# mode was every repo reporting "comparison failed to evaluate" rather than
		# anything pointing at the filter.
		def norm($v): if ($v | type) == "array" then ($v | sort_by(tojson)) else $v end;
		$p[0] as $pol
		| $pol.tiers[$tier] as $t
		| ($t.rules | keys) as $want
		| ([$live.rules[].type] | sort) as $have
		| {
			missing: ($want - $have),
			unexpected: ($have - $want),
			params: [
				$t.rules | to_entries[]
				| select(.value != null)
				| .key as $type | .value as $pinned
				| ($live.rules[] | select(.type == $type) | .parameters // {}) as $actual
				| $pinned | to_entries[]
				| select(norm(.value) != norm($actual[.key]))
				| ($type + "." + .key + ": want " + (.value | tojson) + ", got " + (($actual[.key]) | tojson))
			],
			enforcement: (if $live.enforcement == ($t.enforcement // "active") then null
			              else "enforcement: want " + ($t.enforcement // "active") + ", got " + $live.enforcement end),
			# `exclude` is compared, not just `include`. A ruleset can include the
			# default branch and then exclude it again — the report would have said
			# "ok" about a rule that does not apply to the branch it exists to protect.
			# An unprotected repo reported as protected is the one failure this whole
			# tool exists to prevent, so both halves of the condition are checked.
			target: (if (($live.conditions.ref_name.include // []) == [$pol.scope.target]
			             and ($live.conditions.ref_name.exclude // []) == []) then null
			         else "target: want include [" + $pol.scope.target + "] with empty exclude, got "
			              + ({ include: ($live.conditions.ref_name.include // []),
			                   exclude: ($live.conditions.ref_name.exclude // []) } | tojson) end),
			# The claim that makes every other claim interpretable: if bypass ever
			# stops being admin/always, the meaning of this whole report changes and
			# nothing else here would notice.
			bypass: (if ([$live.bypass_actors[]? | {actor_type, actor_id, bypass_mode}] | sort_by(tojson))
			            == ($pol.enforcement_disclosure.bypass_actors | sort_by(tojson)) then null
			         else "bypass_actors: want " + ($pol.enforcement_disclosure.bypass_actors | tojson)
			              + ", got " + ([$live.bypass_actors[]? | {actor_type, actor_id, bypass_mode}] | tojson) end)
		}
		| { problems: (
				(.missing | map("missing rule: " + .))
				+ (.unexpected | map("unexpected rule: " + .))
				+ .params
				+ ([.enforcement, .target, .bypass] | map(select(. != null)))
			) }
	' 2>/dev/null) || {
		api_failed=1
		records=$(jq -c --arg repo "$repo" --arg tier "$tier" '
			. + [{ repo: $repo, tier: $tier, status: "error", detail: "comparison failed to evaluate", remedy: "" }]
		' <<<"$records")
		continue
	}

	n_problems=$(jq '.problems | length' <<<"$diff")
	if [ "$n_problems" -eq 0 ]; then
		records=$(jq -c --arg repo "$repo" --arg tier "$tier" '
			. + [{ repo: $repo, tier: $tier, status: "ok", detail: "matches the declared tier", remedy: "" }]
		' <<<"$records")
	else
		records=$(jq -c --arg repo "$repo" --arg tier "$tier" --argjson d "$diff" \
			--arg rem "$(remedy_for "$repo" "$tier" "$rs_id")" '
			. + [{ repo: $repo, tier: $tier, status: "drift", detail: ($d.problems | join("; ")), problems: $d.problems, remedy: $rem }]
		' <<<"$records")
	fi
done

# ---
# BOT ACCESS — folded into the records already built above (#304)
# ---

# A second pass, deliberately, rather than threaded into the loop above: the ruleset
# comparison already has a `continue` for every early exit (gone, list failure, get
# failure, duplicate name, no ruleset, plan-blocked ok/drift/n-a), and reproducing the
# fold at each one would multiply the surface for the same bug the #289 review kept
# finding — a record silently skipped or double-counted. This pass instead runs once
# per already-recorded repo and folds the verdict in by `repo` key, so the ruleset
# logic above is untouched and this stays a pure "merge another fact in" step.
for repo in "${TARGETS[@]}"; do
	# A "gone" repo does not exist on the account, so there is nothing to probe
	# collaborator permission on — the ruleset record already says why.
	if jq -e --arg r "$repo" '.[] | select(.repo == $r and .status == "gone")' <<<"$records" >/dev/null 2>&1; then
		continue
	fi
	bot=$(bot_access_of "$repo")
	bstatus=$(jq -r '.status' <<<"$bot")
	brem=""
	if [ "$bstatus" != "ok" ] && [ "$bstatus" != "error" ]; then
		brem=$(bot_remedy_for "$repo")
	fi
	if [ "$bstatus" = "error" ]; then
		api_failed=1
	fi
	records=$(jq -c --arg repo "$repo" --argjson bot "$bot" --arg brem "$brem" '
		map(
			if .repo != $repo then .
			else
				(. + { bot_access: $bot }) as $withbot
				| if $bot.status == "ok" then $withbot
				  elif $bot.status == "error" then
				    # "Could not check" outranks whatever the ruleset half found: the
				    # record can no longer claim to fully describe this repo.
				    ($withbot | .status = "error" | .detail = (.detail + " | " + $bot.detail))
				  else
				    # A definite negative (none/insufficient). If the ruleset half
				    # already errored, leave that status alone — still "error", not
				    # "drift" — but still surface what IS known about the bot.
				    ($withbot
				     | .status = (if .status == "error" then "error" else "drift" end)
				     | .problems = ((.problems // []) + [$bot.detail])
				     | .detail = (.detail + " | " + $bot.detail)
				     | .remedy = (if (.remedy // "") == "" then $brem else .remedy + "\n" + $brem end))
				  end
			end
		)
	' <<<"$records")
done

# Unlisted repos are appended only on a full run: naming specific repos on the
# command line is a request about those repos, not an audit of coverage.
if [ ${#ONLY[@]} -eq 0 ]; then
	records=$(jq -c --argjson live "$in_scope_live" --slurpfile p "$POLICY" '
		. as $recs
		| ($p[0].repos | keys) as $declared
		| ($p[0].scope.excluded | keys) as $excluded
		| $recs + (
			$live - $declared - $excluded
			| map({ repo: ., tier: "unlisted", status: "unlisted",
			        detail: "in scope by the policy rule, absent from its repos map",
			        remedy: "add it to docs/repo-policy.json under repos, or to scope.excluded with a reason" })
		)
	' <<<"$records")
fi

# ---
# OUTPUT
# ---

ok=$(jq '[.[] | select(.status == "ok")] | length' <<<"$records")
drift=$(jq '[.[] | select(.status == "drift")] | length' <<<"$records")
na=$(jq '[.[] | select(.status == "n/a")] | length' <<<"$records")
unlisted=$(jq '[.[] | select(.status == "unlisted")] | length' <<<"$records")
gone=$(jq '[.[] | select(.status == "gone")] | length' <<<"$records")
errors=$(jq '[.[] | select(.status == "error")] | length' <<<"$records")
total=$(jq 'length' <<<"$records")

if [ "$JSON" -eq 1 ]; then
	jq -n --slurpfile p "$POLICY" --argjson recs "$records" \
		--arg policy "$POLICY" --arg plan_status "$PLAN_STATUS" --arg plan_detail "$PLAN_DETAIL" \
		--arg bot_login "$BOT_LOGIN" \
		--argjson counts "{\"total\":$total,\"ok\":$ok,\"drift\":$drift,\"na\":$na,\"unlisted\":$unlisted,\"gone\":$gone,\"error\":$errors}" '
		{
			schema: "repo-gate/report@1",
			policy_path: $policy,
			policy_schema: $p[0].schema,
			enforcement_disclosure: $p[0].enforcement_disclosure,
			bot_login: $bot_login,
			plan: { status: $plan_status, detail: $plan_detail },
			counts: $counts,
			repos: $recs
		}
	'
else
	BOLD=""; DIM=""; RESET=""
	if [ -t 1 ]; then BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'; fi

	echo "${BOLD}repo-gate${RESET} — policy: $POLICY"
	echo

	# Printed on every run, by decision (#288): with admin bypassing always, these
	# rulesets are a signal and nothing else. A reader who takes this output for an
	# enforcement guarantee has been misled by a report that was technically correct.
	echo "${BOLD}⚠️  SIGNAL, NOT A BLOCK${RESET}"
	jq -r '.enforcement_disclosure | "    " + .summary, "    " + .what_is_actually_enforced' "$POLICY" | fmt -w 96 -s | sed 's/^/  /'
	echo
	echo "  ${DIM}plan probe: $PLAN_STATUS — $PLAN_DETAIL${RESET}"
	echo "  ${DIM}bot access probed for: $BOT_LOGIN (needs write on every repo below)${RESET}"
	echo

	jq -r '
		def icon: if . == "ok" then "✅" elif . == "n/a" then "⏭ " elif . == "error" then "⚠️ " else "❌" end;
		group_by(.tier)[]
		| ("  " + (.[0].tier) + " (" + (length | tostring) + ")"),
		  (.[] | "    " + (.status | icon) + " " + (.repo + "                                      " | .[0:38]) + " " + .status + "  " + .detail)
	' <<<"$records"

	echo
	echo "  ${BOLD}$total repo(s)${RESET}  ok=$ok  drift=$drift  n/a=$na  unlisted=$unlisted  gone=$gone  error=$errors"
	if [ "$errors" -gt 0 ]; then
		echo "  ⚠️  $errors repo(s) could not be checked — that is not the same as compliant."
	fi
	if [ $((drift + unlisted + gone)) -gt 0 ]; then
		echo "  ❌ $((drift + unlisted + gone)) repo(s) differ from the declared policy."
		echo "     Fix one:        $SELF --remedy <repo>"
		echo "     Teach an agent: docs/repo-gate-apply.md"
	elif [ "$errors" -eq 0 ]; then
		# Gated on errors too: a run that could not read part of the fleet found no
		# drift only in the sense that it never looked, and saying "every governed
		# repo matches" there is the green-because-empty failure in one sentence.
		echo "  ✅ every governed repo matches the declared policy."
	fi
fi

# An unreadable repo is reported as its own state and takes precedence: a run that
# could not see part of the fleet must not exit 0, and must not claim drift it never
# measured.
if [ "$errors" -gt 0 ] || [ "$api_failed" -eq 1 ]; then exit 5; fi
# na>0 with an unverified plan means those repos were excused by a waiver nobody could
# check. That is "could not look", not "looked and it was fine" — 5, never 0.
if [ "$PLAN_UNVERIFIED" -eq 1 ] && [ "$na" -gt 0 ]; then exit 5; fi
if [ $((drift + unlisted + gone)) -gt 0 ]; then exit 6; fi
exit 0
