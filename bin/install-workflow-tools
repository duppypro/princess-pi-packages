#!/usr/bin/env bash
# install-workflow-tools — make this host match the repo: workflow scripts from
# p-p-p/bin/ → ~/bin/ (itself included, #263), Claude Code PreToolUse hooks
# from p-p-p/hooks/ → ~/.claude/hooks/, statusline scripts from
# p-p-p/statusline/ → ~/.claude/ (#227), and skills from p-p-p/skills/ →
# ~/.claude/skills/ AND ~/.pi/agent/skills/ (#345).
#
# Usage:
#   install-workflow-tools           install/refresh all four sets
#   install-workflow-tools --check   report drift, write nothing (doctor mode)
#   install-workflow-tools --version print the resolved absolute path of this copy
#
# Exit codes:
#   0  installed everything, or --check found this host in sync (or --version)
#   1  --check found something missing, drifted, or not executable;
#      or install could not complete because a managed file is gone from source
#  64  bad usage
#
# Why hooks live here too (#249): the deployed copy of block-dangerous-git.sh
# sat 56 lines behind source — missing the whole `check_gh_command` function —
# so `gh pr merge` ran ungated on the very host that hook was written for.
# Nothing deployed hooks/, because deployment was somebody's memory. One
# command now covers both halves, and `--check` makes the gap loud.
#
# Why statusline scripts too (#227 / ADR 0001 / dotfiles-doctor#17): they are
# harness enhancements — executable tooling, not config — so ADR 0001 puts them
# in this repo. `subagent-statusline.sh` reached this point tracked by NO repo
# at all while `settings.json` invoked it by path, so a fresh host got a
# statusline command pointing at a file that did not exist.
#
# Why skills too, and why to BOTH harness targets in one manifest entry
# (#345): ADR 0001 already assigned ~/.claude/skills/* to this repo, but
# nothing deployed it — CLAUDE.md told a human to hand-copy skills/<name>/
# SKILL.md to ~/.claude/skills/ and ~/.pi/agent/skills/ after editing. That
# hand-copy is the machine-global side effect: ~/.claude/skills/ is ONE
# directory shared by every worktree, every branch, and main, so the moment
# any branch legitimately edited a skill and copied it out, every OTHER
# worktree's tests asserting repo-vs-deployed parity went red for a reason
# that had nothing to do with that worktree's own changes — it happened
# twice. Pi and Claude Code read different roots, so a skill deployed to one
# target and not the other is the exact same kind of drift, just narrower;
# one manifest entry fanning out to both destinations is what keeps that from
# being possible to forget.
#
# What this installer must NEVER write: ~/.claude/settings.json (it holds a
# live credential — princess-pi-brain#12), ~/.claude/CLAUDE.md, and
# ~/git-projects/CLAUDE.md. Those are configuration and prose, which ADR 0001
# leaves with dotfiles-doctor. Asserted by tests/installer-path-ownership.test.ts.
set -euo pipefail

# #178: resolved absolute path of the running copy, checked FIRST — before
# REPO_DIR resolution below, deliberately. This is the bootstrap tool: the
# thing that deploys every other script to ~/bin, and the one whose own
# identity (repo checkout vs. last-installed ~/bin copy) is exactly what #178
# needs an answer for. Making --version depend on finding the repo first would
# defeat the point — it must answer even when REPO_DIR resolution would fail.
# `readlink -f` resolves a real file OR a symlink to its actual on-disk
# location. Not built, so no commit-hash/semver stamp — PATH only.
case "${1:-}" in
  --version) readlink -f "$0"; exit 0 ;;
esac

# REPO_DIR resolution has to survive two invocation shapes (#263):
#   1. run from the repo — bin/install-workflow-tools, or the full repo path —
#      where $0's parent directory IS the repo's bin/.
#   2. run by bare name AFTER this script has deployed itself to ~/bin — bash
#      sets $0 to the resolved PATH hit (~/bin/install-workflow-tools), whose
#      parent's parent is just $HOME, not the repo. Falling back to the
#      canonical clone location is what makes "self-install" actually usable
#      by bare name instead of merely present on PATH.
# INSTALL_WORKFLOW_TOOLS_REPO_DIR is an explicit override for both: tests use
# it to point at a fixture repo without faking a real git-projects layout.
#
# is_this_repo() proves IDENTITY, not just shape (bug found by macroscopeapp
# on PR #267, rated Low-but-real): the bare-name self-install path resolves
# $0 to ~/bin/install-workflow-tools, so `dirname "$0"/..` is exactly $HOME —
# and `[ -d "$candidate/bin" ] && [ -d "$candidate/hooks" ]` accepts $HOME
# outright the moment an unrelated `~/hooks` directory exists (a dotfiles
# checkout, a scratch dir, anything). `[ "$candidate" != "$HOME" ]` would only
# special-case that one wrong directory rather than establishing that the
# candidate really IS this repo — checking package.json's "name" field is a
# marker any OTHER directory (including $HOME) is vanishingly unlikely to
# share by accident, and rejecting $HOME falls out of that as a side effect
# rather than being the rule itself.
#
# grep, not jq (second macroscopeapp finding on the same PR, rated High):
# this is the BOOTSTRAP tool — the first thing run on a fresh host, and the
# thing that puts every other script (including the ones that genuinely do
# need jq) onto PATH. Requiring jq just to recognize a valid checkout is a
# chicken-and-egg a fresh host may not have crossed yet. The old `jq -r
# '.name // empty' ... 2>/dev/null` also silently swallowed jq's absence: a
# missing jq quietly became name="" here, which then reported as "can't find
# the princess-pi-packages repo" — a misdiagnosis of a VALID checkout, same
# anti-pattern as #262's phantom-dirty-files message. A plain anchored grep
# on the "name" line needs nothing beyond POSIX text tools, already a hard
# dependency of this script, and preserves the exact rejection this check
# exists for (a bare bin/+hooks/ pair, e.g. $HOME with an unrelated ~/hooks).
is_this_repo() {
  local candidate="$1"
  [ -d "$candidate/bin" ] || return 1
  [ -d "$candidate/hooks" ] || return 1
  [ -f "$candidate/package.json" ] || return 1
  grep -Eq '"name"[[:space:]]*:[[:space:]]*"princess-pi-packages"' "$candidate/package.json" 2>/dev/null
}
resolve_repo_dir() {
  if [ -n "${INSTALL_WORKFLOW_TOOLS_REPO_DIR:-}" ]; then
    echo "$INSTALL_WORKFLOW_TOOLS_REPO_DIR"
    return
  fi
  local candidate
  candidate=$(cd "$(dirname "$0")/.." && pwd)
  if is_this_repo "$candidate"; then
    echo "$candidate"
    return
  fi
  candidate="$HOME/git-projects/princess-pi-packages"
  if is_this_repo "$candidate"; then
    echo "$candidate"
    return
  fi
  echo ""
}

REPO_DIR=$(resolve_repo_dir)
if [ -z "$REPO_DIR" ]; then
  echo "install-workflow-tools: can't find the princess-pi-packages repo (checked next to \$0 and ~/git-projects/princess-pi-packages)" >&2
  echo "  run it from inside the repo instead: bin/install-workflow-tools" >&2
  exit 1
fi
INSTALL_DIR="$HOME/bin"
HOOKS_DIR="$HOME/.claude/hooks"
# Statusline scripts sit directly in ~/.claude, NOT in a subdirectory —
# settings.json wires them as `bash ~/.claude/<name>.sh`, so that literal path
# is the contract. This is the same directory that holds settings.json, which
# this installer must never touch; deploys are per-file from the STATUSLINES
# manifest, never a directory sync, and that is what keeps the two apart.
STATUSLINE_DIR="$HOME/.claude"
# Two harness roots, not one — Pi and Claude Code each read their own (#345).
# Every skill fans out to both; see the SKILLS comment below for why that is
# one manifest entry rather than two.
SKILLS_CLAUDE_DIR="$HOME/.claude/skills"
SKILLS_PI_DIR="$HOME/.pi/agent/skills"

# This installer no longer needs jq itself (see is_this_repo() above), but
# most of what it DEPLOYS does: pr-threads, pr-merge, and pr-cleanup all lean
# on it heavily to parse `gh`'s GraphQL/JSON output. A host that reaches this
# point without jq will get every script placed on PATH successfully and then
# hit a confusing failure the first time one of them runs — check it here,
# explicitly and by name, rather than let that surface as an unrelated error
# three tools downstream. Warn, don't block: installing the scripts is still
# useful even before jq is installed, and this is the bootstrap tool — failing
# it over a dependency it doesn't itself need would recreate the same
# chicken-and-egg this fix removed from the identity check.
if ! command -v jq >/dev/null 2>&1; then
  echo "⚠ jq not found on PATH — pr-threads, pr-merge, and pr-cleanup require it at runtime." >&2
  echo "  Install it (e.g. 'apt install jq' / 'brew install jq') before using those tools." >&2
fi

MODE=install
case "${1:-}" in
  --check) MODE=check ;;
  # Header IS the help text — keep the range covering Usage + Exit codes.
  -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  "") ;;
  *) echo "install-workflow-tools: unknown argument '$1' (try --help)" >&2; exit 64 ;;
esac

SCRIPTS=(
  git-checkpoint
  git-overview
  wt-new
  # herdr decoration (#277). Both are deployed even though neither is required
  # for any workflow: `wt-new` and `pr-cleanup` SOURCE / exec `herdr-tab` and
  # `herdr-reap` from beside themselves, so on a host that has one but not the
  # other the tab half silently stops working while everything still exits 0 —
  # the failure mode hardest to notice. Deploying them together is what keeps
  # "herdr is decoration" true rather than "herdr is decoration, sometimes".
  # herdr-tab is a sourceable library that also runs as a one-shot CLI; it
  # needs the executable bit either way, which deploy() sets.
  herdr-tab
  herdr-reap
  pr-open
  pr-merge
  pr-reject
  pr-cleanup
  pr-threads
  # Reads docs/repo-policy.json, which is NOT deployed — the installed copy searches
  # $PWD then ~/git-projects/princess-pi-packages/ and refuses with the search order
  # if it finds neither (#288). Copying the policy to ~/bin would fork it from the
  # tracked one, and a governance baseline with two copies has no baseline.
  repo-gate
  # Itself (#263): the one script whose job is putting the others on PATH was
  # the only one you couldn't run by bare name — you had to know its repo
  # path. deploy() below always writes via temp-file-then-rename, which is
  # what makes it safe for this entry to overwrite the very file bash may be
  # executing right now when re-run from ~/bin.
  install-workflow-tools
)

# Claude Code reads these from ~/.claude/hooks — settings.json wires them by
# path, so the file on the host IS the enforcement. Source of truth is hooks/.
HOOKS=(
  block-dangerous-git.sh
  block-edit-on-main.sh
  preedit-reread-check.py
)

# Claude Code invokes these from settings.json's `statusLine` /
# `subagentStatusLine` as `bash ~/.claude/<name>.sh`. Source of truth is
# statusline/ (#227, ADR 0001 — harness enhancement, therefore this repo).
STATUSLINES=(
  statusline-command.sh
  subagent-statusline.sh
)

# Every repo-sourced skill (#345). Each name deploys ONE file — skills/<name>/
# SKILL.md — to BOTH harness roots (SKILLS_CLAUDE_DIR and SKILLS_PI_DIR
# above), never a directory sync: ~/.claude/skills/ holds 60+ skills from
# other sources and ~/.pi/agent/skills/ holds ~50, and this installer's job is
# the six files below, nothing else in either directory.
#
# cross-harness-tool is deployed even though its content is stale — it still
# names the `merge` CLI deleted in #201 (tracked in #230) — because this
# installer's job is parity, not curation. A tracked skill it skips recreates
# the exact "which copy is authoritative" gap #345 closes, just for a
# different skill; the content fix belongs to #230, not here.
SKILLS=(
  cross-harness-tool
  prose-as-api
  spec-reconcile
)

# Tools this installer used to delete from ~/bin on every run (#235 — an
# installer that also deletes is doing two jobs, and this list only grows
# staler). Discovery, not mutation: report a stale copy on PATH instead of
# silently disappearing it, so a machine that never ran the old migration
# (e.g. a fresh laptop install) still finds out.
STALE=(
  "git-ship:removed in #201, replaced by git-checkpoint"
  "git-snap:removed in #201, replaced by git-checkpoint"
  "merge:removed in #201, replaced by pr-open"
  "post-merge-cleanup:removed in #207, replaced by pr-cleanup"
)

drift_found=0

# ---
# Deploy one file, or (check mode) report how the deployed copy differs.
# Check mode never writes: a check that repairs is a check that hides the drift
# it found, which is exactly how #249 stayed invisible.
# ---
deploy() {
  local src="$1" dest="$2" label="$3" mode="${4:-exec}"
  # mode defaults to "exec" (scripts/hooks/statuslines: chmod +x, and --check
  # treats non-executable as drift). Skills pass mode="plain" (#345): they are
  # Markdown a harness reads, not something exec'd, so neither chmod +x nor
  # the executable-bit drift check applies to them.
  # A managed file that is gone from SOURCE is drift, not a footnote. This used
  # to warn and return with drift_found untouched, so `--check` printed
  # "In sync" for a hook that no longer existed and install still exited 0 —
  # the drift check signing off on its own blind spot. Fails in BOTH modes:
  # the manifest above is wrong either way, and only a human can say whether
  # the file was renamed or should be dropped from the list.
  if [ ! -f "$src" ]; then
    drift_found=1
    echo "   ❌ $label MISSING FROM SOURCE at $src — manifest is stale, deployed copy left as-is"
    return
  fi
  if [ "$MODE" = check ]; then
    if [ ! -f "$dest" ]; then
      drift_found=1
      echo "   ❌ $label MISSING at $dest"
    elif [ "$mode" = exec ] && [ ! -x "$dest" ]; then
      # settings.json wires hooks by path and Claude Code execs them. A hook it
      # cannot exec gates nothing, so identical bytes are not enough.
      drift_found=1
      echo "   ❌ $label NOT EXECUTABLE at $dest — wired but unrunnable"
    elif ! cmp -s "$src" "$dest"; then
      drift_found=1
      echo "   ❌ $label DRIFTED at $dest (differs from $src)"
    else
      echo "   ✅ $label in sync"
    fi
    return
  fi
  # Write-to-temp-then-rename, not `cp` in place (#263). `install-workflow-tools`
  # now deploys itself, so this may be overwriting the very file bash is
  # currently reading (e.g. running ~/bin/install-workflow-tools by bare
  # name). `cp` truncates and rewrites dest's existing inode in place — unsafe
  # mid-read. `mktemp` in the SAME directory as dest keeps the rename on one
  # filesystem, so `mv` is an atomic rename: readers holding the old file
  # descriptor keep reading the old (complete) inode until they close it: no
  # reader ever observes a half-written file. Applied to every deploy, not
  # just the installer, since it costs nothing and the guarantee is free.
  # Per-skill parent dir (~/.claude/skills/<name>/, ~/.pi/agent/skills/<name>/)
  # may not exist yet — SCRIPTS/HOOKS/STATUSLINES dests are all flat, so this
  # was never needed before SKILLS (#345). `mkdir -p` on an existing dir is a
  # no-op, so this is free for every other manifest too.
  mkdir -p "$(dirname "$dest")"
  local tmp
  tmp=$(mktemp "$dest.XXXXXX")
  cp "$src" "$tmp"
  if [ "$mode" = exec ]; then
    chmod +x "$tmp"
  fi
  mv -f "$tmp" "$dest"
  echo "   ✅ $label"
}

if [ "$MODE" = check ]; then
  echo "🔎 Checking this host against $REPO_DIR..."
else
  echo "📦 Installing workflow tools to $INSTALL_DIR..."
  mkdir -p "$INSTALL_DIR" "$HOOKS_DIR" "$STATUSLINE_DIR"
fi

for script in "${SCRIPTS[@]}"; do
  deploy "$REPO_DIR/bin/$script" "$INSTALL_DIR/$script" "$script"
done

if [ "$MODE" = check ]; then
  echo "🔎 Checking hooks against $HOOKS_DIR..."
else
  echo "🪝 Installing Claude Code hooks to $HOOKS_DIR..."
fi

for hook in "${HOOKS[@]}"; do
  deploy "$REPO_DIR/hooks/$hook" "$HOOKS_DIR/$hook" "$hook"
done

if [ "$MODE" = check ]; then
  echo "🔎 Checking statusline scripts against $STATUSLINE_DIR..."
else
  echo "📊 Installing statusline scripts to $STATUSLINE_DIR..."
fi

for sl in "${STATUSLINES[@]}"; do
  deploy "$REPO_DIR/statusline/$sl" "$STATUSLINE_DIR/$sl" "$sl"
done

if [ "$MODE" = check ]; then
  echo "🔎 Checking skills against $SKILLS_CLAUDE_DIR and $SKILLS_PI_DIR..."
else
  echo "🧠 Installing skills to $SKILLS_CLAUDE_DIR and $SKILLS_PI_DIR..."
fi

for skill in "${SKILLS[@]}"; do
  deploy "$REPO_DIR/skills/$skill/SKILL.md" "$SKILLS_CLAUDE_DIR/$skill/SKILL.md" "$skill (Claude)" plain
  deploy "$REPO_DIR/skills/$skill/SKILL.md" "$SKILLS_PI_DIR/$skill/SKILL.md" "$skill (Pi)" plain
done

if [ "$MODE" = check ]; then
  if [ "$drift_found" -eq 1 ]; then
    echo "❌ Drift found — this host is not running the tracked versions. Fix: $0"
    exit 1
  fi
  echo "✅ In sync with $REPO_DIR."
  exit 0
fi

if [ "$drift_found" -eq 1 ]; then
  echo "❌ One or more managed files are missing from source — this host was NOT fully synced." >&2
  echo "   Fix the SCRIPTS/HOOKS/STATUSLINES/SKILLS manifest in $0, or restore the file, then re-run." >&2
  exit 1
fi

echo "✅ Done. Run 'hash -r' or open a new shell to refresh PATH."
echo "   Hooks and statusline scripts take effect on the next Claude Code session (settings.json wires them by path)."

stale_found=0
for entry in "${STALE[@]}"; do
  name="${entry%%:*}"
  note="${entry#*:}"
  found=""
  # Check $INSTALL_DIR explicitly first — on a fresh install it may not be on
  # PATH yet, so `command -v` alone would miss a stale copy sitting right
  # there. Then fall back to PATH generally, so a stale copy anywhere else
  # (~/.local/bin, /usr/local/bin, ...) is still caught, not just ~/bin.
  if [ -f "$INSTALL_DIR/$name" ] || [ -L "$INSTALL_DIR/$name" ]; then
    found="$INSTALL_DIR/$name"
  elif found=$(command -v "$name" 2>/dev/null); then
    # A bare-name PATH hit needs a content check the $INSTALL_DIR branch
    # doesn't: only this repo's installer ever wrote there, but PATH is the
    # whole system's namespace, and a retired name can coincide with an
    # unrelated system binary (#246 — /usr/bin/merge, RCS three-way merge,
    # ships with rcs/diffutils, sharing the retired "merge" name with zero
    # relation to this repo). Every script this repo has ever shipped — every
    # current bash entry AND the old merge.ts/merge.mjs before #201 — opens
    # with a shebang ("#!"); a compiled binary's first two bytes never do.
    # That invariant, not the path it was found at, is the marker: it holds
    # for a stale copy in ~/.local/bin just as well as one in ~/bin, and it
    # rejects /usr/bin/merge without special-casing system directories (which
    # would just be a different, less-complete version of the same guess).
    if [ "$(head -c 2 "$found" 2>/dev/null)" != "#!" ]; then
      found=""
    fi
  fi
  if [ -n "$found" ]; then
    stale_found=1
    echo "⚠ stale: $found ($note) — delete by hand"
  fi
done
if [ "$stale_found" -eq 1 ]; then
  echo "⚠ install-workflow-tools no longer deletes anything — remove the stale tools above yourself if unwanted."
fi
